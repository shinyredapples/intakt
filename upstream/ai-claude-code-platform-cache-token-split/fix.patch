From 172116a2d289402a3a0814477dd0d9c26d8741dc Mon Sep 17 00:00:00 2001
From: Intakt Builder <builder@localhost>
Date: Sun, 15 Nov 2026 02:53:01 +0000
Subject: [PATCH] [Platform][ClaudeCode] Report cache creation and cache read
 tokens apart

The Claude Code CLI reports cache_creation_input_tokens and
cache_read_input_tokens apart, as the Anthropic API does, but the
extractor only added them up into cachedTokens and left
cacheCreationTokens and cacheReadTokens null. A consumer that prices
cache writes and reads differently could not tell them apart. Both are
now set, as the Anthropic bridge sets them; cachedTokens keeps the sum.
---
 .../Tests/TokenUsageExtractorTest.php         | 23 +++++++++++++++++++
 .../Bridge/ClaudeCode/TokenUsageExtractor.php | 10 ++++----
 2 files changed, 28 insertions(+), 5 deletions(-)

diff --git a/src/platform/src/Bridge/ClaudeCode/Tests/TokenUsageExtractorTest.php b/src/platform/src/Bridge/ClaudeCode/Tests/TokenUsageExtractorTest.php
index e331d3dd..73107e8b 100644
--- a/src/platform/src/Bridge/ClaudeCode/Tests/TokenUsageExtractorTest.php
+++ b/src/platform/src/Bridge/ClaudeCode/Tests/TokenUsageExtractorTest.php
@@ -61,6 +61,29 @@ final class TokenUsageExtractorTest extends TestCase
         $this->assertSame(100, $tokenUsage->getPromptTokens());
         $this->assertSame(50, $tokenUsage->getCompletionTokens());
         $this->assertSame(24026, $tokenUsage->getCachedTokens());
+        $this->assertSame(9864, $tokenUsage->getCacheCreationTokens());
+        $this->assertSame(14162, $tokenUsage->getCacheReadTokens());
+    }
+
+    public function testExtractWithOnlyCacheReadTokens()
+    {
+        $extractor = new TokenUsageExtractor();
+        $rawResult = new InMemoryRawResult([
+            'type' => 'result',
+            'result' => 'Hello',
+            'usage' => [
+                'input_tokens' => 100,
+                'output_tokens' => 50,
+                'cache_read_input_tokens' => 14162,
+            ],
+        ]);
+
+        $tokenUsage = $extractor->extract($rawResult);
+
+        $this->assertInstanceOf(TokenUsage::class, $tokenUsage);
+        $this->assertSame(14162, $tokenUsage->getCachedTokens());
+        $this->assertNull($tokenUsage->getCacheCreationTokens());
+        $this->assertSame(14162, $tokenUsage->getCacheReadTokens());
     }
 
     public function testExtractReturnsNullForStreaming()
diff --git a/src/platform/src/Bridge/ClaudeCode/TokenUsageExtractor.php b/src/platform/src/Bridge/ClaudeCode/TokenUsageExtractor.php
index 52f97fdb..008c5025 100644
--- a/src/platform/src/Bridge/ClaudeCode/TokenUsageExtractor.php
+++ b/src/platform/src/Bridge/ClaudeCode/TokenUsageExtractor.php
@@ -36,16 +36,16 @@ final class TokenUsageExtractor implements TokenUsageExtractorInterface
         }
 
         $usage = $content['usage'];
-        $cachedTokens = null;
-
-        if (\array_key_exists('cache_creation_input_tokens', $usage) || \array_key_exists('cache_read_input_tokens', $usage)) {
-            $cachedTokens = ($usage['cache_creation_input_tokens'] ?? 0) + ($usage['cache_read_input_tokens'] ?? 0);
-        }
+        $cacheCreationTokens = isset($usage['cache_creation_input_tokens']) ? (int) $usage['cache_creation_input_tokens'] : null;
+        $cacheReadTokens = isset($usage['cache_read_input_tokens']) ? (int) $usage['cache_read_input_tokens'] : null;
+        $cachedTokens = (null !== $cacheCreationTokens || null !== $cacheReadTokens) ? ($cacheCreationTokens ?? 0) + ($cacheReadTokens ?? 0) : null;
 
         return new TokenUsage(
             promptTokens: $usage['input_tokens'] ?? null,
             completionTokens: $usage['output_tokens'] ?? null,
             cachedTokens: $cachedTokens,
+            cacheCreationTokens: $cacheCreationTokens,
+            cacheReadTokens: $cacheReadTokens,
         );
     }
 }
