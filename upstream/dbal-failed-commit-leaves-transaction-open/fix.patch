From 962dcd00931853698415d4653f6539d1ee406e8f Mon Sep 17 00:00:00 2001
From: Harald Ponce de Leon <haraldpdl@gmail.com>
Date: Fri, 20 Nov 2026 18:05:54 +0100
Subject: [PATCH] Roll back the transaction when the database refuses to commit
 it

---
 src/Connection.php                   | 34 ++++++++-----
 tests/Functional/TransactionTest.php | 73 ++++++++++++++++++++++++++++
 2 files changed, 95 insertions(+), 12 deletions(-)

diff --git a/src/Connection.php b/src/Connection.php
index c024b9014..5e772ceac 100644
--- a/src/Connection.php
+++ b/src/Connection.php
@@ -16,14 +16,10 @@ use Doctrine\DBAL\Driver\Exception as TheDriverException;
 use Doctrine\DBAL\Driver\Statement as DriverStatement;
 use Doctrine\DBAL\Exception\CommitFailedRollbackOnly;
 use Doctrine\DBAL\Exception\ConnectionLost;
-use Doctrine\DBAL\Exception\DeadlockException;
 use Doctrine\DBAL\Exception\DriverException;
-use Doctrine\DBAL\Exception\ForeignKeyConstraintViolationException;
 use Doctrine\DBAL\Exception\NoActiveTransaction;
 use Doctrine\DBAL\Exception\ParseError;
 use Doctrine\DBAL\Exception\SavepointsNotSupported;
-use Doctrine\DBAL\Exception\TransactionRolledBack;
-use Doctrine\DBAL\Exception\UniqueConstraintViolationException;
 use Doctrine\DBAL\Platforms\AbstractPlatform;
 use Doctrine\DBAL\Query\Expression\ExpressionBuilder;
 use Doctrine\DBAL\Query\QueryBuilder;
@@ -977,13 +973,8 @@ class Connection implements ServerVersionProvider
 
             $shouldRollback = false;
         } catch (TheDriverException $t) {
-            $shouldRollback = ! (
-                $t instanceof TransactionRolledBack
-                || $t instanceof UniqueConstraintViolationException
-                || $t instanceof ForeignKeyConstraintViolationException
-                || $t instanceof DeadlockException
-                || $t instanceof ConnectionLost
-            );
+            // commit() has ended the transaction, also when the database refused it
+            $shouldRollback = false;
 
             throw $t;
         } finally {
@@ -1080,7 +1071,13 @@ class Connection implements ServerVersionProvider
                 try {
                     $connection->commit();
                 } catch (Driver\Exception $e) {
-                    throw $this->convertException($e);
+                    $exception = $this->convertException($e);
+
+                    if (! $exception instanceof ConnectionLost) {
+                        $this->rollBackAfterFailedCommit($connection);
+                    }
+
+                    throw $exception;
                 }
             } else {
                 $this->releaseSavepoint($this->_getNestedTransactionSavePointName());
@@ -1090,6 +1087,19 @@ class Connection implements ServerVersionProvider
         }
     }
 
+    /**
+     * Ends the transaction if the database kept it open after refusing to commit it, as SQLite does when the
+     * database is locked. A database that has already rolled the transaction back makes the rollback fail,
+     * which is ignored.
+     */
+    private function rollBackAfterFailedCommit(DriverConnection $connection): void
+    {
+        try {
+            $connection->rollBack();
+        } catch (Driver\Exception) {
+        }
+    }
+
     /** @throws Exception */
     private function updateTransactionStateAfterCommit(): void
     {
diff --git a/tests/Functional/TransactionTest.php b/tests/Functional/TransactionTest.php
index 89ffa5bca..300ef9e4d 100644
--- a/tests/Functional/TransactionTest.php
+++ b/tests/Functional/TransactionTest.php
@@ -5,9 +5,12 @@ declare(strict_types=1);
 namespace Doctrine\DBAL\Tests\Functional;
 
 use Doctrine\DBAL\Connection;
+use Doctrine\DBAL\DriverManager;
 use Doctrine\DBAL\Exception\ConnectionLost;
+use Doctrine\DBAL\Exception\LockWaitTimeoutException;
 use Doctrine\DBAL\Platforms\AbstractMySQLPlatform;
 use Doctrine\DBAL\Platforms\PostgreSQLPlatform;
+use Doctrine\DBAL\Platforms\SQLitePlatform;
 use Doctrine\DBAL\Schema\Column;
 use Doctrine\DBAL\Schema\PrimaryKeyConstraint;
 use Doctrine\DBAL\Schema\Table;
@@ -19,11 +22,81 @@ use function func_get_args;
 use function restore_error_handler;
 use function set_error_handler;
 use function sprintf;
+use function sys_get_temp_dir;
 
 use const E_WARNING;
 
 class TransactionTest extends FunctionalTestCase
 {
+    private ?Connection $reader = null;
+
+    protected function tearDown(): void
+    {
+        $this->reader?->close();
+        $this->reader = null;
+
+        parent::tearDown();
+    }
+
+    public function testRefusedCommit(): void
+    {
+        $writer = $this->createWriterLockedOutByReader();
+        $writer->beginTransaction();
+        $writer->insert('refused_commit', ['id' => 1]);
+
+        try {
+            $writer->commit();
+            self::fail('The commit was expected to be refused.');
+        } catch (LockWaitTimeoutException) {
+        }
+
+        self::assertFalse($writer->isTransactionActive());
+
+        $this->reader?->rollBack();
+
+        $writer->beginTransaction();
+        $writer->insert('refused_commit', ['id' => 2]);
+        $writer->commit();
+
+        self::assertSame([2], $writer->fetchFirstColumn('SELECT id FROM refused_commit'));
+    }
+
+    public function testTransactionalWithRefusedCommit(): void
+    {
+        $writer = $this->createWriterLockedOutByReader();
+
+        $this->expectException(LockWaitTimeoutException::class);
+        $writer->transactional(static function (Connection $connection): void {
+            $connection->insert('refused_commit', ['id' => 1]);
+        });
+    }
+
+    /**
+     * Returns a connection to an SQLite database on which another connection holds a read transaction,
+     * so SQLite refuses the returned connection's commit of a write with "database is locked".
+     */
+    private function createWriterLockedOutByReader(): Connection
+    {
+        if (! $this->connection->getDatabasePlatform() instanceof SQLitePlatform) {
+            self::markTestSkipped('Restricted to SQLite.');
+        }
+
+        $params           = $this->connection->getParams();
+        $params['memory'] = false;
+        $params['path']   = sys_get_temp_dir() . '/doctrine_refused_commit.sqlite';
+
+        $writer = DriverManager::getConnection($params, $this->connection->getConfiguration());
+        $writer->executeStatement('PRAGMA busy_timeout = 0');
+        $writer->executeStatement('DROP TABLE IF EXISTS refused_commit');
+        $writer->executeStatement('CREATE TABLE refused_commit (id INTEGER PRIMARY KEY)');
+
+        $this->reader = DriverManager::getConnection($params, $this->connection->getConfiguration());
+        $this->reader->beginTransaction();
+        $this->reader->fetchOne('SELECT COUNT(*) FROM refused_commit');
+
+        return $writer;
+    }
+
     public function testBeginTransactionFailure(): void
     {
         $this->expectConnectionLoss(static function (Connection $connection): void {
-- 
