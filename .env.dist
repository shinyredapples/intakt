# Copy to .env.local (git-ignored, and kept out of the image) and fill in the values; compose.yaml reads it.

# One provider key gives a review panel on that provider; both put the two reviewers on two providers.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Required by the container; generate each with: openssl rand -hex 32
APP_SECRET=
MERCURE_JWT_SECRET=

# Optional: the owner's MCP token. Left empty, the first start makes one and prints it with the MCP address.
MCP_OWNER_TOKEN=
