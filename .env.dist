# Optional: the demo starts without this file. Copy it to .env.local (git-ignored, and kept out of the image) to set values; compose.yaml reads it when it exists.

# One provider key gives a review panel on that provider; two put the two reviewers on two providers.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# A fine-grained Hugging Face token with only "Make calls to Inference Providers"; alone, its two reviewers run on models of two AI labs.
HF_TOKEN=

# Optional: left empty, the first start makes each one at random and keeps it in the data volume; a value set here wins.
APP_SECRET=
MERCURE_JWT_SECRET=

# Optional: the owner's MCP token. Left empty, the first start makes one and keeps it in the data volume.
MCP_OWNER_TOKEN=
