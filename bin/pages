#!/usr/bin/env php
<?php

declare(strict_types=1);

use Intakt\Tests\JourneyPage\MermaidTimeline;
use Symfony\Component\Process\Process;

const USAGE = "usage: bin/pages <folder> [--recorded=<folder with the recorded API answers>]\n";
const JOURNEY_LINK = "How Intakt was built, with its milestones, token use and issue flow: [the journey](../journey/).\n";

$autoload = __DIR__.'/../vendor/autoload.php';

if (!is_file($autoload)) {
    fwrite(STDERR, "run composer install first\n");
    exit(2);
}

require $autoload;

$folder = null;
$recorded = null;

foreach (array_slice($argv, 1) as $argument) {
    if (str_starts_with($argument, '--recorded=') && null === $recorded) {
        $recorded = $argument;

        continue;
    }

    if (str_starts_with($argument, '-') || null !== $folder) {
        fwrite(STDERR, USAGE);
        exit(2);
    }

    $folder = $argument;
}

if (null === $folder) {
    fwrite(STDERR, USAGE);
    exit(2);
}

$root = dirname(__DIR__);

foreach ([['bin/highlights'], ['bin/journey', ...(null === $recorded ? [] : [$recorded])]] as $command) {
    $run = new Process([PHP_BINARY, $root.'/'.$command[0], ...array_slice($command, 1)]);
    $run->setTimeout(timeout: null);
    $run->run(static fn (string $type, string $output): int|false => fwrite(Process::ERR === $type ? STDERR : STDOUT, $output));

    if (!$run->isSuccessful()) {
        exit(1);
    }
}

$readSource = static function (string $file): string {
    $content = @file_get_contents($file);

    if (false === $content) {
        fwrite(STDERR, 'cannot read '.$file."\n");
        exit(1);
    }

    return $content;
};

$journey = $readSource($root.'/docs/journey.md');
$highlights = explode("\n", $readSource($root.'/docs/highlights.md'), 2);
// Pages serves the journey page at /journey/, so its drawings lie beside it, and its Jekyll does not render Mermaid.
$files = [
    'highlights/index.md' => $highlights[0]."\n\n".JOURNEY_LINK.($highlights[1] ?? ''),
    // Correct only because docs/journey.md links nothing under journey/ but the *.svg drawings copied below (PagesCommandTest pins it).
    'journey/index.md' => (string) preg_replace(MermaidTimeline::BLOCK, '![Timeline](timeline.svg)', str_replace('](journey/', '](', $journey)),
];

// The front page and its assets have no front matter, so Jekyll copies them unchanged and runs no Liquid on them.
$sources = [$root.'/docs/pages/index.html'];

if (is_dir($root.'/docs/pages/assets')) {
    // Walks every subfolder of assets/, so each file keeps its relative path under the site's assets/.
    foreach (new RecursiveIteratorIterator(new RecursiveDirectoryIterator($root.'/docs/pages/assets', FilesystemIterator::SKIP_DOTS)) as $asset) {
        $sources[] = $asset->getPathname();
    }
}

foreach ($sources as $file) {
    $files[substr($file, strlen($root.'/docs/pages/'))] = $readSource($file);
}

foreach (glob($root.'/docs/journey/*.svg') ?: [] as $drawing) {
    $files['journey/'.basename($drawing)] = $readSource($drawing);
}

if (is_file($folder.'/index.md')) {
    fwrite(STDERR, $folder."/index.md is left from the old layout and the front page replaces it: remove it or build into a fresh folder\n");
    exit(1);
}

$changed = array_filter($files, static fn (string $content, string $path): bool => !is_file($folder.'/'.$path) || file_get_contents($folder.'/'.$path) !== $content, ARRAY_FILTER_USE_BOTH);

if ([] === $changed) {
    fwrite(STDOUT, "site is current\n");
    exit(0);
}

foreach (array_unique(array_map(dirname(...), array_keys($changed))) as $subfolder) {
    if (!is_dir($folder.'/'.$subfolder) && !@mkdir($folder.'/'.$subfolder, recursive: true)) {
        fwrite(STDERR, 'cannot make '.$folder.'/'.$subfolder."\n");
        exit(1);
    }
}

foreach ($changed as $path => $content) {
    if (false === @file_put_contents($folder.'/'.$path, $content)) {
        fwrite(STDERR, 'cannot write '.$folder.'/'.$path."\n");
        exit(1);
    }

    fwrite(STDOUT, $folder.'/'.$path." written\n");
}
