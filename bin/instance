#!/usr/bin/env php
<?php

declare(strict_types=1);

// Needs no Composer autoloader itself, so a broken install still reports "failed".

final readonly class InstanceStatus
{
    public bool $ready;

    private function __construct(
        public string $reason,
        public ?string $mode = null,
    ) {
        // a failure always carries a reason, so the status without one is the ready status
        $this->ready = '' === $reason;
    }

    public static function ready(): self
    {
        return new self('');
    }

    public static function failed(string $reason): self
    {
        return new self('' === trim($reason) ? 'unknown reason' : $reason);
    }

    public function inMode(string $mode): self
    {
        return clone ($this, ['mode' => $mode]);
    }

    public function toJson(): string
    {
        // A line without a mode means the built-in server, so its callers read the same line as before worker mode.
        $line = ['status' => $this->ready ? 'ready' : 'failed', ...(null === $this->mode ? [] : ['mode' => $this->mode])];
        $line = $this->ready ? $line : [...$line, 'reason' => $this->reason];

        return json_encode($line, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE | JSON_INVALID_UTF8_SUBSTITUTE).PHP_EOL;
    }
}

final class Instance
{
    private const array INHERITED_VARIABLES = ['PATH', 'HOME', 'LANG', 'LC_ALL', 'LC_CTYPE', 'TZ', 'TMPDIR'];
    private const int BOOT_SECONDS = 30;
    private const int STOP_SECONDS = 5;
    private const string BUILT_IN_SERVER_LINE = '/^\[[^\]]+\] (?:PHP \S+ Development Server \(.*\) started|\S+:\d+ (?:Accepted|Closing|\[\d{3}\]: .*))$/';
    // Keeps boot, command and stop together well inside the build loop's 120 seconds per call.
    public const int COMMAND_SECONDS = 60;
    private const int COMMAND_TIMED_OUT = 124;

    /** @var resource|null */
    private $server;

    private string $scratch = '';

    private bool $createdFallback = false;

    private string $output = '';

    private int $commandExit = 0;

    /**
     * @param list<string> $command
     */
    public function __construct(
        private readonly string $root,
        private readonly Server $web,
        private readonly array $command,
        private readonly int $commandSeconds,
        private readonly DirectoryRemoval $directoryRemoval,
    ) {
    }

    #[NoDiscard]
    public function run(): InstanceStatus
    {
        try {
            $status = $this->boot();
        } catch (Throwable $failure) {
            $status = InstanceStatus::failed($failure->getMessage());
        } finally {
            $this->stop();
            $this->output = $this->readLog();
            $this->removeScratch();
        }

        return $this->web->labeled($status);
    }

    public function log(): string
    {
        return $this->output;
    }

    public function commandExit(): int
    {
        return $this->commandExit;
    }

    private function boot(): InstanceStatus
    {
        if (!is_file($this->root.'/vendor/autoload_runtime.php')) {
            return InstanceStatus::failed('vendor/autoload_runtime.php is missing, run composer install');
        }

        $this->scratch = $this->createScratch();
        $this->start();

        $status = $this->awaitAnswer();

        if ($status->ready && [] !== $this->command) {
            $this->commandExit = $this->runCommand();
        }

        return $status;
    }

    private function createScratch(): string
    {
        $base = (string) getenv('TMPDIR');
        $base = '' === $base ? $this->root.'/var' : $base;
        $path = $base.'/intakt-instance-'.bin2hex(random_bytes(6));
        $this->createdFallback = $base === $this->root.'/var' && !is_dir($base);

        new ScratchCreation()->create($path);

        return $path;
    }

    private function start(): void
    {
        $server = ['sh', '-c', 'exec "$@" 3>&-', 'sh', ...$this->web->launch($this->scratch)];
        // The caller's descriptor 3 has no close-on-exec flag, so the shell above closes it; the spec has no index 3 either.
        $descriptors = [
            0 => ['file', '/dev/null', 'r'],
            1 => ['file', $this->logPath(), 'a'],
            2 => ['file', $this->logPath(), 'a'],
        ];

        $process = proc_open($server, $descriptors, $pipes, $this->root, [...$this->environment(), ...$this->web->environment($this->scratch)]);

        if (false === $process) {
            throw new RuntimeException('cannot start the web server');
        }

        $this->server = $process;
    }

    private function logPath(): string
    {
        return $this->scratch.'/server.log';
    }

    private function awaitAnswer(): InstanceStatus
    {
        $deadline = hrtime(true) + self::BOOT_SECONDS * 1_000_000_000;

        while (hrtime(true) < $deadline) {
            if (!$this->serverRuns()) {
                return InstanceStatus::failed('the server exited: '.$this->logSummary());
            }

            $statusLine = $this->statusLineOf($this->listeningPort());

            if (null !== $statusLine) {
                return $this->statusFrom($statusLine);
            }

            usleep(100_000);
        }

        return InstanceStatus::failed('no answer within '.self::BOOT_SECONDS.' seconds: '.$this->logSummary());
    }

    private function runCommand(): int
    {
        // Same descriptor rule as the server: the command must not inherit the caller's descriptor 3.
        $command = ['sh', '-c', 'exec "$@" 3>&-', 'sh', ...$this->command];
        $descriptors = [0 => ['file', '/dev/null', 'r'], 1 => STDOUT, 2 => STDERR];
        $environment = [...$this->environment(), 'INTAKT_INSTANCE_URL' => 'http://127.0.0.1:'.$this->listeningPort(), ...$this->web->commandEnvironment()];

        $process = proc_open($command, $descriptors, $pipes, $this->root, $environment);

        if (false === $process) {
            throw new RuntimeException('cannot start the command');
        }

        return $this->awaitExit($process);
    }

    /**
     * @return array<string, string>
     */
    private function environment(): array
    {
        $environment = [];

        // An allowlist, so code under test cannot print a token the caller happens to have set.
        foreach (self::INHERITED_VARIABLES as $name) {
            $value = getenv($name);

            if (false !== $value) {
                $environment[$name] = $value;
            }
        }

        return [
            ...$environment,
            'APP_ENV' => $this->variable('APP_ENV') ?? 'test',
            // Keeps the framework from writing config/reference.php into the checkout, as debug mode does.
            'APP_DEBUG' => '0',
            'APP_SECRET' => $this->variable('APP_SECRET') ?? bin2hex(random_bytes(16)),
            'APP_CACHE_DIR' => $this->scratch.'/cache',
            'APP_LOG_DIR' => $this->scratch.'/log',
            'APP_SHARE_DIR' => $this->scratch.'/share',
            'DATABASE_URL' => 'sqlite:///'.$this->scratch.'/data.db',
        ];
    }

    private function variable(string $name): ?string
    {
        $value = getenv($name);

        return false === $value || '' === $value || '0' === $value ? null : $value;
    }

    private function serverRuns(): bool
    {
        return null !== $this->server && proc_get_status($this->server)['running'];
    }

    private function logSummary(): string
    {
        $lines = preg_split('/\R/', $this->readLog());
        $lines = array_values(array_filter(array_map(trim(...), false === $lines ? [] : $lines), static fn (string $line): bool => '' !== $line));

        foreach ($lines as $line) {
            if (1 === preg_match('/error|exception/i', $line)) {
                return mb_substr($line, 0, 500);
            }
        }

        if ([] === $lines) {
            return 'the server log is empty';
        }

        // A process the system stops, as PHP's own "Out of memory" exit does, names no error, so its last words are the reason.
        $lastWords = array_last($this->withoutServerBookkeeping($lines));

        return null === $lastWords ? 'the server log names no reason' : mb_substr($lastWords, 0, 500);
    }

    /**
     * @param list<string> $lines
     *
     * @return list<string>
     */
    private function withoutServerBookkeeping(array $lines): array
    {
        // The built-in server logs its start and every request, so its last line would only restate the status code.
        return array_values(array_filter($lines, static fn (string $line): bool => 1 !== preg_match(self::BUILT_IN_SERVER_LINE, $line)));
    }

    private function listeningPort(): ?int
    {
        return $this->web->port($this->readLog());
    }

    /**
     * @param resource $process
     */
    private function awaitExit($process): int
    {
        $deadline = hrtime(true) + $this->commandSeconds * 1_000_000_000;

        while (hrtime(true) < $deadline) {
            $state = proc_get_status($process);

            if (!$state['running']) {
                proc_close($process);

                return $state['exitcode'];
            }

            usleep(50_000);
        }

        proc_terminate($process, 9);
        proc_close($process);
        fwrite(STDERR, 'the command ran longer than '.$this->commandSeconds." seconds and was killed\n");

        return self::COMMAND_TIMED_OUT;
    }

    private function statusLineOf(?int $port): ?string
    {
        if (null === $port) {
            return null;
        }

        $context = stream_context_create(['http' => ['timeout' => 5, 'ignore_errors' => true, 'follow_location' => 0]]);
        @file_get_contents('http://127.0.0.1:'.$port.'/', false, $context);

        return array_first(http_get_last_response_headers() ?? []);
    }

    private function statusFrom(string $statusLine): InstanceStatus
    {
        if (1 !== preg_match('/^HTTP\/\d(?:\.\d)? (\d{3})(?: |$)/', $statusLine, $match)) {
            return InstanceStatus::failed('unparsable status line: '.mb_substr($statusLine, 0, 200));
        }

        $code = (int) $match[1];

        return $code < 500 ? InstanceStatus::ready() : InstanceStatus::failed('HTTP '.$code.': '.$this->logSummary());
    }

    private function stop(): void
    {
        if (null === $this->server) {
            return;
        }

        proc_terminate($this->server);
        $deadline = hrtime(true) + self::STOP_SECONDS * 1_000_000_000;

        while ($this->serverRuns() && hrtime(true) < $deadline) {
            usleep(50_000);
        }

        if ($this->serverRuns()) {
            proc_terminate($this->server, 9);
        }

        proc_close($this->server);
        $this->server = null;
    }

    private function readLog(): string
    {
        return is_file($this->logPath()) ? (string) file_get_contents($this->logPath()) : '';
    }

    private function removeScratch(): void
    {
        if ('' === $this->scratch) {
            return;
        }

        $this->directoryRemoval->remove($this->scratch);

        if ($this->createdFallback) {
            // Another run may be using var/, so a plain rmdir that fails on a non-empty folder is the right check.
            @rmdir($this->root.'/var');
        }
    }
}

interface Server
{
    /**
     * @return list<string>
     */
    public function launch(string $scratch): array;

    /**
     * @return array<string, string>
     */
    public function environment(string $scratch): array;

    public function port(string $log): ?int;

    /**
     * @return array<string, string>
     */
    public function commandEnvironment(): array;

    public function labeled(InstanceStatus $status): InstanceStatus;
}

final readonly class BuiltInServer implements Server
{
    public function __construct(private string $root)
    {
    }

    public function launch(string $scratch): array
    {
        // Port 0 lets the server bind a free port itself, so no other process can take it between a probe and the bind.
        $address = '127.0.0.1:0';

        // Without E in variables_order the runtime never sees the instance's environment, so it falls back to .env (dev, debug, var/).
        return [PHP_BINARY, '-d', 'variables_order=EGPCS', '-S', $address, '-t', $this->root.'/public', $this->root.'/public/index.php'];
    }

    public function environment(string $scratch): array
    {
        // This server has no admin API; a non-loopback host makes AdminApi refuse before any request, so the board never reaches a stray listener on the default port.
        return ['FRANKENPHP_ADMIN_URL' => 'http://admin-api.invalid'];
    }

    public function port(string $log): ?int
    {
        return 1 === preg_match('/Development Server \(http:\/\/127\.0\.0\.1:(\d+)\) started/', $log, $match) ? (int) $match[1] : null;
    }

    public function commandEnvironment(): array
    {
        return [];
    }

    public function labeled(InstanceStatus $status): InstanceStatus
    {
        return $status;
    }
}

final class WorkerServer implements Server
{
    private int $port = 0;

    private int $adminPort = 0;

    public function __construct(
        private readonly string $root,
        private readonly string $binary,
    ) {
    }

    public function launch(string $scratch): array
    {
        [$this->port, $this->adminPort] = $this->freePorts();
        file_put_contents($scratch.'/Caddyfile', $this->caddyfile());

        return [$this->binary, 'run', '--config', $scratch.'/Caddyfile', '--adapter', 'caddyfile'];
    }

    public function environment(string $scratch): array
    {
        // Caddy keeps its autosaved config and data under these, so it writes nothing outside the scratch directory.
        return ['XDG_DATA_HOME' => $scratch.'/xdg-data', 'XDG_CONFIG_HOME' => $scratch.'/xdg-config', 'FRANKENPHP_ADMIN_URL' => $this->adminUrl()];
    }

    public function port(string $log): ?int
    {
        // Caddy logs this only once every listener is bound, so an unrelated listener on the chosen port cannot answer the readiness request in FrankenPHP's place.
        return str_contains($log, 'serving initial configuration') ? $this->port : null;
    }

    public function commandEnvironment(): array
    {
        return ['INTAKT_INSTANCE_ADMIN_URL' => $this->adminUrl()];
    }

    public function labeled(InstanceStatus $status): InstanceStatus
    {
        return $status->inMode('worker');
    }

    private function adminUrl(): string
    {
        return 'http://127.0.0.1:'.$this->adminPort;
    }

    /**
     * @return list<int>
     */
    private function freePorts(): array
    {
        // FrankenPHP cannot report a port it picked itself; both sockets stay open until both ports are known, so they differ.
        $sockets = [$this->freeSocket(), $this->freeSocket()];
        $ports = array_map(static fn ($socket): int => (int) array_last(explode(':', (string) stream_socket_get_name($socket, false))), $sockets);
        array_map(fclose(...), $sockets);

        return $ports;
    }

    /**
     * @return resource
     */
    private function freeSocket()
    {
        $socket = stream_socket_server('tcp://127.0.0.1:0', $code, $message);

        if (false === $socket) {
            throw new RuntimeException('cannot find a free port: '.$message);
        }

        return $socket;
    }

    // Not the repository's Caddyfile, because that one needs the Mercure settings and the mcp worker; num_threads is fixed because FrankenPHP's default of two threads per CPU makes the memory a boot needs grow with the host, and on a host with many CPUs under an address-space limit PHP then exits with a bare "Out of memory" before it serves; log_errors is turned on because FrankenPHP runs PHP with it off, and a fatal error during the boot would then only reach the response body, never the log the failure reason is read from; the site names no host because a Caddy site address also matches the Host header and Caddy answers a request no site matches with an empty 200, so bind alone keeps it on loopback; metrics is on because FrankenPHP adds its queue series to the admin API's /metrics only then, and the instance's board reads them there.
    private function caddyfile(): string
    {
        $public = $this->root.'/public';

        return <<<CADDYFILE
            {
            	admin 127.0.0.1:{$this->adminPort}
            	metrics
            	frankenphp {
            		num_threads 2
            		php_ini log_errors 1
            	}
            }

            http://:{$this->port} {
            	bind 127.0.0.1
            	root "{$public}"
            	php_server {
            		worker {
            			name app
            			file "{$public}/index.php"
            			num 1
            			env FRANKENPHP_WORKER 1
            		}
            	}
            }

            CADDYFILE;
    }
}

final readonly class ScratchCreation
{
    public function create(string $path): void
    {
        // A concurrent run may rmdir the var/ fallback between its creation and the scratch folder below it, so retry once.
        $failure = $this->attempt($path);
        $failure = null === $failure ? null : $this->attempt($path);

        if (null !== $failure) {
            throw new RuntimeException('cannot create the scratch directory: '.$failure);
        }
    }

    private function attempt(string $path): ?string
    {
        $reason = 'unknown reason';
        // The handler keeps the operating system's reason without printing the warning of a lost race.
        set_error_handler(static function (int $severity, string $message) use (&$reason): bool {
            $reason = $message;

            return true;
        });

        mkdir($path, 0o700, true);
        restore_error_handler();

        return is_dir($path) ? null : $reason;
    }
}

final readonly class DirectoryRemoval
{
    public function remove(string $directory): void
    {
        if (!is_dir($directory)) {
            return;
        }

        $files = new RecursiveIteratorIterator(
            new RecursiveDirectoryIterator($directory, FilesystemIterator::SKIP_DOTS),
            RecursiveIteratorIterator::CHILD_FIRST,
        );

        foreach ($files as $file) {
            if (!$file instanceof SplFileInfo) {
                continue;
            }

            $file->isDir() && !$file->isLink() ? rmdir($file->getPathname()) : unlink($file->getPathname());
        }

        rmdir($directory);
    }
}

/**
 * @return resource|null
 */
function statusChannel()
{
    // Opened only after the server has stopped, so nothing the script started can inherit a duplicate of it.
    $channel = @fopen('php://fd/3', 'w');

    if (false === $channel) {
        return null;
    }

    // OPcache's lock is an unlinked memfd named opcache_lock that can take a closed descriptor 3, so among unlinked descriptors only a memfd not named opcache_lock counts as the caller's channel.
    $unlinked = 0 === (fstat($channel)['nlink'] ?? 0);
    $target = (string) @readlink('/proc/self/fd/3');
    $callersMemfd = str_starts_with($target, '/memfd:') && '/memfd:opcache_lock (deleted)' !== $target;

    return $unlinked && !$callersMemfd ? null : $channel;
}

function executableOnPath(string $name): ?string
{
    $path = getenv('PATH');

    foreach (false === $path ? [] : explode(':', $path) as $directory) {
        $candidate = executableIn($directory, $name);

        if (null !== $candidate) {
            return $candidate;
        }
    }

    return null;
}

function executableIn(string $directory, string $name): ?string
{
    // An empty entry stands for the caller's directory, because that is how the shell reads PATH.
    $candidate = '' === $directory ? $name : $directory.'/'.$name;

    if (!is_file($candidate) || !is_executable($candidate)) {
        return null;
    }

    // Absolute because the server starts from the project root, where a relative entry of the caller's PATH would point elsewhere.
    return str_starts_with($candidate, '/') ? $candidate : getcwd().'/'.$candidate;
}

$argv ??= [];
$command = array_slice($argv, 1);
$command = '--' === array_first($command) ? array_slice($command, 1) : [];
// Needed so a test can prove the cap without waiting for the full minute.
$commandSeconds = (int) getenv('INTAKT_INSTANCE_COMMAND_SECONDS');

$root = dirname(__DIR__);
// The image ships frankenphp, so there the instance runs the app the way the image serves it.
$frankenphp = executableOnPath('frankenphp');
$web = null === $frankenphp ? new BuiltInServer($root) : new WorkerServer($root, $frankenphp);

$instance = new Instance($root, $web, $command, $commandSeconds > 0 ? $commandSeconds : Instance::COMMAND_SECONDS, new DirectoryRemoval());
$status = $instance->run();

// A command's own output is what the caller wants, so the server log is noise unless the boot failed.
if ([] === $command || !$status->ready) {
    fwrite(STDOUT, $instance->log());
}

$statusChannel = statusChannel();
$reported = null !== $statusChannel && false !== fwrite($statusChannel, $status->toJson());

exit($status->ready && $reported ? $instance->commandExit() : 1);
