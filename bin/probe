#!/usr/bin/env php
<?php

declare(strict_types=1);

// Needs no Composer autoloader itself, like bin/instance, which it reuses to boot the instance.

final readonly class Network
{
    // sysfs shows the namespace it was mounted in, so loopback is tested by connecting through it instead.
    public function __construct(
        private string $devices = '/proc/net/dev',
        private string $loopbackAddress = '127.0.0.1:0',
    ) {
    }

    public function offlineProblem(): ?string
    {
        $names = $this->deviceNames();

        // Without a trustworthy list no other interface can be ruled out, so the run is refused rather than assumed offline.
        if (null === $names) {
            return 'the network interfaces cannot be read from '.$this->devices;
        }

        $others = array_values(array_diff($names, ['lo']));

        if ([] !== $others) {
            return 'a network interface other than lo is visible ('.implode(', ', $others).')';
        }

        return $this->loopbackWorks() ? null : 'the loopback interface lo is down';
    }

    /**
     * @return ?list<string>
     */
    private function deviceNames(): ?array
    {
        $lines = @file($this->devices, FILE_IGNORE_NEW_LINES);

        if (false === $lines || count($lines) < 3) {
            return null;
        }

        $names = [];

        foreach (array_slice($lines, 2) as $line) {
            if (1 !== preg_match('#^\s*([^\s:]+):#', $line, $match)) {
                return null;
            }

            $names[] = $match[1];
        }

        return $names;
    }

    // A down lo still owns 127.0.0.1, so binding alone passes; only a connection through it shows the state.
    private function loopbackWorks(): bool
    {
        $server = @stream_socket_server('tcp://'.$this->loopbackAddress);

        if (false === $server) {
            return false;
        }

        $client = @stream_socket_client('tcp://'.stream_socket_get_name($server, false), $code, $message, 1);
        fclose($server);

        if (false === $client) {
            return false;
        }

        fclose($client);

        return true;
    }
}

enum Isolation: string
{
    case ByUnshare = 'unshare';
    case ByCaller = 'caller';

    // Without the variable the probe cannot know the caller isolates it, and without it, a run must never have the network open.
    public static function fromVariable(string $value): self
    {
        return '1' === $value ? self::ByCaller : self::ByUnshare;
    }
}

final readonly class Probe
{
    private const string PATTERN = '#^tests/Probe/[A-Za-z0-9_][A-Za-z0-9_.-]*\.php$#';

    private const string DEFAULT_SEARCH_PATH = '/bin:/usr/bin';

    public function __construct(private string $root, private Isolation $isolation, private Network $network)
    {
    }

    public function run(string $file): int
    {
        if (1 !== preg_match(self::PATTERN, $file) || !is_file($this->root.'/'.$file)) {
            fwrite(STDERR, "usage: php bin/probe tests/Probe/NAME.php (an existing file; NAME ending in Test is a PHPUnit test, anything else a PHP script)\n");

            return 2;
        }

        $refusal = $this->refusal();

        if (null !== $refusal) {
            fwrite(STDERR, $refusal.PHP_EOL);

            return 2;
        }

        $exit = $this->runOffline($file);
        fwrite(STDOUT, 'exit code: '.$exit.PHP_EOL);

        return $exit;
    }

    public function refusal(): ?string
    {
        if (Isolation::ByUnshare === $this->isolation) {
            return $this->missingTools();
        }

        $problem = $this->network->offlineProblem();

        return null === $problem ? null : 'PROBE_ISOLATED is set but the run is not offline: '.$problem;
    }

    /**
     * @return list<string>
     */
    public function command(string $file): array
    {
        $instance = [PHP_BINARY, $this->root.'/bin/instance', '--', ...$this->probeCommand($file)];

        if (Isolation::ByCaller === $this->isolation) {
            return $instance;
        }

        // A new network namespace starts with loopback down, which the instance needs; as PID 1 of a new PID namespace, bin/instance takes everything the probe leaves running down with it.
        return [
            'unshare', '--net', '--map-root-user', '--pid', '--fork', '--kill-child',
            'sh', '-c', 'ip link set lo up && exec "$@"', 'sh',
            ...$instance,
        ];
    }

    // Because a missing tool otherwise shows up only as an instance that never became ready.
    private function missingTools(): ?string
    {
        $missing = array_filter(['unshare', 'sh', 'ip'], fn (string $tool): bool => !$this->isOnPath($tool));

        return [] === $missing ? null : implode(PHP_EOL, array_map(static fn (string $tool): string => $tool.' not found, see docs/architecture/requirements.md', $missing));
    }

    private function isOnPath(string $tool): bool
    {
        return array_any(
            explode(PATH_SEPARATOR, $this->searchPath()),
            fn (string $entry): bool => is_file($this->folderOf($entry).'/'.$tool) && is_executable($this->folderOf($entry).'/'.$tool),
        );
    }

    // Because execvp searches the C library's default path when PATH is unset, while an empty PATH means only the current folder.
    private function searchPath(): string
    {
        $path = getenv('PATH');

        return false === $path ? self::DEFAULT_SEARCH_PATH : $path;
    }

    // Because the run starts in the project root, a relative or empty PATH entry resolves there, as execvp does.
    private function folderOf(string $entry): string
    {
        if ('' === $entry) {
            return $this->root;
        }

        return str_starts_with($entry, '/') ? $entry : $this->root.'/'.$entry;
    }

    private function runOffline(string $file): int
    {
        $command = $this->command($file);
        $descriptors = [0 => ['file', '/dev/null', 'r'], 1 => STDOUT, 2 => STDERR, 3 => ['pipe', 'w']];

        $process = proc_open($command, $descriptors, $pipes, $this->root);

        if (false === $process) {
            fwrite(STDERR, "cannot start the offline instance\n");

            return 1;
        }

        $status = trim((string) stream_get_contents($pipes[3]));
        fclose($pipes[3]);
        $exit = proc_close($process);

        return $this->exitOf($exit, $status);
    }

    /**
     * @return list<string>
     */
    private function probeCommand(string $file): array
    {
        if (str_ends_with($file, 'Test.php')) {
            return [PHP_BINARY, 'vendor/bin/phpunit', '--no-configuration', '--bootstrap', 'tests/bootstrap.php', '--do-not-record-test-run-history', $file];
        }

        return [PHP_BINARY, $file];
    }

    private function exitOf(int $exit, string $status): int
    {
        // Exact lines rather than decoded JSON, because anything else from the instance must count as not ready.
        if (in_array($status, ['{"status":"ready"}', '{"status":"ready","mode":"worker"}'], true)) {
            return $exit;
        }

        fwrite(STDERR, 'the instance did not become ready: '.('' === $status ? 'no status reported (is unshare with network namespaces available, or PROBE_ISOLATED set by a caller that isolates the run?)' : $status).PHP_EOL);

        return 0 === $exit ? 1 : $exit;
    }
}

// Tests load this file for the classes above, so only a direct run starts a probe.
$script = $_SERVER['SCRIPT_FILENAME'] ?? '';

if (is_string($script) && __FILE__ === realpath($script)) {
    exit(new Probe(dirname(__DIR__), Isolation::fromVariable((string) getenv('PROBE_ISOLATED')), new Network())->run($argv[1] ?? ''));
}
