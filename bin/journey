#!/usr/bin/env php
<?php

declare(strict_types=1);

use Intakt\Tests\JourneyPage\GhCliApi;
use Intakt\Tests\JourneyPage\GitHubReader;
use Intakt\Tests\JourneyPage\JourneyInputFailed;
use Intakt\Tests\JourneyPage\JourneyPage;
use Intakt\Tests\JourneyPage\RecordedApi;
use Intakt\Tests\JourneyPage\UsageReader;
use Symfony\Component\Clock\NativeClock;

const USAGE = "usage: bin/journey [--recorded=<folder with the recorded API answers>]\n";

$autoload = __DIR__.'/../vendor/autoload.php';

if (!is_file($autoload)) {
    fwrite(STDERR, "run composer install first\n");
    exit(2);
}

require $autoload;

$recorded = null;

foreach (array_slice($argv, 1) as $argument) {
    if (!str_starts_with($argument, '--recorded=') || null !== $recorded) {
        fwrite(STDERR, USAGE);
        exit(2);
    }

    $recorded = substr($argument, 11);
}

$root = dirname(__DIR__);
$pageFile = $root.'/docs/journey.md';
$page = is_file($pageFile) ? file_get_contents($pageFile) : false;

if (false === $page) {
    fwrite(STDERR, "cannot read docs/journey.md\n");
    exit(1);
}

$api = null === $recorded ? new GhCliApi((string) getenv('GITHUB_REPOSITORY')) : new RecordedApi($recorded);

try {
    $output = new JourneyPage(new GitHubReader($api), new UsageReader(), new NativeClock())->regenerated($page, $root.'/docs/journey/usage.jsonl');
} catch (JourneyInputFailed $failure) {
    fwrite(STDERR, $failure->getMessage()."\n");
    exit(1);
}

$files = [];

foreach ($output->drawings as $name => $svg) {
    $files['docs/journey/'.$name.'.svg'] = $svg."\n";
}

// The page goes last, so a failed drawing never leaves a page that points at a chart it did not write.
$files['docs/journey.md'] = $output->page;
$changed = array_filter($files, static fn (string $content, string $path): bool => !is_file($root.'/'.$path) || file_get_contents($root.'/'.$path) !== $content, ARRAY_FILTER_USE_BOTH);

if ([] === $changed) {
    fwrite(STDOUT, "docs/journey.md and its drawings are current\n");
    exit(0);
}

foreach ($changed as $path => $content) {
    if (false === @file_put_contents($root.'/'.$path, $content)) {
        fwrite(STDERR, 'cannot write '.$path."\n");
        exit(1);
    }

    fwrite(STDOUT, $path." regenerated\n");
}
