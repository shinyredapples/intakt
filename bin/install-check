#!/usr/bin/env php
<?php

declare(strict_types=1);

use Intakt\Tests\Journeys\Support\InstallCheck;
use Intakt\Tests\Journeys\Support\InstallCheckCouldNotRun;
use Intakt\Tests\Journeys\Support\InstallProcessRunner;
use Intakt\Tests\Journeys\Support\InstallReport;
use Intakt\Tests\Journeys\Support\InstallStatus;
use Symfony\Component\Clock\NativeClock;
use Symfony\Component\Filesystem\Filesystem;
use Symfony\Component\Process\Exception\ProcessTimedOutException;
use Symfony\Component\Process\Process;

const USAGE = "usage: bin/install-check [<repository address or path, default the GitHub repository>]\n";
const STEP_SECONDS = 1800;
const ALARM_SECONDS = 600;

$autoload = __DIR__.'/../vendor/autoload.php';

if (!is_file($autoload)) {
    fwrite(STDERR, "run composer install first\n");
    exit(2);
}

require $autoload;

$arguments = array_slice($argv, 1);

if (count($arguments) > 1 || str_starts_with($arguments[0] ?? '', '-')) {
    fwrite(STDERR, USAGE);
    exit(2);
}

$checkout = dirname(__DIR__);
$files = new Filesystem();
$logs = $checkout.'/var/install-check/'.new NativeClock()->now()->format('Ymd-His').'-'.bin2hex(random_bytes(3));
$temporary = sys_get_temp_dir().'/intakt-install-check-'.bin2hex(random_bytes(6));
$files->mkdir($temporary);
$keys = [];

foreach (InstallCheck::KEYS as $name) {
    $keys[$name] = (string) getenv($name);
}

$report = null;

// exit() skips a finally block, so the folder is removed before the could-not-run exit is taken.
try {
    $report = new InstallCheck(new InstallProcessRunner(STEP_SECONDS)->__invoke(...), $temporary, $logs, $checkout, $keys)->run($arguments[0] ?? InstallCheck::REPOSITORY);
} catch (InstallCheckCouldNotRun $stopped) {
    fwrite(STDERR, 'the install check could not run: '.$stopped->getMessage()."\n");
} finally {
    $files->remove($temporary);
}

if (!$report instanceof InstallReport) {
    exit(2);
}

$reportFile = $logs.'/report.json';
$files->dumpFile($reportFile, $report->toJson());

foreach ($report->steps as $step) {
    fwrite(STDOUT, $step->line()."\n");

    if (InstallStatus::Failed === $step->status) {
        fwrite(STDOUT, preg_replace('/^/m', '    ', $step->tail)."\n");
    }
}

fwrite(STDOUT, 'logs and screenshots in '.substr($logs, strlen($checkout) + 1)."\n");
$reported = true;

// Filing needs the repository the issues go to; a run by hand without it only prints.
if ('' === (string) getenv('GITHUB_REPOSITORY')) {
    fwrite(STDOUT, "not reported: set GITHUB_REPOSITORY and GH_TOKEN to file or close the issues through bin/journey-alarm\n");
} else {
    $run = array_all(['GITHUB_SERVER_URL', 'GITHUB_REPOSITORY', 'GITHUB_RUN_ID'], static fn (string $name): bool => '' !== (string) getenv($name))
        ? ['--run='.getenv('GITHUB_SERVER_URL').'/'.getenv('GITHUB_REPOSITORY').'/actions/runs/'.getenv('GITHUB_RUN_ID')]
        : [];
    $alarm = new Process([PHP_BINARY, __DIR__.'/journey-alarm', ...$run, '--install-check='.$reportFile], $checkout, null, null, ALARM_SECONDS);
    try {
        $alarm->run();
        $reported = $alarm->isSuccessful();
    } catch (ProcessTimedOutException) {
        $reported = false;
        fwrite(STDERR, 'bin/journey-alarm did not finish within '.ALARM_SECONDS." seconds\n");
    }

    fwrite(STDOUT, $alarm->getOutput());
    fwrite(STDERR, $alarm->getErrorOutput());
}

exit(match (true) {
    $report->hasFailed() => 1,
    !$reported => 2,
    default => 0,
});
