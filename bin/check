#!/usr/bin/env php
<?php

declare(strict_types=1);

use Intakt\Gates\CheckCommand;
use Intakt\Gates\ProfileScanPath;

$autoload = __DIR__.'/../vendor/autoload.php';

if (!is_file($autoload)) {
    fwrite(STDOUT, '{"error":"run composer install first"}'."\n");
    exit(2);
}

require $autoload;

$arguments = $_SERVER['argv'] ?? [];
$arguments = is_array($arguments) ? array_values(array_filter($arguments, is_string(...))) : [];

// Ini files load only at startup, so a PHP that did not scan the check ini runs this script again with it.
$scanPath = getenv('PHP_INI_SCAN_DIR');
$scanPath = ProfileScanPath::missingFrom(dirname(__DIR__), false === $scanPath ? null : $scanPath);

if (null !== $scanPath) {
    $process = proc_open([PHP_BINARY, __FILE__, ...array_slice($arguments, 1)], [STDIN, STDOUT, STDERR], $pipes, null, ['PHP_INI_SCAN_DIR' => $scanPath] + getenv());

    exit(false === $process ? 2 : proc_close($process));
}

exit(new CheckCommand(dirname(__DIR__))->run(array_slice($arguments, 1)));
