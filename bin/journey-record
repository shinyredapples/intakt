#!/bin/sh
# Records the GitHub answers bin/journey --recorded=<folder> reads. It runs on the CI runner, because the CI image has
# no gh and the token stays out of the container. The resources and the query are those of JourneyResource
# (tests/JourneyPage/JourneyRecordCommandTest.php keeps them the same).
set -eu

if [ "$#" -ne 1 ]; then
    echo 'usage: bin/journey-record <folder>' >&2
    exit 2
fi

folder=$1
repository=${GITHUB_REPOSITORY:-}

if [ -z "$repository" ]; then
    echo 'GITHUB_REPOSITORY is empty' >&2
    exit 1
fi

mkdir -p "$folder"
# The answers wait in a hidden folder until all three arrived, so a failed call never leaves half a recording.
partial=$(mktemp -d "$folder/.journey-record.XXXXXX")
trap 'rm -rf "$partial"' EXIT
trap 'exit 1' HUP INT TERM

for resource in milestones issues pulls; do
    if ! gh api "repos/$repository/$resource?state=all&per_page=100" --paginate --slurp > "$partial/$resource.json"; then
        echo "gh api failed for $resource" >&2
        exit 1
    fi
done

for resource in milestones issues pulls; do
    mv "$partial/$resource.json" "$folder/$resource.json"
done

# bin/pages settles the highlights statuses from this file alone, so its absence keeps them as written and never costs
# the journey page; it is derived from the issues just recorded, which list pull requests too, merged ones as closed.
# A path that cannot be replaced (a folder, say) only costs the statuses too, never the recording already in place.
states="$folder/issue-states.json"

if ! rm -f "$states" 2>/dev/null || [ -e "$states" ]; then
    echo 'cannot replace issue-states.json: the highlights statuses stay as written' >&2
elif ! { jq -c '[.[][] | objects | {number, state}]' "$folder/issues.json" > "$partial/issue-states.json" \
    && mv "$partial/issue-states.json" "$states"; }; then
    echo 'cannot derive issue-states.json: the highlights statuses stay as written' >&2
fi
