#!/usr/bin/env node
// The journey check: walks user journeys in a headless browser against a running Intakt and reports each one as passed or
// failed, with the step where it broke and, where one can be saved, a screenshot in var/journey-check/<run>/.
// Usage: bin/journey-check <address of a running dashboard>
// Exit code 0 when every journey passed, 1 when one failed, 2 when the check could not run.
// Needs Node.js 22 and Playwright (NODE_PATH names where it is installed); CHROME_PATH names a system Chrome or Chromium.
'use strict';

const fs = require('fs');
const path = require('path');
const { randomUUID } = require('crypto');

const ROOT = path.resolve(__dirname, '..');
const OUT = path.join(ROOT, 'var', 'journey-check');
const STEP_TIMEOUT_MS = 10_000;
// The recorded demo run plays for tens of seconds after the click, and a queue worker may start it late, so the verdict gets far longer than a click.
const VERDICT_TIMEOUT_MS = 180_000;
const USAGE = 'usage: bin/journey-check <address of a running dashboard>';
// Every heading templates/dashboard/_verdict_card.html.twig can show, so any verdict ends the long wait and a wrong one fails within a click's wait.
const OUTCOME = /^(Approved|Changes needed|Blocked: .+|Failed: .+|Checked, but the outcome was not recorded)$/;
// The verdict fixtures/demo/sample-change-review.json records, as the verdict card names it.
const RECORDED_VERDICT = 'Changes needed';
// Finding F1 of fixtures/demo/sample-change-review.json as its row on the review page names it; the sentence's own period must follow, so "amount > 100.50" is not taken for it.
const RECORDED_FINDING = /^The check changed from amount >= 100 to amount > 100\.(\s|$)/;
const JOURNEYS = [
  {
    name: 'First run without a key',
    steps: [
      named('open /setup and see the start', open('/setup'), seeRole('heading', 'See a real review')),
      press('button', 'Play the demo run'),
      // The demo page follows the run to its review as soon as the queue worker started it, which can be before the page is looked at, so its heading is asked for only while the page is still there.
      named('reach /demo and see the demo run', arrive('/demo'), seeRoleWhileAt('/demo', 'heading', 'The demo run')),
      named('wait for the verdict of the demo run', seeRole('heading', OUTCOME, VERDICT_TIMEOUT_MS), seeRole('heading', RECORDED_VERDICT)),
      named('see the recorded finding on the review page', seeRole('link', RECORDED_FINDING)),
    ],
  },
];

// Where each page's last press led: a page can move on by itself before the next step looks at it, so the addresses and their answers are kept from before the click.
const TRAILS = new WeakMap();

class CheckCouldNotRun extends Error {}

async function main(argv) {
  const address = parseAddress(argv[0]);
  await expectAnswer(address, STEP_TIMEOUT_MS);
  const { chromium } = require('playwright');
  const folder = path.join(OUT, runName(new Date()));
  const browser = await chromium.launch(process.env.CHROME_PATH ? { executablePath: process.env.CHROME_PATH } : {});
  try {
    const results = [];
    for (const [index, journey] of JOURNEYS.entries()) results.push(await runJourney(browser, address, journey, folder, index + 1));
    console.log(report(results, ROOT));

    return exitCode(results);
  } finally {
    await browser.close();
  }
}

// The address may carry a user name and password, which must never reach the output, so only the parsed address without them is kept.
function parseAddress(text) {
  if (text === undefined) throw new CheckCouldNotRun(USAGE);
  if (!URL.canParse(text)) throw new CheckCouldNotRun('the dashboard address is not a URL; ' + USAGE);
  const url = new URL(text);
  if (url.protocol !== 'http:' && url.protocol !== 'https:') throw new CheckCouldNotRun('the dashboard address is not an http or https address; ' + USAGE);
  url.username = '';
  url.password = '';
  url.search = '';
  url.hash = '';

  return url.href.replace(/\/+$/, '');
}

// A server that accepts the connection and never answers would otherwise hold the check forever.
async function expectAnswer(address, timeout) {
  try {
    const response = await fetch(address + '/', { signal: AbortSignal.timeout(timeout), redirect: 'manual' });
    await response.body?.cancel();
  } catch {
    throw new CheckCouldNotRun(`nothing answers at ${address} within ${timeout / 1000} s`);
  }
}

// Two runs may start in the same millisecond, so a random suffix keeps their screenshots apart.
function runName(now) {
  return now.toISOString().replace(/[:.]/g, '-') + '-' + randomUUID().slice(0, 8);
}

// A fresh context per journey, so cookies and storage one journey leaves behind never help or hinder the next.
async function runJourney(browser, address, journey, folder, position) {
  const context = await browser.newContext();
  try {
    const page = await context.newPage();
    page.setDefaultTimeout(STEP_TIMEOUT_MS);
    const failure = await firstFailingStep(page, address, journey.steps);
    if (failure === null) return { journey: journey.name, failure: null };

    return { journey: journey.name, failure: { ...failure, ...(await screenshot(page, screenshotFile(folder, position, journey.name))) } };
  } finally {
    await context.close();
  }
}

async function firstFailingStep(page, address, steps) {
  for (const step of steps) {
    try {
      await step.run(page, address);
    } catch (error) {
      return { step: step.name, error: firstLine(error) };
    }
  }

  return null;
}

// Playwright's messages go on with a call log; the first line says what broke.
function firstLine(error) {
  return String(error?.message ?? error).split('\n')[0];
}

// A missing screenshot must not hide the broken step, so a failure to save one is reported beside it.
async function screenshot(page, file) {
  try {
    fs.mkdirSync(path.dirname(file), { recursive: true });
    await page.screenshot({ path: file, fullPage: true });

    return { screenshot: file };
  } catch (error) {
    return { screenshotError: firstLine(error) };
  }
}

// Two names can reduce to the same file name ("Read a verdict" and "Read a verdict!"), so the journey's position in the run keeps their screenshots apart.
function screenshotFile(folder, position, name) {
  const slug = name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');

  return path.join(folder, `${String(position).padStart(2, '0')}-${slug}.png`);
}

// Steps find what a person sees, by role and visible text and never by CSS classes, so a redesign keeps the journeys while a renamed button fails them.
function open(pathOnSite) {
  return {
    name: `open ${pathOnSite}`,
    run: async (page, address) => {
      const response = await page.goto(address + pathOnSite);
      if (response === null) throw new Error(`no page was loaded for ${pathOnSite}`);
      if (!response.ok()) throw new Error(`HTTP ${response.status()} for ${pathOnSite}`);
    },
  };
}

// A button that posts somewhere else, also on another install, would leave the journey on a wrong page that still shows what a later step looks for, so the origin and the path the press led to are checked, and the answer there must be a success.
function arrive(pathOnSite) {
  return {
    name: `arrive at ${pathOnSite}`,
    run: async (page, address) => {
      const trail = TRAILS.get(page);
      if (trail === undefined) throw new Error(`no press came before the arrival at ${pathOnSite}`);
      const expected = new URL(address + pathOnSite);
      const reached = () => trail.visits.some((visit) => isAt(visit, expected) && isSuccess(trail.statuses.get(visit)));
      if (!(await holdsWithin(trail, reached, STEP_TIMEOUT_MS))) {
        throw new Error(`the press did not lead to ${pathOnSite} with a success status within ${STEP_TIMEOUT_MS / 1000} s; it led to ${describe(trail)}`);
      }
    },
  };
}

function isAt(address, expected) {
  const url = new URL(address);

  return url.origin === expected.origin && url.pathname === expected.pathname;
}

function isSuccess(status) {
  return status !== undefined && status >= 200 && status < 300;
}

function holdsWithin(trail, holds, timeout) {
  return new Promise((resolve) => {
    const timer = setTimeout(() => resolve(false), timeout);
    trail.changed = () => {
      if (!holds()) return;
      clearTimeout(timer);
      resolve(true);
    };
    trail.changed();
  });
}

// Only the origin and the path are named, so a query string never reaches the output.
function describe(trail) {
  if (trail.visits.length === 0) return 'no other address';

  return trail.visits.map((visit) => `${originAndPath(visit)} (${status(trail.statuses.get(visit))})`).join(', then ');
}

function originAndPath(address) {
  const url = new URL(address);

  return url.origin + url.pathname;
}

function status(code) {
  return code === undefined ? 'no answer seen' : `HTTP ${code}`;
}

// The watch starts before the click, so no address the press leads to is missed, however soon the page leaves it again.
function press(role, name) {
  return {
    name: `press the ${role} "${name}"`,
    run: (page) => {
      watch(page);

      return page.getByRole(role, { name, exact: true }).click();
    },
  };
}

// A page can change its address with or without loading a new document (Turbo fetches the page and pushes the address), so the main frame's addresses and the answers to its requests are kept apart and joined by address.
function watch(page) {
  TRAILS.get(page)?.stop();
  const trail = { visits: [], statuses: new Map(), changed: () => {} };
  const visited = (frame) => {
    if (frame !== page.mainFrame()) return;
    trail.visits.push(withoutFragment(frame.url()));
    trail.changed();
  };
  const answered = (response) => {
    if (!isOfMainFrame(page, response)) return;
    trail.statuses.set(withoutFragment(response.url()), response.status());
    trail.changed();
  };
  trail.stop = () => {
    page.off('framenavigated', visited);
    page.off('response', answered);
  };
  page.on('framenavigated', visited);
  page.on('response', answered);
  TRAILS.set(page, trail);
}

function withoutFragment(address) {
  return address.split('#')[0];
}

// Playwright throws when asked for the frame of a service worker's request, and a throw in a listener would stop the whole check.
function isOfMainFrame(page, response) {
  try {
    return response.frame() === page.mainFrame();
  } catch {
    return false;
  }
}

function see(text) {
  return { name: `see "${text}"`, run: (page) => page.getByText(text, { exact: true }).filter({ visible: true }).first().waitFor() };
}

// Playwright ignores exact for a pattern, so a pattern name must be anchored itself.
function seeRole(role, name, timeout = STEP_TIMEOUT_MS) {
  return {
    name: name instanceof RegExp ? `see the ${role} matching ${name}` : `see the ${role} "${name}"`,
    run: (page) => page.getByRole(role, { name, exact: true }).filter({ visible: true }).first().waitFor({ timeout }),
  };
}

// For a page that sends its visitor on by itself: what it shows is asked for only while the page is still there, and a page that already moved on passes only if it went to a review page of the same install, as any other page could show what a later step looks for.
function seeRoleWhileAt(pathOnSite, role, name) {
  return {
    name: `see the ${role} "${name}" while at ${pathOnSite}`,
    run: async (page, address) => {
      const expected = new URL(address + pathOnSite);
      let departure;
      if (isAt(page.url(), expected)) {
        const seen = seeRole(role, name).run(page);
        const left = page.waitForURL((url) => {
          if (isAt(url.href, expected)) return false;
          departure ??= url.href;

          return true;
        }, { waitUntil: 'commit' });
        // The losing promise's rejection is caught so it does not become an unhandled rejection that stops the check.
        seen.catch(() => {});
        left.catch(() => {});
        await Promise.race([seen, left]);
      }
      // A page that was gone before this step looked may have passed a wrong address on its way, so the press's trail is asked first.
      const where = firstAddressAfter(TRAILS.get(page), expected) ?? departure ?? page.url();
      if (!isAt(where, expected) && !isReviewPage(where, address)) {
        throw new Error(`the page left ${pathOnSite} for ${originAndPath(where)}, not for a review page on ${new URL(address).origin}`);
      }
    },
  };
}

function firstAddressAfter(trail, expected) {
  const visits = trail?.visits ?? [];
  const arrival = visits.findIndex((visit) => isAt(visit, expected));
  if (arrival === -1) return undefined;

  return visits.slice(arrival).find((visit) => !isAt(visit, expected));
}

// Only the review page shows the run's own verdict, so a page below it or on another install could pass the later steps by accident.
function isReviewPage(where, address) {
  const url = new URL(where);
  const reviews = new URL(address + '/reviews/');
  if (url.origin !== reviews.origin || !url.pathname.startsWith(reviews.pathname)) return false;
  const round = decoded(url.pathname.slice(reviews.pathname.length));

  return round !== null && round !== '' && !round.includes('/');
}

// The dashboard's router decodes the path before it matches, so %2F in the address is a slash to it; a segment that cannot be decoded is no review page.
function decoded(segment) {
  try {
    return decodeURIComponent(segment);
  } catch {
    return null;
  }
}

// One step a person would name, made of the smaller steps that prove it, so the report says which part of the journey broke.
function named(name, ...steps) {
  return {
    name,
    run: async (page, address) => {
      for (const step of steps) await step.run(page, address);
    },
  };
}

function report(results, root) {
  const lines = results.flatMap((result) => resultLines(result, root));
  const failed = results.filter((result) => result.failure !== null).length;
  lines.push(`Journey check: ${results.length} journeys, ${results.length - failed} passed, ${failed} failed.`);

  return lines.join('\n');
}

function resultLines(result, root) {
  if (result.failure === null) return [`passed ${result.journey}`];
  const { step, error, screenshot: file, screenshotError } = result.failure;

  return [
    `failed ${result.journey} at step "${step}": ${error}`,
    file === undefined ? `  no screenshot: ${screenshotError}` : `  screenshot: ${path.relative(root, file)}`,
  ];
}

function exitCode(results) {
  return results.some((result) => result.failure !== null) ? 1 : 0;
}

module.exports = {
  STEP_TIMEOUT_MS,
  VERDICT_TIMEOUT_MS,
  OUTCOME,
  RECORDED_FINDING,
  RECORDED_VERDICT,
  JOURNEYS,
  parseAddress,
  expectAnswer,
  runName,
  runJourney,
  screenshotFile,
  open,
  press,
  see,
  seeRole,
  seeRoleWhileAt,
  arrive,
  named,
  report,
  exitCode,
};

if (require.main === module) {
  main(process.argv.slice(2)).then(
    (code) => (process.exitCode = code),
    (error) => {
      console.error('Journey check stopped: ' + error.message);
      process.exitCode = 2;
    },
  );
}
