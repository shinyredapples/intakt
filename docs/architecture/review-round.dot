// The state machines of a review round (plan task T9, parts 2 and 3; the judged place from T12). Render with: dot -Tsvg review-round.dot
// The places and transitions are the cases of RoundState, RoundTransition, ReviewerState and ReviewerTransition in src/Core/Review/Domain/. The attributes of src/Core/Review/Infrastructure/ReviewRoundStateMachine.php declare the review_round workflow and those of src/Core/Review/Infrastructure/ReviewerStateMachine.php the reviewer workflow.
// This drawing adds the guards and side effects by hand; review-round-machine.dot and reviewer-machine.dot are the two machines as bin/console workflow:dump review_round and workflow:dump reviewer generate them.
digraph review_round {
    rankdir=LR;
    node [shape=circle, fontname="Helvetica"];
    edge [fontname="Helvetica"];

    subgraph cluster_round {
        label="review_round (state machine of ReviewRound)";
        round_start [shape=point, label=""];
        collecting;
        complete;
        judged [shape=doublecircle];
        round_start -> collecting;
        collecting -> complete [label="complete\n(guard: every reviewer is in verdict, failed or blocked;\nqueues the judge)"];
        complete -> judged [label="judge\n(the judge's result is recorded once)"];
    }

    subgraph cluster_reviewer {
        label="reviewer (state machine of RoundReviewer, one per panel member)";
        reviewer_start [shape=point, label=""];
        queued;
        running;
        verdict [shape=doublecircle];
        failed [shape=doublecircle];
        blocked [shape=doublecircle];
        reviewer_start -> queued;
        queued -> running [label="start\n(started_at = now; held for one hour)"];
        running -> verdict [label="receive"];
        running -> failed [label="fail\n(the call failed)"];
        running -> queued [label="requeue\n(the ledger refused the end event, a rate limit,\nor the first stopped worker before start)"];
        running -> blocked [label="block\n(the worker stopped twice)"];
        queued -> blocked [label="block\n(the message reached the failure transport)"];
    }
}
