{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Output of intakt:review --format=json",
    "type": "object",
    "additionalProperties": false,
    "required": ["round_id", "round", "decision", "exit_code", "verdicts", "act_list", "tokens", "cost", "reasons"],
    "properties": {
        "round_id": {"type": "string", "minLength": 1},
        "round": {"type": "integer", "minimum": 1},
        "decision": {"enum": ["approve", "changes", "blocked"]},
        "exit_code": {"enum": [0, 10, 11]},
        "verdicts": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["tier", "decision", "findings"],
                "properties": {
                    "tier": {"enum": ["strong", "standard", "light"]},
                    "decision": {"enum": ["approve", "changes", "blocked"]},
                    "findings": {"type": "integer", "minimum": 0}
                }
            }
        },
        "act_list": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "severity", "file", "line", "symbol", "text", "fixable_by", "merged"],
                "properties": {
                    "id": {"type": "string", "minLength": 1},
                    "severity": {"enum": ["P1", "P2", "P3"]},
                    "file": {"type": ["string", "null"]},
                    "line": {"type": ["integer", "null"], "minimum": 1},
                    "symbol": {"type": ["string", "null"]},
                    "text": {"type": "string", "minLength": 1},
                    "fixable_by": {"enum": ["builder", "owner"]},
                    "merged": {"type": "array", "items": {"type": "string", "minLength": 1}}
                }
            }
        },
        "tokens": {
            "type": "object",
            "additionalProperties": false,
            "required": ["calls", "prompt", "cache_read", "cache_write", "cached", "completion", "total"],
            "properties": {
                "calls": {"type": "integer", "minimum": 0},
                "prompt": {"type": "integer", "minimum": 0},
                "cache_read": {"type": "integer", "minimum": 0},
                "cache_write": {"type": "integer", "minimum": 0},
                "cached": {"type": "integer", "minimum": 0},
                "completion": {"type": "integer", "minimum": 0},
                "total": {"type": "integer", "minimum": 0}
            }
        },
        "cost": {
            "type": "object",
            "additionalProperties": false,
            "required": ["usd", "unpriced"],
            "properties": {
                "usd": {"type": ["number", "null"], "minimum": 0},
                "unpriced": {"type": "array", "items": {"type": "string"}}
            }
        },
        "reasons": {"type": "array", "items": {"type": "string"}}
    }
}
