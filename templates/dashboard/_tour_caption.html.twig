{#- Nothing outside the compose demo; an empty element before a demo run, so the live update that starts the tour has a target. -#}
{#- data-tour-at names the element on the review page the stage talks about, by the ids that round's live updates target, so a page that does not show the caption's round marks nothing; assets/tour-caption.js marks it. -#}
{%- if caption is not null %}
{%- if caption.stage is null %}
<div id="tour-caption" hidden></div>
{%- else %}
{%- set round = caption.round %}
{%- set focus = {'change-arrives': '[id="round-' ~ round ~ '-now-phase"]', 'reviewers-read': '[id="round-' ~ round ~ '-now-reviewers"]', 'findings-arrive': '[id="round-' ~ round ~ '-now-reviewers"]', 'judge-weighs': '[id="round-' ~ round ~ '-now-judge"]', 'round-ends': '#review-verdict[data-round="' ~ round ~ '"]'} %}
<aside id="tour-caption" class="tour-caption" aria-label="Demo tour" data-stage="{{ caption.stage.value }}" data-round="{{ round }}" data-tour-at="{{ focus[caption.stage.value] }}"{% if caption.stage.number == caption.stage.count %} data-tour-last{% endif %}>
    <span class="tour-dots" role="img" aria-label="Step {{ caption.stage.number }} of {{ caption.stage.count }}">
        {%- for stage in enum_cases('Intakt\\Core\\Dashboard\\Domain\\TourStage') %}<span class="tour-dot{% if stage.number < caption.stage.number %} done{% elseif stage is same as(caption.stage) %} now{% endif %}"></span>{% endfor -%}
    </span>
    <p class="tour-line">{{ caption.stage.sentence }}
        {%- if caption.reviewers is not empty %} <span class="tour-reviewers">Reviewers: {% for outcome in caption.reviewers %}<span{% if outcome.model is not null and outcome.model is not same as('') %} title="{{ outcome.model }}"{% endif %}>{{ outcome.modelAndLab }}</span>{% if not loop.last %}, {% endif %}{% endfor %}.</span>{% endif -%}
    </p>
    <a class="tour-review" href="{{ path(constant('Intakt\\Core\\Dashboard\\Contract\\DashboardRoutes::SHOW_REVIEW'), {round: round}) }}"><span>Open the review</span></a>
    <button type="button" class="btn quiet sm" data-tour-pause aria-pressed="false">Pause</button>
    <button type="button" class="btn quiet sm" data-tour-close>Close</button>
</aside>
{%- endif %}
{%- endif %}
