{% extends 'dashboard/base.html.twig' %}

{% block title %}Board - Intakt{% endblock %}

{% block content_width %} wide{% endblock %}

{% block body %}
<div class="page-head">
    {{ include('dashboard/_board_octopus.html.twig', {board: board}, with_context = false) }}
    <div>
        <h1>Board</h1>
        {# The id is the target of the pushed headline (LiveBoardHeadline), which updates only the words inside, so the line rendered here stays when live updates are off. #}
        <p class="lead" id="board-headline">{{ include('dashboard/_board_headline.html.twig', {headline: board.headline}, with_context = false) }}</p>
    </div>
    <div class="actions">
        {# Only while no review has run, because after that the Projects page carries the link (#2067, D3). #}
        {% if board.firstDay %}<a class="btn primary" href="{{ path(constant('Intakt\\Core\\Dashboard\\Contract\\DashboardRoutes::FIRST_RUN')) }}">Set up Intakt</a>{% endif %}
        <a class="btn secondary" href="{{ path(constant('Intakt\\Core\\Dashboard\\Contract\\DashboardRoutes::LIST_REVIEWS')) }}">Open the review list</a>
    </div>
</div>
{% for main in failing_mains %}
    {% set headline = 'Main of ' ~ main.project ~ ' does not boot' %}
    {% embed 'dashboard/components/banner.html.twig' with {icon: 'broken', broken: true, project: main.project, short: headline, title: headline ~ '.', text: 'Reviews go ahead without the boot gate until it boots again: ' ~ main.reason} only %}
    {% endembed %}
{% endfor %}
{% for head in failing %}
    {% set headline = 'Pull request ' ~ head.change ~ ' of ' ~ head.project ~ ' failed' %}
    {% set state = head.handedOver ? 'Handed over to the maintainer agent after ' ~ head.fault.failures ~ ' failures' : head.fault.failures ~ (head.fault.failures == 1 ? ' failure' : ' failures') ~ ' in a row, next try at ' ~ head.fault.retryAt|date('H:i', 'UTC') ~ ' UTC' %}
    {% embed 'dashboard/components/banner.html.twig' with {icon: 'broken', broken: true, project: head.project, short: headline, title: headline ~ '.', text: state ~ ': ' ~ head.fault.cause} only %}
        {% block action %}<a class="btn quiet sm" href="{{ path(constant('Intakt\\Core\\Dashboard\\Contract\\DashboardRoutes::LIST_REVIEWS')) }}#failing-heads">See the failed pull requests</a>{% endblock %}
    {% endembed %}
{% endfor %}
{# A disclosure with no lane would open to nothing, so it is a plain line until a lane runs. #}
{% if working.lanes is empty %}
<p class="working working-none" id="working">{{ board.nobodyWorkingLine }}</p>
{% else %}
<details class="working" id="working">
    <summary><span class="w-title">Who is working</span><span class="w-dots" aria-hidden="true">{% for lane in working.lanes %}<span class="dot ok"></span>{% endfor %}</span><span class="w-sum">{{ working.working }} working</span>{{ include('dashboard/components/icon.html.twig', {name: 'chevron', small: true, extra: 'chev'}, with_context = false) }}</summary>
    <div class="lanes">
    {% for lane in working.lanes %}
        <div class="lane" data-project="{{ lane.project }}">
            <div class="who"><span class="dot ok"></span>{{ include('dashboard/components/character.html.twig', {character: constant('Intakt\\Core\\Dashboard\\Domain\\Character::CodeReviewer'), size: 24}, with_context = false) }}{{ lane.role }}, {{ lane.tier }}<span class="elapsed">since <time datetime="{{ lane.since|date('c', 'UTC') }}">{{ lane.since|date('H:i', 'UTC') }} UTC</time></span></div>
            <div class="what">{{ lane.change }}</div>
            <p class="meta"><span>{{ lane.project }}</span>{% if lane.round is not null %}<span>Round {{ lane.round }}</span>{% endif %}</p>
        </div>
    {% endfor %}
    </div>
</details>
{% endif %}
<section aria-labelledby="board-h">
    <h2 id="board-h" class="sr-only">Tasks by state</h2>
    {# The counts are totals over every project, so the project filter hides cards and never changes a count. A crowded column renders every card and marks those past the limit, which assets/column-more.js counts again over the cards the filter shows. The wrapper carries the edge classes assets/board-edge.js sets, because the fade they turn on masks the board inside it; the same script scrolls a board marked data-scroll-to-end to Done once. #}
    {% set limit = constant('Intakt\\Core\\Dashboard\\Domain\\Board::PAGE_LIMIT') %}
    <div class="board-wrap"{% if board.startsScrolledToDone %} data-scroll-to-end{% endif %}>
    {# Focusable, because a board with no card (a fresh install, or a phone that hides the column buttons) scrolls sideways with nothing in it the keyboard could reach. #}
    <div class="board" tabindex="0">
    {% for column in columns %}
        {{ include('dashboard/_board_column.html.twig', {board: board, column: column, limit: limit}, with_context = false) }}
    {% endfor %}
    </div>
    </div>
</section>
{% endblock %}
