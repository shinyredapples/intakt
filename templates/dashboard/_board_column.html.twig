{# One board column, shared by the page and by the columns LiveBoardHeadline pushes, so a pushed column shows the cards of a page loaded after it, except that it carries only the first limit of them, across every project even under the project filter, and a link to the board for the rest. #}
{% set cards = board.cardsIn(column) %}
{# A pushed column carries at most limit cards, because it goes to every page on the shell topic and Done grows with the install's history; a load of the board shows the rest. #}
{% set left_out = pushed|default(false) ? max(0, cards|length - limit) : 0 %}
{% set cards = cards|slice(0, cards|length - left_out) %}
{% set needs = column == constant('Intakt\\Core\\Dashboard\\Domain\\BoardColumn::WaitingOnYou') %}
{# A column that can fold always carries its strip and Hide, even when it starts open, because the layout puts this tab's own fold back on a pushed column and a folded column needs its strip to open again. #}
{% set folds = column.startsCollapsed %}
{% set folded = board.startsCollapsed(column) %}
{% set slug = column.slug %}
{% set count = board.countOf(column) %}
{% set crowded = cards|length > limit %}
{# Backlog and Done stay open on phones because DESIGN.md asks for it. A jump from the column map or the phone switcher focuses the column (assets/board-map.js), so it takes the focus without being a Tab stop. #}
<section class="col{{ needs ? ' col-needs' }}{{ folded ? ' collapsed' }}" id="col-{{ slug }}" aria-label="{{ column.value }}" tabindex="-1"{% if crowded %} data-page-limit="{{ limit }}"{% endif %}>
    {# The name is built from hidden words around the visible ones rather than an aria-label, so it contains what a speech user sees and says (WCAG 2.5.3). #}
    {% if folds %}<button type="button" class="col-fold" aria-expanded="{{ folded ? 'false' : 'true' }}" aria-controls="cards-{{ slug }}"><span><span class="sr-only">Show </span>{{ column.value }}</span>{{ include('dashboard/components/count.html.twig', {n: count}, with_context = false) }}<span class="sr-only"> {{ count == 1 ? 'task' : 'tasks' }}</span></button>{% endif %}
    <div class="col-head"><h3>{{ column.value }}</h3>{{ include('dashboard/components/count.html.twig', {n: count, needs: needs and cards is not empty}, with_context = false) }}{% if folds %}<button type="button" class="btn quiet sm col-hide" aria-label="Hide {{ column.value }}">Hide</button>{% endif %}</div>
    <div class="col-cards" id="cards-{{ slug }}">
    {% for review in cards %}
        {{ include('dashboard/_board_card.html.twig', {review: review, past_limit: loop.index > limit}, with_context = false) }}
    {% else %}
        {# An empty column says what it will hold and when, so a reader learns the board from it on the first day and after (#2067, D7; #2731). #}
        {{ include('dashboard/components/column_empty.html.twig', {text: board.emptyLineOf(column)}, with_context = false) }}
    {% endfor %}
    {% if crowded %}<button type="button" class="btn secondary sm more-btn">Show {{ cards|length - limit }} more</button>{% endif %}
    {% if left_out > 0 %}<a class="btn secondary sm more-link" href="{{ path(constant('Intakt\\Core\\Dashboard\\Contract\\DashboardRoutes::SHOW_BOARD'), {board: 1}) }}">Show {{ left_out }} more</a>{% endif %}
    </div>
</section>
