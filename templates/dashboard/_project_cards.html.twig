{#- The page's cards and the push that replaces them share this partial, so a pushed list never differs from a page loaded after it. Without a card it holds the empty state. -#}
<div id="project-cards">
{% if projects is empty %}
{{ include('dashboard/components/empty.html.twig', {title: 'No projects yet', text: 'No project has started a review yet.', action: {href: path(constant('Intakt\\Core\\Dashboard\\Contract\\DashboardRoutes::RUN_SETUP')), label: 'Set up Intakt'}}, with_context = false) }}
{% else %}
{% for project in projects %}
{%- set reviews = path(constant('Intakt\\Core\\Dashboard\\Contract\\DashboardRoutes::LIST_REVIEWS'), {project: project.name}) -%}
<article class="pblock" id="{{ project.elementId }}" data-project="{{ project.name }}">
    <div>
        <h2><span class="dot {{ project.status.dot }}"></span><a class="plink" href="{{ reviews }}" title="{{ project.name }}">{{ project.name }}</a></h2>
        <p class="small state{{ project.failing ? ' failing' : ' muted' }}">{{ project.status.words }}{% if project.problem is not null %}: {{ project.problem }}{% endif %}</p>
        <ul class="tiers">
            {% for tier in project.tiers %}
            <li><span class="muted">{{ tier.tier|capitalize }}</span> {{ tier.provider == '-' ? tier.modelOrProblem : tier.provider ~ ' ' ~ tier.modelOrProblem }}</li>
            {% endfor %}
        </ul>
    </div>
    <div>
        <p class="label-sm">Used so far</p>
        <p><span class="stat">{{ include('dashboard/components/cost.html.twig', {cost: project.cost, at: project.elementId}, with_context = false) }}</span></p>
        <dl>
            <dt>Tokens</dt><dd>{{ project.tokens.total|number_format }}</dd>
            <dt>Running</dt><dd>{{ project.running }}</dd>
            <dt>Judged</dt><dd>{{ project.judged }}</dd>
            <dt>Failing</dt><dd>{{ project.failing }}</dd>
        </dl>
    </div>
    <div>
        <p class="label-sm">Working on now</p>
        {% if project.working is empty %}
        <p class="muted">Nothing is running.</p>
        {% else %}
        <ul class="now">
            {% for card in project.working %}
            <li><a href="{{ path(constant('Intakt\\Core\\Dashboard\\Contract\\DashboardRoutes::SHOW_REVIEW'), {round: card.round}) }}">{{ card.title }}</a> <span class="muted small">{{ card.state|lower }}</span></li>
            {% endfor %}
        </ul>
        {% endif %}
        {% if project.recent is not empty %}
        <p class="label-sm after">Recently decided</p>
        <ul class="now">
            {% for outcome in project.recent %}
            <li><a href="{{ path(constant('Intakt\\Core\\Dashboard\\Contract\\DashboardRoutes::SHOW_REVIEW'), {round: outcome.round}) }}">{{ outcome.change }}</a> <span class="muted small">{{ outcome.words|lower }}</span></li>
            {% endfor %}
        </ul>
        {% endif %}
        {% if project.waitingOnYou > 0 %}
        {# The count is of the board's Waiting on you cards, so it leads to that column; the Waiting on you page lists outage notices, which belong to no project. #}
        <p class="asks"><a class="waits" href="{{ path(constant('Intakt\\Core\\Dashboard\\Contract\\DashboardRoutes::SHOW_BOARD'), {board: 1}) }}#col-waiting-on-you">{{ include('dashboard/components/count.html.twig', {n: project.waitingOnYou, needs: true}, with_context = false) }}<span>{{ project.waitingOnYou == 1 ? 'waits' : 'wait' }} on you</span></a></p>
        {% endif %}
    </div>
</article>
{% endfor %}
{% endif %}
</div>
