    {{ include('dashboard/components/meta.html.twig', {facts: [
        {text: reviewed.round, mono: true},
        {icon: 'clock', text: 'Started ' ~ reviewed.startedAt|date('Y-m-d H:i:s', 'UTC') ~ ' UTC'},
    ]}, with_context = false) }}

    {% set kinds = enum('Intakt\\Core\\Platform\\Contract\\FigureKind') %}
    {% set kind_label = 'dashboard/components/figure_kind.html.twig' %}
    {% set unfinished = reviewed.state.name != 'Judged' %}
    <p id="round-{{ reviewed.round }}-state">{% if not unfinished %}Judged.{% else %}{{ reviewed.outcomes|filter(o => o.progress.name != 'Running')|length }} of {{ reviewed.reviewers }} reviewers finished.{% endif %}</p>
    {% set running = unfinished and not reviewed.hasEnded %}
    {% if not unfinished %}
    {% set failed = reviewed.failedReviewers %}
    <p class="outcome" id="round-{{ reviewed.round }}-outcome">{% if reviewed.outcome is not null %}Outcome: {{ reviewed.outcome.value }}, decided by the quorum policy {{ reviewed.quorum.value }} over all {{ reviewed.reviewers }} reviewers.{% if failed > 0 %} {{ failed }} of {{ reviewed.reviewers }} reviewers failed, and a failed reviewer gives no approval.{% endif %}{% else %}No outcome shown: this round was started before Intakt recorded its quorum policy.{% endif %}</p>
    {% endif %}

    <h3>Reviewers</h3>
    <p class="muted">{{ reviewed.outcomes|length }} of {{ reviewed.reviewers }} reviewers started.</p>
    {# Shown while the round runs with no reviewer started too, because a reviewer that finishes after the page loaded is streamed into it. #}
    {% if reviewed.outcomes is not empty or running %}
    <div class="table-scroll" tabindex="0" role="region" aria-label="Reviewers of round {{ reviewed.round }}">
    <table class="ledger reviewers">
        {# The Stop column shows only while the round runs, because a finished round would leave it empty in every row. #}
        <thead><tr><th>Role</th><th>Model</th><th>Outcome</th><th class="num">Findings</th>{% if running %}<th>Stop</th>{% endif %}</tr></thead>
        <tbody id="round-{{ reviewed.round }}-reviewers">
        {% for outcome in reviewed.outcomes %}
            {% set progress = outcome.progress.name %}
            <tr>
                <td>{{ outcome.role }}</td>
                {# A start written before Intakt recorded the model has none, so its tier fills the cell instead. #}
                <td>{{ outcome.model ?? (outcome.tier ~ ' tier, model not recorded') }}</td>
                <td id="round-{{ reviewed.round }}-reviewer-{{ outcome.id }}-state"><span class="reviewer-outcome{{ progress == 'Failed' ? ' failed' }}">
                    {%- if progress == 'Running' %}<span class="dot ok"></span>running
                    {%- elseif progress == 'Answered' %}{{ include('dashboard/components/icon.html.twig', {name: 'check', small: true, extra: 'ok'}, with_context = false) }}{{ outcome.decision }}
                    {%- elseif progress == 'Failed' %}<span class="dot broken"></span>failed{% if outcome.note is not empty %}: {{ outcome.note }}{% endif %}
                    {%- elseif progress == 'Blocked' %}blocked{% if outcome.note is not empty %}: {{ outcome.note }}{% endif %}
                    {%- else %}stopped{% endif -%}
                </span>{% if outcome.substitute is not null %}; answered by the substitute {{ outcome.substitute }}, a catch-up review is owed{% endif %}</td>
                <td class="num">{% if outcome.findings is not null %}{{ outcome.findings }} {{ include(kind_label, {kind: kinds.Counted, at: 'round-' ~ reviewed.round ~ '-reviewer-' ~ outcome.id}, with_context = false) }}{% elseif progress == 'Running' %}no answer yet{% else %}no answer{% endif %}</td>
                {% if running %}
                <td id="round-{{ reviewed.round }}-reviewer-{{ outcome.id }}-stop">{% if progress == 'Running' %}<form method="post" action="{{ path(constant('Intakt\\Core\\Dashboard\\Contract\\DashboardRoutes::STOP_REVIEW'), {round: reviewed.round, reviewer: outcome.id}) }}" class="stop-reviewer">
                    <input type="hidden" name="_token" value="{{ csrf_token(constant('Intakt\\Core\\Dashboard\\UseCase\\StopReview\\StopReviewController::TOKEN_ID')) }}">
                    {{ include('dashboard/components/button.html.twig', {kind: 'danger', small: true, type: 'submit', label: 'Stop this reviewer', confirm: 'Click again to stop'}, with_context = false) }}
                </form>{% endif %}</td>
                {% endif %}
            </tr>
        {% endfor %}
        </tbody>
    </table>
    </div>
    {% endif %}

    <h3>Findings and the judge's call</h3>
    {% if reviewed.state.name != 'Judged' %}
    <p class="muted">The judge has not judged this round yet.</p>
    {% elseif reviewed.findings is empty and reviewed.findingTextRecorded %}
    <p class="muted">The reviewers reported no findings, so the judge had nothing to mark.</p>
    {% elseif reviewed.findings is empty %}
    <p class="muted">This round's findings were not recorded, because it was judged before Intakt kept them, and the judge marked none to act on or follow up.</p>
    {% else %}
    {% if not reviewed.findingTextRecorded %}
    <p class="muted">This round's findings were not recorded, because it was judged before Intakt kept them; only the ids the judge marked are shown.</p>
    {% endif %}
    <div class="table-scroll" tabindex="0" role="region" aria-label="Findings of round {{ reviewed.round }}">
    <table class="ledger findings">
        <thead><tr><th>Id</th><th>Severity</th><th>Finding</th><th>Judge's call</th></tr></thead>
        <tbody>
        {% for finding in reviewed.findings %}
            <tr>
                <td class="mono" id="round-{{ reviewed.round }}-finding-{{ finding.id }}" data-finding="{{ finding.ids|join(' ') }}">{{ finding.entryId }}</td>
                <td>{{ finding.severity ?? 'not recorded' }}</td>
                <td>{{ finding.text ?? 'not recorded' }}</td>
                <td>{{ finding.callInWords }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    </div>
    {% endif %}

    <h3>Tokens and cost</h3>
    <div class="table-scroll" tabindex="0" role="region" aria-label="Tokens and cost of round {{ reviewed.round }}">
    <table class="ledger tokens">
        <thead><tr><th class="num">Prompt</th><th class="num">Cache read</th><th class="num">Cache write</th><th class="num">Cached</th><th class="num">Completion</th><th class="num">Total</th><th>Cost</th></tr></thead>
        <tbody>
            <tr>
                {% for tokens in [reviewed.tokens.prompt, reviewed.tokens.cacheRead, reviewed.tokens.cacheWrite, reviewed.tokens.cached, reviewed.tokens.completion, reviewed.tokens.total] %}
                <td class="num">{{ tokens }} {{ include(kind_label, {kind: kinds.Measured, at: 'round-' ~ reviewed.round ~ '-tokens-' ~ loop.index}, with_context = false) }}</td>
                {% endfor %}
                <td>{{ include('dashboard/components/cost.html.twig', {cost: reviewed.cost, at: 'round-' ~ reviewed.round ~ '-cost'}, with_context = false) }}</td>
            </tr>
        </tbody>
    </table>
    </div>
