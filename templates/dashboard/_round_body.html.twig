    {{ include('dashboard/components/meta.html.twig', {facts: [
        {text: reviewed.round, mono: true},
        {icon: 'clock', text: 'Started ' ~ reviewed.startedAt|date('Y-m-d H:i:s', 'UTC') ~ ' UTC'},
    ]}, with_context = false) }}

    {% set unfinished = reviewed.state.name != 'Judged' %}
    <p id="round-{{ reviewed.round }}-state">{% if not unfinished %}Judged.{% else %}{{ reviewed.outcomes|filter(o => o.progress.name != 'Running')|length }} of {{ reviewed.reviewers }} reviewers finished.{% endif %}</p>
    {% if not unfinished %}
    {% set failed = reviewed.failedReviewers %}
    <p class="outcome" id="round-{{ reviewed.round }}-outcome">{% if reviewed.outcome is not null %}Outcome: {{ reviewed.outcome.value }}, decided by the quorum policy {{ reviewed.quorum.value }} over all {{ reviewed.reviewers }} reviewers.{% if failed > 0 %} {{ failed }} of {{ reviewed.reviewers }} reviewers failed, and a failed reviewer gives no approval.{% endif %}{% else %}No outcome shown: this round was started before Intakt recorded its quorum policy.{% endif %}</p>
    {% endif %}

    <h3>Reviewers</h3>
    <p class="muted">{{ reviewed.outcomes|length }} of {{ reviewed.reviewers }} reviewers started.</p>
    {% if reviewed.outcomes is not empty %}
    <div class="table-scroll" tabindex="0" role="region" aria-label="Reviewers of round {{ reviewed.round }}">
    <table class="ledger reviewers">
        <thead><tr><th>Role</th><th>Tier</th><th>State</th><th>Verdict</th><th class="num">Findings</th><th>Note</th><th>Stop</th></tr></thead>
        <tbody>
        {% for outcome in reviewed.outcomes %}
            <tr>
                <td>{{ outcome.role }}</td>
                <td>{{ outcome.tier }}</td>
                <td id="round-{{ reviewed.round }}-reviewer-{{ outcome.id }}-state">{{ outcome.progress.value }}</td>
                <td>{{ outcome.decision ?? '' }}{% if outcome.decision is not null and outcome.mode.name == 'Shadow' %} (shadow){% endif %}</td>
                <td class="num">{{ outcome.findings ?? '' }}</td>
                <td>{{ outcome.note ?? '' }}{% if outcome.note is not empty and outcome.substitute is not null %}; {% endif %}{% if outcome.substitute is not null %}answered by the substitute {{ outcome.substitute }}, a catch-up review is owed{% endif %}</td>
                <td id="round-{{ reviewed.round }}-reviewer-{{ outcome.id }}-stop">{% if unfinished and outcome.progress.name == 'Running' %}<form method="post" action="{{ path(constant('Intakt\\Core\\Dashboard\\Contract\\DashboardRoutes::STOP_REVIEW'), {round: reviewed.round, reviewer: outcome.id}) }}" class="stop-reviewer">
                    <input type="hidden" name="_token" value="{{ csrf_token(constant('Intakt\\Core\\Dashboard\\UseCase\\StopReview\\StopReviewController::TOKEN_ID')) }}">
                    {{ include('dashboard/components/button.html.twig', {kind: 'danger', small: true, type: 'submit', label: 'Stop this reviewer', confirm: 'Click again to stop'}, with_context = false) }}
                </form>{% endif %}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    </div>
    {% endif %}

    <h3>Findings and the judge's call</h3>
    {% if reviewed.state.name != 'Judged' %}
    <p class="muted">The judge has not judged this round yet.</p>
    {% elseif reviewed.findings is empty and reviewed.findingTextRecorded %}
    <p class="muted">The reviewers reported no findings, so the judge had nothing to mark.</p>
    {% elseif reviewed.findings is empty %}
    <p class="muted">This round's findings were not recorded, because it was judged before Intakt kept them, and the judge marked none to act on or follow up.</p>
    {% else %}
    {% if not reviewed.findingTextRecorded %}
    <p class="muted">This round's findings were not recorded, because it was judged before Intakt kept them; only the ids the judge marked are shown.</p>
    {% endif %}
    <div class="table-scroll" tabindex="0" role="region" aria-label="Findings of round {{ reviewed.round }}">
    <table class="ledger findings">
        <thead><tr><th>Id</th><th>Severity</th><th>Finding</th><th>Judge's call</th></tr></thead>
        <tbody>
        {% for finding in reviewed.findings %}
            <tr>
                <td class="mono" id="round-{{ reviewed.round }}-finding-{{ finding.id }}">{{ finding.id }}</td>
                <td>{{ finding.severity ?? 'not recorded' }}</td>
                <td>{{ finding.text ?? 'not recorded' }}</td>
                <td>{{ finding.call.value }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    </div>
    {% endif %}

    <h3>Tokens and cost</h3>
    <div class="table-scroll" tabindex="0" role="region" aria-label="Tokens and cost of round {{ reviewed.round }}">
    <table class="ledger tokens">
        <thead><tr><th class="num">Prompt</th><th class="num">Cache read</th><th class="num">Cache write</th><th class="num">Cached</th><th class="num">Completion</th><th class="num">Total</th><th>Cost</th></tr></thead>
        <tbody>
            <tr>
                <td class="num">{{ reviewed.tokens.prompt }}</td>
                <td class="num">{{ reviewed.tokens.cacheRead }}</td>
                <td class="num">{{ reviewed.tokens.cacheWrite }}</td>
                <td class="num">{{ reviewed.tokens.cached }}</td>
                <td class="num">{{ reviewed.tokens.completion }}</td>
                <td class="num">{{ reviewed.tokens.total }}</td>
                <td>{{ reviewed.cost.reading }}</td>
            </tr>
        </tbody>
    </table>
    </div>
