    {{ include('dashboard/components/meta.html.twig', {facts: [
        {text: reviewed.round, mono: true},
        {icon: 'clock', text: 'Started ' ~ reviewed.startedAt|date('Y-m-d H:i:s', 'UTC') ~ ' UTC'},
    ]}, with_context = false) }}

    {% set kinds = enum('Intakt\\Core\\Platform\\Contract\\FigureKind') %}
    {% set kind_label = 'dashboard/components/figure_kind.html.twig' %}
    {% set unfinished = reviewed.state.name != 'Judged' %}
    <p id="round-{{ reviewed.round }}-state">{% if not unfinished %}Judged.{% else %}{{ reviewed.outcomes|filter(o => o.progress.name != 'Running')|length }} of {{ reviewed.reviewers }} reviewers finished.{% endif %}</p>
    {% set running = unfinished and not reviewed.hasEnded %}
    {# Its own partial and always rendered, because the judged round's live update replaces it and a page opened before the judging needs the element. #}
    {{ include('dashboard/_round_verdict.html.twig', {reviewed: reviewed}, with_context = false) }}

    <h3>Reviewers</h3>
    <p class="muted">{{ reviewed.outcomes|length }} of {{ reviewed.reviewers }} reviewers started.</p>
    {# Shown while the round runs with no reviewer started too, because a reviewer that finishes after the page loaded is streamed into it. #}
    {% if reviewed.outcomes is not empty or running %}
    <div class="table-scroll" tabindex="0" role="region" aria-label="Reviewers of round {{ reviewed.round }}">
    <table class="ledger reviewers">
        <thead><tr><th>Role</th><th>Tier</th><th>State</th><th>Verdict</th><th class="num">Findings</th><th>Note</th><th>Stop</th></tr></thead>
        <tbody id="round-{{ reviewed.round }}-reviewers">
        {% for outcome in reviewed.outcomes %}
            <tr>
                <td>{{ outcome.role }}</td>
                <td>{{ outcome.tier }}</td>
                <td id="round-{{ reviewed.round }}-reviewer-{{ outcome.id }}-state">{{ outcome.progress.value }}</td>
                <td>{{ outcome.decision ?? '' }}</td>
                <td class="num">{% if outcome.findings is not null %}{{ outcome.findings }} {{ include(kind_label, {kind: kinds.Counted, at: 'round-' ~ reviewed.round ~ '-reviewer-' ~ outcome.id}, with_context = false) }}{% endif %}</td>
                <td>{{ outcome.note ?? '' }}{% if outcome.note is not empty and outcome.substitute is not null %}; {% endif %}{% if outcome.substitute is not null %}answered by the substitute {{ outcome.substitute }}, a catch-up review is owed{% endif %}</td>
                <td id="round-{{ reviewed.round }}-reviewer-{{ outcome.id }}-stop">{% if running and outcome.progress.name == 'Running' %}<form method="post" action="{{ path(constant('Intakt\\Core\\Dashboard\\Contract\\DashboardRoutes::STOP_REVIEW'), {round: reviewed.round, reviewer: outcome.id}) }}" class="stop-reviewer">
                    <input type="hidden" name="_token" value="{{ csrf_token(constant('Intakt\\Core\\Dashboard\\UseCase\\StopReview\\StopReviewController::TOKEN_ID')) }}">
                    {{ include('dashboard/components/button.html.twig', {kind: 'danger', small: true, type: 'submit', label: 'Stop this reviewer', confirm: 'Click again to stop'}, with_context = false) }}
                </form>{% endif %}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    </div>
    {% endif %}

    <h3>Findings and the judge's call</h3>
    {# Its own partial, because the judged round's live update replaces it with the same markup a reload renders. #}
    {{ include('dashboard/_judged_round.html.twig', {reviewed: reviewed}, with_context = false) }}

    <h3>Tokens and cost</h3>
    <div class="table-scroll" tabindex="0" role="region" aria-label="Tokens and cost of round {{ reviewed.round }}">
    <table class="ledger tokens">
        <thead><tr><th class="num">Prompt</th><th class="num">Cache read</th><th class="num">Cache write</th><th class="num">Cached</th><th class="num">Completion</th><th class="num">Total</th><th>Cost</th></tr></thead>
        <tbody>
            <tr>
                {% for tokens in [reviewed.tokens.prompt, reviewed.tokens.cacheRead, reviewed.tokens.cacheWrite, reviewed.tokens.cached, reviewed.tokens.completion, reviewed.tokens.total] %}
                <td class="num">{{ tokens }} {{ include(kind_label, {kind: kinds.Measured, at: 'round-' ~ reviewed.round ~ '-tokens-' ~ loop.index}, with_context = false) }}</td>
                {% endfor %}
                <td>{{ include('dashboard/components/cost.html.twig', {cost: reviewed.cost, at: 'round-' ~ reviewed.round ~ '-cost'}, with_context = false) }}</td>
            </tr>
        </tbody>
    </table>
    </div>
