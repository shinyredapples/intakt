{# One home for the markup of the review's tokens and cost: the page includes them and the judged round's live update replaces them, each by the id the macro gives it. #}
{% macro tokens(total) -%}
<span id="review-summary-tokens">{{ total.total|number_format(0, '.', ',') }} tokens {{ include('dashboard/components/figure_kind.html.twig', {kind: enum('Intakt\\Core\\Platform\\Contract\\FigureKind').Measured, at: 'summary-tokens'}, with_context = false) }}</span>
{%- endmacro %}

{% macro cost(cost) -%}
<span id="review-summary-cost">Cost: {{ include('dashboard/components/cost.html.twig', {cost: cost, at: 'summary-cost'}, with_context = false) }}</span>
{%- endmacro %}

{% macro round_tokens(reviewed) -%}
    {% set kinds = enum('Intakt\\Core\\Platform\\Contract\\FigureKind') %}
    <div class="table-scroll" id="round-{{ reviewed.round }}-tokens" tabindex="0" role="region" aria-label="Tokens and cost of round {{ reviewed.round }}">
    <table class="ledger tokens">
        <thead><tr><th class="num">Prompt</th><th class="num">Cache read</th><th class="num">Cache write</th><th class="num">Cached</th><th class="num">Completion</th><th class="num">Total</th><th>Cost</th></tr></thead>
        <tbody>
            <tr>
                {% for tokens in [reviewed.tokens.prompt, reviewed.tokens.cacheRead, reviewed.tokens.cacheWrite, reviewed.tokens.cached, reviewed.tokens.completion, reviewed.tokens.total] %}
                <td class="num">{{ tokens }} {{ include('dashboard/components/figure_kind.html.twig', {kind: kinds.Measured, at: 'round-' ~ reviewed.round ~ '-tokens-' ~ loop.index}, with_context = false) }}</td>
                {% endfor %}
                <td>{{ include('dashboard/components/cost.html.twig', {cost: reviewed.cost, at: 'round-' ~ reviewed.round ~ '-cost'}, with_context = false) }}</td>
            </tr>
        </tbody>
    </table>
    </div>
{%- endmacro %}
