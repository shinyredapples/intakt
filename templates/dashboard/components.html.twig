{# Every shared component of docs/design/mocks/components.html, each section in both themes side by side. #}
{% extends 'dashboard/base.html.twig' %}
{% set c = 'dashboard/components/' %}

{% block title %}Components - Intakt{% endblock %}
{% block importmap %}{{ importmap('app') }}{% endblock %}

{% block body %}
{% set themes = ['light', 'dark'] %}
<div class="page-head">
    <div><h1>Components</h1><p class="lead">Every component in every state, light and dark side by side. Builders copy from here; DESIGN.md has the rules.</p></div>
    <div class="actions"><button class="btn secondary sm" type="button" data-theme-toggle>Switch theme</button></div>
</div>
<nav class="comp-nav" aria-label="Sections">
    <a href="#c-buttons">Buttons</a><a href="#c-chips">Chips and badges</a><a href="#c-cards">Cards</a><a href="#c-rows">List rows</a><a href="#c-settings">Setting rows</a><a href="#c-inputs">Inputs</a><a href="#c-bars">Bars</a><a href="#c-charts">Charts</a><a href="#c-banners">Banners</a><a href="#c-tabs">Tabs</a><a href="#c-search">Search</a><a href="#c-toast">Toasts</a><a href="#c-empty">Empty, loading, error</a><a href="#c-characters">Characters</a>
</nav>

<section class="comp-sec" id="c-buttons"><h2>Buttons</h2><p>Primary for the main action, secondary for others, quiet for links, danger arms on first click, needs (amber) only for the one action a waiting item asks for.</p>
<div class="spec-cols">{% for theme in themes %}<div class="spec" data-theme="{{ theme }}"><h3>{{ theme|capitalize }}</h3>
    <div class="cgrp"><h4>Primary</h4><div class="row-st">{{ include(c ~ 'button.html.twig', {kind: 'primary', label: 'Default'}) }}{{ include(c ~ 'button.html.twig', {kind: 'primary', label: 'Hover', forced: 'hover'}) }}{{ include(c ~ 'button.html.twig', {kind: 'primary', label: 'Focus', forced: 'focus'}) }}{{ include(c ~ 'button.html.twig', {kind: 'primary', label: 'Active', forced: 'active'}) }}{{ include(c ~ 'button.html.twig', {kind: 'primary', label: 'Disabled', disabled: true}) }}{{ include(c ~ 'button.html.twig', {kind: 'primary', label: 'Saving…', busy: true}) }}</div></div>
    <div class="cgrp"><h4>Secondary</h4><div class="row-st">{{ include(c ~ 'button.html.twig', {kind: 'secondary', label: 'Default'}) }}{{ include(c ~ 'button.html.twig', {kind: 'secondary', label: 'Hover', forced: 'hover'}) }}{{ include(c ~ 'button.html.twig', {kind: 'secondary', label: 'Focus', forced: 'focus'}) }}{{ include(c ~ 'button.html.twig', {kind: 'secondary', label: 'Active', forced: 'active'}) }}{{ include(c ~ 'button.html.twig', {kind: 'secondary', label: 'Disabled', disabled: true}) }}{{ include(c ~ 'button.html.twig', {kind: 'secondary', label: 'Testing…', busy: true}) }}</div></div>
    <div class="cgrp"><h4>Quiet</h4><div class="row-st">{{ include(c ~ 'button.html.twig', {kind: 'quiet', label: 'Default'}) }}{{ include(c ~ 'button.html.twig', {kind: 'quiet', label: 'Hover', forced: 'hover'}) }}{{ include(c ~ 'button.html.twig', {kind: 'quiet', label: 'Focus', forced: 'focus'}) }}{{ include(c ~ 'button.html.twig', {kind: 'quiet', label: 'Disabled', disabled: true}) }}</div></div>
    <div class="cgrp"><h4>Danger</h4><div class="row-st">{{ include(c ~ 'button.html.twig', {kind: 'danger', label: 'Pause everything', confirm: 'Click again to pause'}) }}{{ include(c ~ 'button.html.twig', {kind: 'danger', label: 'Hover', confirm: 'Click again', forced: 'hover'}) }}{{ include(c ~ 'button.html.twig', {kind: 'danger', label: 'Disabled', confirm: 'Click again', disabled: true}) }}</div></div>
    <div class="cgrp"><h4>Needs you</h4><div class="row-st">{{ include(c ~ 'button.html.twig', {kind: 'needs', label: 'Approve a3f9c21'}) }}{{ include(c ~ 'button.html.twig', {kind: 'needs', label: 'Hover', forced: 'hover'}) }}{{ include(c ~ 'button.html.twig', {kind: 'needs', label: 'Focus', forced: 'focus'}) }}{{ include(c ~ 'button.html.twig', {kind: 'needs', label: 'Disabled', disabled: true}) }}{{ include(c ~ 'button.html.twig', {kind: 'needs', label: 'Approving…', busy: true}) }}</div></div>
    <div class="cgrp"><h4>Small and icon</h4><div class="row-st">{{ include(c ~ 'button.html.twig', {kind: 'secondary', label: 'Small', small: true}) }}{{ include(c ~ 'icon_button.html.twig', {label: 'Theme', icon: 'moon'}) }}{{ include(c ~ 'icon_button.html.twig', {label: 'Theme, focus', icon: 'moon', forced: 'focus'}) }}</div></div>
</div>{% endfor %}</div></section>

<section class="comp-sec" id="c-chips"><h2>Chips and badges</h2><p>Chips only for states and reasons. Plain facts use the meta line.</p>
<div class="spec-cols">{% for theme in themes %}<div class="spec" data-theme="{{ theme }}"><h3>{{ theme|capitalize }}</h3>
    <div class="cgrp"><h4>State and reason</h4><div class="row-st">{{ include(c ~ 'chip.html.twig', {label: 'In review, round 2', dot: 'ok', on_page: true}) }}{{ include(c ~ 'chip.html.twig', {label: 'Paused', icon: 'pause', on_page: true}) }}{{ include(c ~ 'chip.html.twig', {label: 'CI broken', icon: 'broken', broken: true, on_page: true}) }}{{ include(c ~ 'chip.html.twig', {label: 'Login expired', dot: 'needs', on_page: true}) }}</div>
    <div class="row-st">{{ include(c ~ 'reason_badge.html.twig', {reason: 'budget'}) }}{{ include(c ~ 'reason_badge.html.twig', {reason: 'overlap'}) }}{{ include(c ~ 'reason_badge.html.twig', {reason: 'dependency', label: 'Needs #612'}) }}{{ include(c ~ 'reason_badge.html.twig', {reason: 'ci', on_page: true}) }}</div></div>
    <div class="cgrp"><h4>Review outcome</h4><p>One word for how a review ended. Green only for Approved, red only for Failed; the check mark is Approved's alone.</p><div class="row-st outcomes">{% for outcome in enum_cases('Intakt\\Core\\Dashboard\\Domain\\ReviewOutcome') %}{{ include(c ~ 'outcome_chip.html.twig', {outcome: outcome, on_page: true}) }}{% endfor %}</div></div>
    <div class="cgrp"><h4>Counts and dots</h4><div class="row-st">{{ include(c ~ 'count.html.twig', {n: 3}) }}{{ include(c ~ 'count.html.twig', {n: 4, needs: true}) }}<span class="dot ok"></span><span class="dot needs"></span><span class="dot broken"></span><span class="dot idle"></span></div></div>
    <div class="cgrp"><h4>Meta line</h4>{{ include(c ~ 'meta.html.twig', {facts: [{icon: 'clock', text: '42 min', elapsed: true}, {text: 'Slot 1, Model L'}, {text: 'Round 2'}, {text: '9b3e5aa', mono: true}, {text: 'Size M'}, {text: '$3.18'}]}) }}</div>
    {% set kinds = enum('Intakt\\Core\\Platform\\Contract\\FigureKind') %}
    <div class="cgrp"><h4>Figure kind with its source</h4><p>1300 tokens {{ include(c ~ 'figure_kind.html.twig', {kind: kinds.Measured, at: 'sample-tokens-' ~ theme}) }}, 2 rounds {{ include(c ~ 'figure_kind.html.twig', {kind: kinds.Counted, at: 'sample-rounds-' ~ theme}) }}, 0.0459 USD {{ include(c ~ 'figure_kind.html.twig', {kind: kinds.Estimated, at: 'sample-cost-' ~ theme}) }}.</p></div>
    <div class="cgrp"><h4>Term with its standard explanation</h4><p>Approve this {{ include(c ~ 'term.html.twig', {term: 'version', words: 'version'}) }}, a {{ include(c ~ 'term.html.twig', {term: 'protected', words: 'protected file'}) }}, the {{ include(c ~ 'term.html.twig', {term: 'share', words: 'weekly share'}) }}.</p></div>
</div>{% endfor %}</div></section>

<section class="comp-sec" id="c-cards"><h2>Cards</h2><p>Flat tint, no border. Needs-you cards are the only amber ones. A blocker line sits right under the title.</p>
<div class="spec-cols">{% for theme in themes %}<div class="spec" data-theme="{{ theme }}"><h3>{{ theme|capitalize }}</h3>
    <div class="cards-row">
        {{ include(c ~ 'card.html.twig', {href: '#', number: 612, project: 'intakt', title: 'Command overlay for tasks and settings', meta: [{icon: 'clock', text: '42 min'}, {text: 'Slot 1, Model L'}, {text: 'Size M'}, {text: '$3.18'}]}) }}
        {{ include(c ~ 'card.html.twig', {href: '#', number: 612, project: 'intakt', title: 'Hover', forced: 'hover', meta: [{icon: 'clock', text: '42 min'}, {text: 'Size M'}]}) }}
        {{ include(c ~ 'card.html.twig', {href: '#', number: 589, project: 'intakt', title: 'Rotate the forge token without a restart', ask: 'Approve this version: secrets limit, ForgeTokenStore.php changed', meta: [{icon: 'clock', text: '1 h 05 min'}, {text: 'Round 2'}]}) }}
        {{ include(c ~ 'card.html.twig', {href: '#', number: 626, project: 'intakt', title: 'Search settings by their label', forced: 'focus', emphasis: {icon: 'link', text: 'Needs #612 merged first'}, meta: [{icon: 'clock', text: '9 h'}, {text: 'Size S'}]}) }}
        {{ include(c ~ 'card.html.twig', {href: '#', number: 205, project: 'acme-shop', title: 'Refund emails include the order number', emphasis: {icon: 'broken', text: 'Waiting for CI: image build failing', broken: true}, meta: [{icon: 'clock', text: '1 h 50 min'}]}) }}
        {{ include(c ~ 'card.html.twig', {href: '#', number: 74, project: 'field-notes', title: 'Strip photo location data before upload', emphasis: {icon: 'pause', text: 'Project paused'}, meta: [{icon: 'clock', text: '2 d'}]}) }}
    </div>
</div>{% endfor %}</div></section>

<section class="comp-sec" id="c-rows"><h2>List rows</h2><p>Hairline between rows, no box.</p>
<div class="spec-cols">{% for theme in themes %}<div class="spec" data-theme="{{ theme }}"><h3>{{ theme|capitalize }}</h3>
    <div class="list">
        {% embed c ~ 'list_row.html.twig' with {title: 'Phone (home)', explanation: 'Gets a push when something needs you.'} %}{% block actions %}<button class="btn quiet sm" type="button">Remove</button>{% endblock %}{% endembed %}
        {% embed c ~ 'list_row.html.twig' with {title: 'Laptop', explanation: 'Gets a push only during working hours.'} %}{% block actions %}<button class="btn quiet sm" type="button">Remove</button>{% endblock %}{% endembed %}
    </div>
</div>{% endfor %}</div></section>

<section class="comp-sec" id="c-settings"><h2>Setting rows</h2><p>Label, one-line explanation, control. State sits left of the control.</p>
<div class="spec-cols">{% for theme in themes %}<div class="spec" data-theme="{{ theme }}"><h3>{{ theme|capitalize }}</h3>
    {% embed c ~ 'setting_row.html.twig' with {label: 'Default', explanation: 'Lets phones on your home network open the dashboard.', control_id: 'set-default-' ~ theme} %}{% block control %}{{ include(c ~ 'switch.html.twig', {id: control_id, name: 'default', on: true}) }}{% endblock %}{% endembed %}
    {% embed c ~ 'setting_row.html.twig' with {label: 'Saving', explanation: 'Shown while the change is on its way.', control_id: 'set-saving-' ~ theme, state: 'saving'} %}{% block control %}{{ include(c ~ 'switch.html.twig', {id: control_id, name: 'saving', on: true}) }}{% endblock %}{% endembed %}
    {% embed c ~ 'setting_row.html.twig' with {label: 'Saved', explanation: 'Stays until the next change.', control_id: 'set-saved-' ~ theme, state: 'saved'} %}{% block control %}{{ include(c ~ 'switch.html.twig', {id: control_id, name: 'saved'}) }}{% endblock %}{% endembed %}
    {% embed c ~ 'setting_row.html.twig' with {label: 'Failed', explanation: 'Names the value still in force.', control_id: 'set-failed-' ~ theme, state: 'failed', still: '22:00 to 07:00'} %}{% block control %}{{ include(c ~ 'select.html.twig', {id: control_id, name: 'failed', selected: 'b', options: [{value: 'a', label: '22:00 to 07:00'}, {value: 'b', label: '23:00 to 08:00'}]}) }}{% endblock %}{% endembed %}
    {% embed c ~ 'setting_row.html.twig' with {label: 'Disabled', explanation: 'Explain why next to it: set by the project.', control_id: 'set-disabled-' ~ theme} %}{% block control %}{{ include(c ~ 'switch.html.twig', {id: control_id, name: 'disabled', disabled: true}) }}{% endblock %}{% endembed %}
</div>{% endfor %}</div></section>

<section class="comp-sec" id="c-inputs"><h2>Inputs</h2>
<div class="spec-cols">{% for theme in themes %}<div class="spec" data-theme="{{ theme }}"><h3>{{ theme|capitalize }}</h3>
    <div class="row-st">{{ include(c ~ 'input.html.twig', {id: 'in-default-' ~ theme, name: 'default', value: 'Default', aria_label: 'Default'}) }}{{ include(c ~ 'input.html.twig', {id: 'in-focus-' ~ theme, name: 'focus', value: 'Focus', aria_label: 'Focus', forced: 'focus'}) }}{{ include(c ~ 'input.html.twig', {id: 'in-disabled-' ~ theme, name: 'disabled', value: 'Disabled', aria_label: 'Disabled', disabled: true}) }}</div>
    <div class="row-st">{{ include(c ~ 'input.html.twig', {id: 'in-error-' ~ theme, name: 'error', value: '80', aria_label: 'Error', error: 'Use a port from 1024 to 65535.'}) }}</div>
    <div class="row-st">{{ include(c ~ 'select.html.twig', {id: 'in-select-' ~ theme, name: 'select', aria_label: 'Select', selected: 'a', options: [{value: 'a', label: 'Europe/Berlin'}]}) }}{{ include(c ~ 'stepper.html.twig', {label: 'Stepper', value: 2}) }}{{ include(c ~ 'switch.html.twig', {id: 'in-on-' ~ theme, name: 'on', aria_label: 'On', on: true}) }}{{ include(c ~ 'switch.html.twig', {id: 'in-off-' ~ theme, name: 'off', aria_label: 'Off'}) }}</div>
    {{ include(c ~ 'copy.html.twig', {text: 'intakt account login home'}) }}
</div>{% endfor %}</div></section>

<section class="comp-sec" id="c-bars"><h2>Bars</h2>
<div class="spec-cols">{% for theme in themes %}<div class="spec" data-theme="{{ theme }}"><h3>{{ theme|capitalize }}</h3>
    {{ include(c ~ 'bar.html.twig', {label: 'Used, reserved, forecast', note: 'Resets at 14:00', used: 46, reserved: 12, forecast: 18}) }}
    {{ include(c ~ 'bar.html.twig', {label: 'Full', note: 'Share used up', used: 100}) }}
    {{ include(c ~ 'bar.html.twig', {label: 'Last known', note: 'Unknown until logged in', used: 22, last_known: true}) }}
    {{ include(c ~ 'bar_legend.html.twig') }}
</div>{% endfor %}</div></section>

{#- Sample figures, as plain hashes the bar chart reads like ChartBar, so the chart is shown without data from the ledger. -#}
{% set sample_bars = [
    {label: 'P1', value: 3, reading: '3 P1 findings', detail: 'Security reviewer, 2 found by it alone', part: 2, inWords: '3 P1 findings, Security reviewer, 2 found by it alone'},
    {label: 'P2', value: 5, reading: '5 P2 findings', detail: 'Security reviewer, 1 found by it alone', part: 1, inWords: '5 P2 findings, Security reviewer, 1 found by it alone'},
    {label: 'P3', value: 0, reading: '0 P3 findings', detail: 'Security reviewer, 0 found by it alone', part: 0, inWords: '0 P3 findings, Security reviewer, 0 found by it alone'},
] %}
<section class="comp-sec" id="c-charts"><h2>Charts</h2><p>Server-drawn SVG in one hue, a hairline grid and a direct label on every bar; the solid part of a bar is its share, the lighter rest its whole. Every bar takes keyboard focus and shows its value first in a tooltip. "Show as table" lists the same numbers. Missing data reads "No data", never zero.</p>
<div class="spec-cols">{% for theme in themes %}<div class="spec" data-theme="{{ theme }}"><h3>{{ theme|capitalize }}</h3>
    <div class="cgrp chart" data-controller="chart" data-action="keydown.esc@window->chart#dismiss"><h4>Bar chart</h4>
        <p class="takeaway">The security reviewer found the most P1 findings, 3, and 2 of them no other reviewer found.</p>
        {{ include(c ~ 'bar_chart.html.twig', {name: 'Sample findings of one reviewer by severity', bars: sample_bars, top: 6}, with_context = false) }}
        <details class="c-table"><summary>Show as table</summary><table>
            <thead><tr><th scope="col">Severity</th><th scope="col">Findings</th><th scope="col">Found by it alone</th></tr></thead>
            <tbody>{% for bar in sample_bars %}<tr><td>{{ bar.label }}</td><td>{{ bar.value }}</td><td>{{ bar.part }}</td></tr>{% endfor %}</tbody>
        </table></details>
        <div class="chart-tip" data-chart-target="tip" aria-hidden="true" hidden><strong></strong><span></span></div>
    </div>
    <div class="cgrp"><h4>No data</h4><p class="takeaway" data-no-data>No data</p><p class="chart-key muted">Fills in once a judged review records which reviewer reported each finding.</p></div>
</div>{% endfor %}</div></section>

<section class="comp-sec" id="c-banners"><h2>Banners</h2><p>Full on desktop; one line on phones that expands.</p>
<div class="spec-cols">{% for theme in themes %}<div class="spec" data-theme="{{ theme }}"><h3>{{ theme|capitalize }}</h3>
    {% embed c ~ 'banner.html.twig' with {icon: 'broken', broken: true, short: 'CI image build failing since 09:12', title: 'CI image build failing since 09:12.', text: 'acme-shop checks cannot run.'} %}{% block action %}<a class="btn quiet sm" href="#">Open health</a>{% endblock %}{% endembed %}
    {% embed c ~ 'banner.html.twig' with {icon: 'pause', short: 'field-notes is paused', title: 'field-notes is paused.', text: 'Nothing new starts.'} %}{% block action %}<button class="btn secondary sm" type="button">Resume</button>{% endblock %}{% endembed %}
    {% embed c ~ 'banner.html.twig' with {icon: 'broken', broken: true, compact: true, short: 'CI image build failing since 09:12', title: 'CI image build failing since 09:12.', text: 'acme-shop checks cannot run.'} %}{% block action %}<a class="btn quiet sm" href="#">Open health</a>{% endblock %}{% endembed %}
    {% embed c ~ 'banner.html.twig' with {icon: 'pause', compact: true, open: true, short: 'field-notes is paused', title: 'field-notes is paused.', text: 'You paused it on Monday. Nothing new starts.'} %}{% block action %}<button class="btn secondary sm" type="button">Resume</button>{% endblock %}{% endembed %}
    <div class="cgrp"><h4>Connection lost</h4>{{ include(c ~ 'connection.html.twig', {since: '11:12:04'}) }}{{ include(c ~ 'connection.html.twig', {since: '11:12:04', next: '3 s', unreachable: true}) }}<div class="row-st">{{ include(c ~ 'offline.html.twig') }}{{ include(c ~ 'button.html.twig', {kind: 'needs', label: 'Approve a3f9c21', disabled: true}) }}</div>{{ include(c ~ 'meta.html.twig', {facts: [{icon: 'clock', text: '42 min', frozen_at: '11:12'}, {text: 'Slot 1, Model L'}]}) }}</div>
</div>{% endfor %}</div></section>

<section class="comp-sec" id="c-tabs"><h2>Tabs</h2>
<div class="spec-cols">{% for theme in themes %}<div class="spec" data-theme="{{ theme }}"><h3>{{ theme|capitalize }}</h3>
    {{ include(c ~ 'subtabs.html.twig', {label: 'Example ' ~ theme, tabs: [{label: 'Ledger', href: '#', current: true}, {label: 'Trends', href: '#'}, {label: 'Focus', href: '#', forced: 'focus'}]}) }}
    {{ include(c ~ 'segmented.html.twig', {label: 'Example view ' ~ theme, tabs: [{label: 'Timeline', selected: true}, {label: 'Live log'}]}) }}
    <div class="row-st">{{ include(c ~ 'filter_chip.html.twig', {label: '14 days', pressed: true}) }}{{ include(c ~ 'filter_chip.html.twig', {label: '8 weeks'}) }}</div>
</div>{% endfor %}</div></section>

<section class="comp-sec" id="c-search"><h2>Search</h2><p>Opaque panel over a scrim. Groups with an icon each; arrows move, Enter opens, Esc closes. Ctrl K or ⌘K opens it from any page.</p>
<div class="spec-cols">{% for theme in themes %}<div class="spec" data-theme="{{ theme }}"><h3>{{ theme|capitalize }}</h3>
    {# Shown in place: the overlay of the top bar is the same panel over the scrim. #}
    <div class="palette static"><div class="q">{{ include(c ~ 'icon.html.twig', {name: 'search'}) }}<input type="text" value="alpha" aria-label="Search, {{ theme }}" readonly><kbd>Esc</kbd></div>
    <div class="results" role="listbox" aria-label="Results, {{ theme }}">
        {{ include(c ~ 'search_group.html.twig', {id: 'search-reviews-' ~ theme, icon: 'pr', label: 'Reviews', results: [{label: 'sample-change, round 2', detail: 'alpha, in progress', href: '#', roundId: 'round-12', selected: true}, {label: 'sample-change, round 1', detail: 'alpha, judged', href: '#', roundId: 'round-11'}]}) }}
        {{ include(c ~ 'search_group.html.twig', {id: 'search-projects-' ~ theme, icon: 'projects', label: 'Projects', results: [{label: 'alpha', detail: 'Project, 2 review rounds', href: '#'}]}) }}
    </div></div>
    <div class="palette static"><div class="results">{{ include(c ~ 'search_none.html.twig', {query: 'zebra', suggestion: 'Try a project such as alpha, a round id, or a page such as Reviews.', recovery: constant('Intakt\\Core\\Dashboard\\Domain\\SearchAction::ClearSearch')}) }}</div></div>
</div>{% endfor %}</div></section>

<section class="comp-sec" id="c-toast"><h2>Toasts</h2><p>Shown in place here; on a page the toast hides itself after five seconds.</p>
<div class="spec-cols">{% for theme in themes %}<div class="spec" data-theme="{{ theme }}"><h3>{{ theme|capitalize }}</h3>
    {# Written out instead of included: the toast partial starts the controller that hides it, and this page must keep it on screen. #}
    <div class="row-st"><div class="toast" role="status"><span>Saved</span><button type="button">Undo</button></div></div>
    <div class="row-st"><div class="toast" role="status"><span>Test notification sent to Phone (home)</span></div></div>
</div>{% endfor %}</div></section>

<section class="comp-sec" id="c-empty"><h2>Empty, loading, error</h2><p>Empty states say what happens next. Loading uses static skeletons in place of content, never a whole-page spinner. Errors say what failed and what still holds.</p>
<div class="spec-cols">{% for theme in themes %}<div class="spec" data-theme="{{ theme }}"><h3>{{ theme|capitalize }}</h3>
    {{ include(c ~ 'empty.html.twig', {title: 'Nothing needs you', text: 'Intakt keeps building. When it needs a decision, it shows up here and on your phone.'}) }}
    <div class="cards-row">{{ include(c ~ 'skeleton.html.twig') }}{{ include(c ~ 'column_empty.html.twig', {text: 'Tasks appear here when Intakt takes in an issue'}) }}</div>
    {{ include(c ~ 'error_line.html.twig', {failed: "Couldn't connect.", text: 'The vendor said the key is not valid. Nothing was saved.'}) }}
</div>{% endfor %}</div></section>

<section class="comp-sec" id="c-characters"><h2>Characters</h2><p>Decoration only, always beside the text that names the actor: an empty alt, a fixed size, no motion. Each role is shown at 24 and 48 px; the octopus poses are for empty, idle and approved states, one per page.</p>
<div class="spec-cols">{% for theme in themes %}<div class="spec" data-theme="{{ theme }}"><h3>{{ theme|capitalize }}</h3>
    <div class="cgrp"><h4>Roles</h4>{% for character in enum_cases('Intakt\\Core\\Dashboard\\Domain\\Character') %}<div class="row-st"><span class="character-row">{{ include(c ~ 'character.html.twig', {character: character, size: 24}) }}{{ include(c ~ 'character.html.twig', {character: character, size: 48}) }}<span>{{ character.label }}: {{ character.description }}</span></span></div>{% endfor %}</div>
    <div class="cgrp"><h4>Octopus</h4><div class="row-st">{% for pose in enum_cases('Intakt\\Core\\Dashboard\\Domain\\MascotPose') %}<span class="character-row">{{ include(c ~ 'character.html.twig', {character: pose, size: 96}) }}<span>{{ pose.value|capitalize }}</span></span>{% endfor %}</div></div>
</div>{% endfor %}</div></section>
{% endblock %}
