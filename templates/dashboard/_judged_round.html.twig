<div id="round-{{ reviewed.round }}-judged">
    {% if reviewed.state.name != 'Judged' %}
    <p class="muted">The judge has not judged this round yet.</p>
    {% elseif reviewed.findings is empty and reviewed.dropped is empty and reviewed.findingTextRecorded %}
    <p class="muted">The reviewers reported no findings, so the judge had nothing to mark.</p>
    {% elseif reviewed.findings is empty and reviewed.dropped is empty %}
    <p class="muted">This round's findings were not recorded, because it was judged before Intakt kept them, and the judge marked none to act on or follow up.</p>
    {% else %}
    {% if not reviewed.findingTextRecorded %}
    <p class="muted">This round's findings were not recorded, because it was judged before Intakt kept them; only the ids the judge marked are shown.</p>
    {% endif %}
    {% if reviewed.findings is not empty %}
    <ul class="finding-cards" aria-label="Findings of round {{ reviewed.round }}">
        {% for finding in reviewed.findings %}
        <li class="finding-card" id="round-{{ reviewed.round }}-finding-{{ finding.id }}" data-finding="{{ finding.ids|join(' ') }}">
            <span class="sev">{{ finding.severity ?? 'Severity not recorded' }}</span>
            <div class="fc-body">
                <p class="fc-title"><span class="mono fc-id">{{ finding.id }}</span> <span class="fc-text">{{ include('dashboard/_finding_text.html.twig', {finding: finding, missing: 'Text not recorded.'}, with_context = false) }}</span></p>
                <p class="fc-place{% if finding.place is not null %} mono{% endif %}">{{ finding.place ?? 'File and line not recorded' }}</p>
                {% if finding.merged is not empty %}
                <p class="fc-merged">Also reported as <span class="mono">{{ finding.merged|join(', ') }}</span></p>
                {% endif %}
                <p class="fc-call">{{ finding.callInWords }}</p>
            </div>
        </li>
        {% endfor %}
    </ul>
    {% endif %}
    {% if reviewed.dropped is not empty %}
    <ul class="finding-cards" aria-label="Findings of round {{ reviewed.round }} dropped before the judge">
        {% for finding in reviewed.dropped %}
        <li class="finding-card" id="round-{{ reviewed.round }}-dropped-{{ finding.id }}" data-finding="{{ finding.id }}" data-dropped="{{ finding.id }}">
            <span class="sev">{{ finding.severity ?? 'Severity not recorded' }}</span>
            <div class="fc-body">
                <p class="fc-title"><span class="mono fc-id">{{ finding.id }}</span> <span class="fc-text">{{ include('dashboard/_finding_text.html.twig', {finding: finding, missing: 'Text not recorded.'}, with_context = false) }}</span></p>
                <p class="fc-place{% if finding.place is not null %} mono{% endif %}">{{ finding.place ?? 'File and line not recorded' }}</p>
                {#- Every dropped finding comes from the quote check, so the row names it in plain words and keeps the recorded reason behind the disclosure; the code at the reviewed head is not in the ledger, so the quotes are shown, not the lines near them. -#}
                <p class="fc-call">Quote not found in the code</p>
                <details class="fc-quotes">
                    <summary>Quoted code{{ include('dashboard/components/icon.html.twig', {name: 'chevron', small: true, extra: 'chev'}, with_context = false) }}</summary>
                    {% set quoted = finding.text is null ? [] : finding_spans(finding.text)|filter(span => span.code) %}
                    {% if quoted is not empty %}
                    <p class="fc-quoted">{% for span in quoted %}<code>{{ span.text }}</code>{% if not loop.last %} {% endif %}{% endfor %}</p>
                    {% endif %}
                    <p class="fc-reason">Dropped before the judge: {{ finding.droppedBecause }}. File names and numbers count neither way.</p>
                </details>
            </div>
        </li>
        {% endfor %}
    </ul>
    {% endif %}
    {% endif %}
</div>
