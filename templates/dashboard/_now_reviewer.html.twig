{#- One home for the Now block's reviewer row, because the page renders it on load and a stream appends it for a reviewer that started later. A panel reviewer is always the code reviewer, whatever its role (decision D2 of #2344). -#}
<li class="character-row">{{ include('dashboard/components/character.html.twig', {character: constant('Intakt\\Core\\Dashboard\\Domain\\Character::CodeReviewer'), size: 24}, with_context = false) }}<span>{% if outcome is not null %}<strong>{{ outcome.role }}</strong> ({{ include('dashboard/_now_reviewer_model.html.twig', {round: round, reviewer: reviewer, outcome: outcome}, with_context = false) }}){% else %}<strong>A reviewer</strong> (role not read){% endif %}: <span id="round-{{ round }}-now-reviewer-{{ reviewer }}-state">{{ include('dashboard/stream/_reviewer_outcome.html.twig', {state: state, outcome: outcome}, with_context = false) }}</span></span></li>
