{#- Segmented tabs that switch views inside one page: label names the tab list; tabs: list of {label, selected?}. -#}
<div class="seg" role="tablist" aria-label="{{ label }}">
    {%- for tab in tabs %}
    <button type="button" role="tab" aria-selected="{{ tab.selected|default(false) ? 'true' : 'false' }}">{{ tab.label }}</button>
    {%- endfor %}
</div>
