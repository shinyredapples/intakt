{# DESIGN.md, Charts: one hue, a hairline grid, a tooltip on hover and focus (value first), and the same points as a real table.
   A figure, not a labelled section: a chart is no landmark, and the components page shows each chart once per theme. #}
<figure class="chart" id="{{ id }}" aria-labelledby="{{ id }}-title" data-controller="chart" data-action="keydown.esc@window->chart#dismiss">
    <h3 id="{{ id }}-title">{{ chart.title }}</h3>
    <p class="takeaway">{{ chart.takeaway }}</p>
    <svg class="chart-svg" width="{{ chart.width }}" height="{{ chart.height }}" viewBox="0 0 {{ chart.width }} {{ chart.height }}" role="group" aria-labelledby="{{ id }}-title">
        {% for line in chart.gridLines %}
        <line class="{{ loop.first ? 'c-base' : 'c-grid' }}" x1="{{ chart.plotLeft }}" x2="{{ chart.plotRight }}" y1="{{ line.y }}" y2="{{ line.y }}"/>
        <text class="c-axis" x="{{ chart.plotLeft - 6 }}" y="{{ line.y + 4 }}" text-anchor="end" aria-hidden="true">{{ line.text }}</text>
        {% endfor %}
        {% for label in chart.axisLabels %}
        <text class="c-axis" x="{{ label.x }}" y="{{ chart.height - 6 }}" text-anchor="{{ label.anchor }}" aria-hidden="true">{{ label.text }}</text>
        {% endfor %}
        {% for bar in chart.bars %}
        {% if bar.outline is not null %}<path class="c-bar" d="{{ bar.outline }}"/>{% endif %}
        <rect class="c-hit" x="{{ bar.slotX }}" y="{{ chart.plotTop }}" width="{{ bar.slotWidth }}" height="{{ chart.plotHeight }}" tabindex="0" role="img" aria-label="{{ bar.point.label }}: {{ bar.point.reading }}" data-label="{{ bar.point.label }}" data-reading="{{ bar.point.reading }}" data-action="pointerenter->chart#pointerEnter pointerleave->chart#pointerLeave focus->chart#focusIn blur->chart#focusOut"/>
        {% endfor %}
    </svg>
    <div class="chart-tip" data-chart-target="tip" aria-hidden="true" hidden><strong data-chart-target="reading"></strong><span data-chart-target="label"></span></div>
    <details class="c-table">
        <summary>Show as table{{ include('dashboard/components/icon.html.twig', {name: 'chevron', small: true, extra: 'chev'}, with_context = false) }}</summary>
        <table>
            <thead><tr><th scope="col">{{ chart.rowHeading }}</th><th scope="col">{{ chart.valueHeading }}</th></tr></thead>
            <tbody>
            {% for point in chart.points %}
            <tr><th scope="row">{{ point.label }}</th><td>{{ point.reading }}</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </details>
</figure>
