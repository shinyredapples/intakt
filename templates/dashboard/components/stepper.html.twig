{#- label names the group, so its two buttons need only say which way they step. No script steps it yet: the page that keeps the number wires it. -#}
<div class="stepper" role="group" aria-label="{{ label }}"><button type="button" aria-label="Decrease">−</button><output>{{ value }}</output><button type="button" aria-label="Increase">+</button></div>
