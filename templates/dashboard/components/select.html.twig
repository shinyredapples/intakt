{#- options and selected: see _options.html.twig. aria_label names a select that has no visible label for it. -#}
<select class="select" id="{{ id }}" name="{{ name }}"{% if aria_label is defined %} aria-label="{{ aria_label }}"{% endif %}>
    {{- include('dashboard/components/_options.html.twig', {options: options, selected: selected|default('')}, with_context = false) }}
</select>
