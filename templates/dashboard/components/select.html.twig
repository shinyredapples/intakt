{#- options: list of {value, label}; the one whose value is selected is chosen. aria_label names a select that has no visible label for it. -#}
<select class="select" id="{{ id }}" name="{{ name }}"{% if aria_label is defined %} aria-label="{{ aria_label }}"{% endif %}>
    {%- for option in options %}
    <option value="{{ option.value }}"{% if option.value == selected|default(null) %} selected{% endif %}>{{ option.label }}</option>
    {%- endfor %}
</select>
