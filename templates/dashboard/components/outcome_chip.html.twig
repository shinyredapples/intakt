{#- A review's outcome (ReviewOutcome) as a chip: its icon and its words; green only for Approved, red only for Failed, the others neutral. -#}
{%- set outcomes = enum('Intakt\\Core\\Dashboard\\Domain\\ReviewOutcome') -%}
{{ include('dashboard/components/chip.html.twig', {
    icon: outcome.icon,
    label: outcome.value,
    broken: outcome is same as(outcomes.Failed),
    on_page: on_page|default(false),
}|merge(outcome is same as(outcomes.Approved) ? {extra: 'approved'} : {}), with_context = false) }}
