{#- text says what happens next; action, a link with href and label, is the one way on from here. pose, a MascotPose, adds that octopus above the title as decoration, because the words alone must still carry the state. -#}
<div class="empty">{% if pose is defined %}{{ include('dashboard/components/character.html.twig', {character: pose, size: 144}, with_context = false) }}{% endif %}<h2>{{ title }}</h2><p class="muted">{{ text }}</p>{% if action is defined %}<a class="btn primary" href="{{ action.href }}">{{ action.label }}</a>{% endif %}</div>
