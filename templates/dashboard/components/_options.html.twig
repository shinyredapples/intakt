{#- options: list of {value, label} with string values; the one whose value is the string selected is chosen, none when it is null. Compared strictly, because a loose comparison would also choose "01" and "1.0" for "1", and a browser shows the last of several selected options. -#}
{%- for option in options %}
<option value="{{ option.value }}"{% if option.value is same as(selected) %} selected{% endif %}>{{ option.label }}</option>
{%- endfor %}
