{#- used, reserved and forecast in percent of the track, laid end to end and cut at its end; labels beside the bar, never inside. last_known dims a value Intakt cannot read now and kept from its last reading. -#}
{%- set used = max(0, min(100, used)) -%}
{%- set reserved = max(0, min(100 - used, reserved|default(0))) -%}
{%- set forecast = max(0, min(100 - used - reserved, forecast|default(0))) -%}
{%- set last_known = last_known|default(false) -%}
<div class="window">
    <div class="wl"><strong>{{ label }}</strong><span class="reset">{{ note }}</span></div>
    <div class="bar{% if last_known %} last-known{% endif %}" role="img" aria-label="{{ last_known ? 'Last known: used' : 'Used' }} {{ used }}%, reserved {{ reserved }}%, forecast {{ forecast }}%">
        <i class="used" style="width: {{ used }}%"></i>
        {%- if reserved > 0 %}<i class="reserved" style="left: {{ used }}%; width: {{ reserved }}%"></i>{% endif %}
        {%- if forecast > 0 %}<i class="forecast" style="left: {{ used + reserved }}%; width: {{ forecast }}%"></i>{% endif %}
    </div>
</div>
