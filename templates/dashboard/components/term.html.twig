{#- A term that stays in the UI, with its one standard explanation (GlossaryTerm), shown on hover and focus. -#}
{%- set tip_id = 'term-' ~ term ~ '-' ~ random() -%}
<span class="term" tabindex="0" data-term="{{ term }}" aria-describedby="{{ tip_id }}">{{ words }}<span class="term-tip" role="tooltip" id="{{ tip_id }}">{{ glossary_explanation(term) }}</span></span>
