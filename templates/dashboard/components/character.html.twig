{#- A role's Character or an octopus MascotPose as decoration beside the text that names it: an empty alt, a fixed size, one image per theme. -#}
{%- set mascot = character in enum_cases('Intakt\\Core\\Dashboard\\Domain\\MascotPose') -%}
{%- for theme in ['light', 'dark'] -%}
{%- if mascot -%}
<img class="character character-{{ theme }}" src="{{ asset('images/mascot/octopus-' ~ character.value ~ '-' ~ theme ~ '.webp') }}" alt="" width="{{ size }}" height="{{ size }}" loading="lazy">
{%- else -%}
{%- set file = 'images/roles/' ~ character.value ~ '-' ~ theme ~ '-' -%}
<img class="character character-{{ theme }}" src="{{ asset(file ~ size * 2 ~ '.webp') }}" srcset="{{ asset(file ~ size * 2 ~ '.webp') }} 1x, {{ asset(file ~ size * 4 ~ '.webp') }} 2x" alt="" width="{{ size }}" height="{{ size }}" loading="lazy">
{%- endif -%}
{%- endfor -%}
