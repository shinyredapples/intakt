{#- tabs: list of {label, href, current?, forced?}; forced is hover, focus or active, for the components page. -#}
<nav class="subtabs" aria-label="{{ label }}">
    {%- for tab in tabs %}
    <a href="{{ tab.href }}"{% if tab.forced|default(null) %} class="is-{{ tab.forced }}"{% endif %}{% if tab.current|default(false) %} aria-current="page"{% endif %}>{{ tab.label }}</a>
    {%- endfor %}
</nav>
