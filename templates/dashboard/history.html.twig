{% extends 'dashboard/base.html.twig' %}

{% block title %}History - Intakt{% endblock %}

{% block body %}
<div class="page-head">
    <div>
        <h1>History</h1>
        <p class="lead">Every change made on the dashboard or by Intakt to how work runs, newest first.</p>
    </div>
</div>
{{ include('dashboard/_history_subtabs.html.twig', {current: 'ledger'}, with_context = false) }}
{% if history.rows is empty %}
<div id="history-empty">{{ include('dashboard/components/empty.html.twig', {title: 'No history yet', text: 'Nothing has been recorded yet.', pose: enum('Intakt\\Core\\Dashboard\\Domain\\MascotPose').Waiting}, with_context = false) }}</div>
{% endif %}
{# Rendered on an empty page too, hidden by the stylesheet while its table has no row, so the first pushed row has a table to go in. #}
<div class="history-ledger">
{# assets/history-filter.js narrows the rows by the pressed chip and the text, and on a phone, whose top bar has no project filter, by the toolbar's own project picker; the empty value is Everything. #}
<div class="filters" role="group" aria-label="Filter history" data-history-filter>
    <button class="fchip" type="button" aria-pressed="true" data-filter="">Everything</button>
    {% for choice in enum_cases('Intakt\\Core\\Dashboard\\Domain\\HistorySource')|merge(enum_cases('Intakt\\Core\\Dashboard\\Domain\\HistoryTopic')) %}
    <button class="fchip" type="button" aria-pressed="false" data-filter="{{ choice.value }}">{{ choice.filterLabel }}</button>
    {% endfor %}
    {{ include('dashboard/components/select.html.twig', {id: 'history-project', name: 'project', aria_label: 'Project', selected: linked_project ?? '', options: [{value: '', label: 'All projects'}]|merge(project_names|map(name => {value: name, label: name}))}, with_context = false) }}
    <label class="sr-only" for="history-text">Filter by text</label>
    <input class="input" id="history-text" type="search" placeholder="Filter by text">
</div>
<div class="table-scroll" tabindex="0" role="region" aria-label="History">
<table class="ledger history">
    <caption class="sr-only">History</caption>
    <thead><tr><th scope="col">When</th><th scope="col">Source</th><th scope="col">What</th><th scope="col">Change</th><th scope="col">Until</th></tr></thead>
    {#- Nothing between the tags while there is no row, so the stylesheet's :empty sees an empty table. -#}
    <tbody id="history-rows">{% for row in history.rows %}{{ include('dashboard/_history_row.html.twig', {row: row}, with_context = false) }}{% endfor %}</tbody>
</table>
</div>
<p class="muted history-none" role="status" data-none="No entries match. Clear the filter to see everything."></p>
</div>
{% endblock %}
