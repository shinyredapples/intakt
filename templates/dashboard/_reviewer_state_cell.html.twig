{# Its own partial, because a reviewer's live update replaces this cell with the same markup a reload renders. #}
{% set progress = outcome.progress.name %}
<td id="round-{{ round }}-reviewer-{{ outcome.id }}-state"><span class="reviewer-outcome{{ progress == 'Failed' ? ' failed' }}">
    {%- if progress == 'Running' %}<span class="dot ok"></span>running
    {%- elseif progress == 'Answered' %}{{ include('dashboard/components/icon.html.twig', {name: 'check', small: true, extra: 'ok'}, with_context = false) }}{{ outcome.decision }}
    {%- elseif progress == 'Failed' %}<span class="dot broken"></span>failed{% if outcome.note is not empty %}: {{ outcome.note }}{% endif %}
    {%- elseif progress == 'Blocked' %}blocked{% if outcome.note is not empty %}: {{ outcome.note }}{% endif %}
    {%- else %}stopped{% endif -%}
</span>{% if outcome.substitute is not null %}; answered by the substitute {{ outcome.substitute }}, a catch-up review is owed{% endif %}</td>
