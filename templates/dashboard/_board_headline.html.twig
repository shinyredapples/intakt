{#- The one home of the board's headline: the page includes it and the live stream replaces it, so both say the same thing. The counted form is an attribute, so the text of the line stays one sentence. -#}
{% if lead.fresh %}
<p class="lead" id="board-headline">{{ lead.text }}</p>
{% elseif lead.firstWaiting %}
<p class="lead" id="board-headline" data-counted="{{ lead.countedSentence }}"><span class="named">{{ lead.runningSentence }}</span> <span class="needs-you">{{ lead.waitingSentence }}</span> <a href="{{ path(constant('Intakt\\Core\\Dashboard\\Contract\\DashboardRoutes::SHOW_REVIEW'), {round: lead.firstWaiting.latest.round}) }}">see what</a>.</p>
{% else %}
<p class="lead" id="board-headline" data-counted="{{ lead.countedSentence }}"><span class="named">{{ lead.runningSentence }}</span> {{ lead.waitingSentence }}</p>
{% endif %}
