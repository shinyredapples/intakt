{% extends 'dashboard/base.html.twig' %}

{% block title %}Review {{ review.change ?: round }} - Intakt{% endblock %}

{% block content_width %} roomy{% endblock %}

{% block body %}
{% set total = review.tokens %}
{% set latest = review.rounds|last %}
{% set active = review.activeRound %}
{% set judged = review.lastJudgedRound %}
{% set open = review.openFindings %}
{% set can_start = review.source is not null and review.nextNumber is not null %}
{% set kinds = enum('Intakt\\Core\\Platform\\Contract\\FigureKind') %}
{% set kind_label = 'dashboard/components/figure_kind.html.twig' %}
{% set chip = 'dashboard/components/chip.html.twig' %}
{# Each round carries its own mark, because a replay round can follow a live round of the same change. #}
{% set replay_chip = {label: 'Replay', on_page: true, extra: 'replay-mark'} %}
<div class="page-head">
    <div>
        <h1>Review of {{ review.change ?: 'round ' ~ round }} in {{ review.project }}</h1>
        {% if review.everyRoundIsAReplay %}
        <p class="replay-mark">{{ include(chip, {label: 'Replay', on_page: true}, with_context = false) }} A recording played back: its verdicts were never given on this change and never count as one.</p>
        {% endif %}
        {{ include('dashboard/components/meta.html.twig', {facts: [
            {text: review.project},
            {text: review.change ?: 'round ' ~ round, mono: true},
            {icon: 'clock', text: 'Latest round started ' ~ latest.startedAt|date('Y-m-d H:i:s', 'UTC') ~ ' UTC'},
        ]}, with_context = false) }}
        <p class="lead summary">{{ review.rounds|length }} {{ review.rounds|length == 1 ? 'round' : 'rounds' }} {{ include(kind_label, {kind: kinds.Counted, at: 'summary-rounds'}, with_context = false) }}, {{ total.total }} tokens {{ include(kind_label, {kind: kinds.Measured, at: 'summary-tokens'}, with_context = false) }} in all. Cost: {{ include('dashboard/components/cost.html.twig', {cost: review.cost, at: 'summary-cost'}, with_context = false) }}.</p>
        {% if not can_start %}
        <p class="no-start muted">No button here: the latest round was started before Intakt recorded the repository, base and task it needs to start the next one.</p>
        {% endif %}
    </div>
    {% if can_start or active is not null %}
    <div class="actions task-actions">
        {% if active is not null %}
        {# Rendered while nothing runs too, hidden by the idle marker, because a stream cannot carry this session's token: a reviewer's first update removes the marker. #}
        <div id="round-{{ active.round }}-now-stop">{% if active.outcomes|filter(o => o.progress.name == 'Running')|length == 0 %}<span id="round-{{ active.round }}-now-stop-idle" class="now-stop-idle"></span>{% endif %}
            <form method="post" action="{{ path(constant('Intakt\\Core\\Dashboard\\Contract\\DashboardRoutes::STOP_ROUND'), {round: active.round}) }}" class="stop-round">
                <input type="hidden" name="_token" value="{{ csrf_token(constant('Intakt\\Core\\Dashboard\\UseCase\\StopReview\\StopRoundController::TOKEN_ID')) }}">
                {{ include('dashboard/components/button.html.twig', {kind: 'danger', type: 'submit', label: 'Stop', confirm: 'Click again to stop the round'}, with_context = false) }}
            </form>
        </div>
        {% endif %}
        {% if can_start %}
        <form method="post" action="{{ path(constant('Intakt\\Core\\Dashboard\\Contract\\DashboardRoutes::START_REVIEW'), {round: round}) }}" class="start-review">
            <input type="hidden" name="_token" value="{{ csrf_token(constant('Intakt\\Core\\Dashboard\\UseCase\\StartReview\\StartReviewController::TOKEN_ID')) }}">
            <input type="hidden" name="number" value="{{ review.nextNumber }}">
            {{ include('dashboard/components/button.html.twig', {kind: 'primary', type: 'submit', label: 'Start the next round on the current head'}, with_context = false) }}
        </form>
        {% endif %}
    </div>
    {% endif %}
</div>
{% if active is not null %}
<section class="state-block" aria-labelledby="state-block-title">
    <div class="sb-head">
        <h2 id="state-block-title">Now: round {{ active.number ?? '(number not recorded)' }} <span id="round-{{ active.round }}-now-phase">in review</span></h2>{% if active.isReplay %}{{ include(chip, replay_chip, with_context = false) }}{% endif %}    </div>
    <div class="sb-grid">
        <div>
            <h3>Reviewers</h3>
            <p class="muted" id="round-{{ active.round }}-now-progress">{{ active.outcomes|filter(o => o.progress.name != 'Running')|length }} of {{ active.reviewers }} reviewers finished.</p>
            <ul class="sb-list" id="round-{{ active.round }}-now-reviewers">
                {% for outcome in active.outcomes %}
                <li><span><strong>{{ outcome.role }}</strong> ({{ outcome.tier }}): <span id="round-{{ active.round }}-now-reviewer-{{ outcome.id }}-state">{{ outcome.progress.value }}</span>{% if outcome.decision is not null %}, {{ outcome.decision }}{% endif %}</span></li>
                {% else %}
                <li class="muted" id="round-{{ active.round }}-now-none">No reviewer has started yet.</li>
                {% endfor %}
            </ul>
        </div>
        <div>
            <h3>Open findings</h3>
            {% if open is empty %}
            <p class="muted">No finding is open.</p>
            {% else %}
            {% for finding in open %}
            <a class="sb-finding" href="#round-{{ judged.round }}-finding-{{ finding.id }}"><span class="sev">{{ finding.severity ?? '?' }}</span><span><span class="mono">{{ finding.entryId }}</span> {{ finding.text ?? 'Text not recorded.' }}</span></a>
            {% endfor %}
            {% endif %}
        </div>
        <div>
            <h3>The judge's call</h3>
            <p class="muted" id="round-{{ active.round }}-now-judge">The judge has not judged this round yet.</p>
        </div>
    </div>
</section>
{% endif %}
{% if active is not null %}
<div class="ttabs"><div class="seg" role="tablist" aria-label="Task views">
    <button type="button" role="tab" aria-selected="true" aria-controls="timeline-pane" data-pane="timeline">Timeline</button>
    <button type="button" role="tab" aria-selected="false" aria-controls="live-log-pane" data-pane="log">Live log</button>
</div></div>
{% endif %}
<div class="task-grid" data-pane="timeline">
<section class="tl-pane" id="timeline-pane" aria-labelledby="timeline-title">
<h2 class="timeline-title" id="timeline-title">Timeline</h2>
{% for reviewed in review.rounds %}
{% if reviewed.isJudged %}
<section class="section round" id="round-{{ reviewed.round }}">
    {# Only the newest round opens on arrival, because its verdict is what the reader came for and older rounds would push it down. A judged round followed by a round still in review stays closed, because only the newest round opens. #}
    <details class="ev"{% if loop.last %} open{% endif %}>
        <summary class="ev-head">
            <h2>Round {{ reviewed.number ?? '(number not recorded)' }}</h2>
            {% if reviewed.isReplay %}{{ include(chip, replay_chip, with_context = false) }}{% endif %}
            {{ include('dashboard/_round_state.html.twig', {state: reviewed.state}, with_context = false) }}
            {# A round judged before Intakt kept the findings holds only the judge's marks, so a count would pass them off as the reviewers' findings. That count stays unlabeled: it counts marks, not findings, and no figure is added here. #}
            <span class="muted small">{{ reviewed.outcome is not null ? reviewed.outcome.value : 'outcome not recorded' }}, {% if reviewed.findingTextRecorded %}{{ reviewed.findings|length }} {{ reviewed.findings|length == 1 ? 'finding' : 'findings' }} {{ include(kind_label, {kind: kinds.Counted, at: 'round-' ~ reviewed.round ~ '-findings'}, with_context = false) }}{% else %}findings not recorded{% if reviewed.findings is not empty %}, {{ reviewed.findings|length }} marked by the judge{% endif %}{% endif %}</span>
            {% set spanFormat = reviewed.startedAt|date('Y-m-d', 'UTC') == reviewed.judgedAt|date('Y-m-d', 'UTC') ? 'H:i' : 'Y-m-d H:i' %}
            <time>{{ reviewed.startedAt|date(spanFormat, 'UTC') }} to {{ reviewed.judgedAt|date(spanFormat, 'UTC') }} UTC</time>
            {{ include('dashboard/components/icon.html.twig', {name: 'chevron', small: true, extra: 'chev'}, with_context = false) }}
        </summary>
        {{ include('dashboard/_round_body.html.twig', {reviewed: reviewed}, with_context = false) }}
    </details>
</section>
{% else %}
<section class="section round" id="round-{{ reviewed.round }}">
    <div class="round-head">
        <h2>Round {{ reviewed.number ?? '(number not recorded)' }}</h2>
        {% if reviewed.isReplay %}{{ include(chip, replay_chip, with_context = false) }}{% endif %}
        {{ include('dashboard/_round_state.html.twig', {state: reviewed.state, ending: reviewed.ending}, with_context = false) }}
    </div>
    {% if reviewed.ending is not null %}
    <p class="muted round-ending" id="round-{{ reviewed.round }}-ending">Blocked: {{ reviewed.ending.reason }}</p>
    {% endif %}
    {{ include('dashboard/_round_body.html.twig', {reviewed: reviewed}, with_context = false) }}
</section>
{% endif %}
{% endfor %}
</section>
{% if active is not null %}
<aside class="log log-pane" id="live-log-pane" aria-labelledby="live-log-title">
    <h2 id="live-log-title">Live log of round {{ active.number ?? '(number not recorded)' }}</h2>
    <div class="log-main">
    {# Outside the streams' container, so a reviewer's first update cannot remove it; the stylesheet hides it once a reviewer is placed. #}
    <p class="muted log-empty">Each reviewer's tool calls and text appear here as it works.</p>
    <div class="live-reviewers" id="round-{{ active.round }}-live">
    {% for outcome in active.outcomes %}
        {{ include('dashboard/_live_reviewer.html.twig', {reviewer: outcome.id, heading: outcome.role ~ ' (' ~ outcome.tier ~ ')'}) }}
    {% endfor %}
    </div>
    </div>
    {{ include('dashboard/_session_summary.html.twig', {round: active.round, summary: summary, review_cost: review.cost}, with_context = false) }}
</aside>
{% endif %}
</div>
{% endblock %}
