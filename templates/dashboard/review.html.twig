{% extends 'dashboard/base.html.twig' %}

{% block title %}Review {{ review.change ?: round }} - Intakt{% endblock %}

{% block content_width %} roomy{% endblock %}

{# Every review belongs to a project, so the rail keeps Projects current (decision D3 of #2184). #}
{% set rail_section = 'projects' %}

{% block body %}
{# The page's own stylesheet, linked here because the shared layout belongs to the frame. #}
<link rel="stylesheet" href="{{ asset('styles/review.css') }}">
{{ include('dashboard/components/breadcrumb.html.twig', {crumbs: [
    {label: 'Projects', href: path(constant('Intakt\\Core\\Dashboard\\Contract\\DashboardRoutes::LIST_PROJECTS'))},
    {label: review.project, href: path(constant('Intakt\\Core\\Dashboard\\Contract\\DashboardRoutes::LIST_REVIEWS'), {project: review.project})},
    {label: review.change ?: 'round ' ~ round},
]}, with_context = false) }}
{% set latest = review.rounds|last %}
{% set active = review.activeRound %}
{% set judged = review.lastJudgedRound %}
{% set open = review.openFindings %}
{% set can_start = review.source is not null and review.nextNumber is not null %}
{% set chip = 'dashboard/components/chip.html.twig' %}
{% set term_tpl = 'dashboard/components/term.html.twig' %}
{# Each round carries its own mark, because a replay round can follow a live round of the same change. #}
{% set replay_chip = {label: 'Replay', on_page: true, extra: 'replay-mark'} %}
<div class="page-head">
    <div>
        <h1>Review of {{ review.change ?: 'round ' ~ round }} in {{ review.project }}</h1>
        {% if review.source is not null %}
        <p class="task-sentence">{{ review.source.task }}</p>
        {% else %}
        <p class="task-sentence muted">Task not recorded.</p>
        {% endif %}
        {# Only once the latest pass is judged or ended, because a pass in review has no answer yet and the state block below says where it stands; the empty holder lets the judged round's live update put the card in. #}
        {% if latest.isJudged or latest.hasEnded %}
        {{ include('dashboard/_verdict_card.html.twig', {latest: latest, open: open}, with_context = false) }}
        {% else %}
        <div id="review-verdict" hidden></div>
        {% endif %}
        {{ include('dashboard/_review_path.html.twig', {steps: review.path}, with_context = false) }}
        {% if not can_start %}
        <p class="no-start muted">No button here: the latest round was started before Intakt recorded the repository, base and task it needs to start the next one.</p>
        {% endif %}
    </div>
    {% if can_start or active is not null %}
    <div class="actions task-actions">
        {% if active is not null %}
        {# Marks the round as in review until it is judged or ended, also while no reviewer runs, so the start of the next round stays hidden; the judged round's live update removes it. #}
        <span id="round-{{ active.round }}-now-runs" class="now-runs" hidden></span>
        {# Offered for the whole round in review, also before the first reviewer starts and while the judge works (decision D4 of #2369); the judged round's live update removes it. #}
        <div id="round-{{ active.round }}-now-stop">
            <form method="post" action="{{ path(constant('Intakt\\Core\\Dashboard\\Contract\\DashboardRoutes::STOP_ROUND'), {round: active.round}) }}" class="stop-round">
                <input type="hidden" name="_token" value="{{ csrf_token(constant('Intakt\\Core\\Dashboard\\UseCase\\StopReview\\StopRoundController::TOKEN_ID')) }}">
                {{ include('dashboard/components/button.html.twig', {kind: 'danger', type: 'submit', label: 'Stop', confirm: 'Click again to stop the round'}, with_context = false) }}
                <p class="next-step">The reviewers stop and this pass ends without a verdict.</p>
            </form>
        </div>
        {% endif %}
        {% if can_start %}
        <form method="post" action="{{ path(constant('Intakt\\Core\\Dashboard\\Contract\\DashboardRoutes::START_REVIEW'), {round: round}) }}" class="start-review">
            <input type="hidden" name="_token" value="{{ csrf_token(constant('Intakt\\Core\\Dashboard\\UseCase\\StartReview\\StartReviewController::TOKEN_ID')) }}">
            <input type="hidden" name="number" value="{{ review.nextNumber }}">
            {{ include('dashboard/components/button.html.twig', {kind: 'primary', type: 'submit', label: 'Start pass ' ~ review.nextNumber}, with_context = false) }}
            <p class="next-step">The reviewers read the change again.</p>
        </form>
        {% endif %}
    </div>
    {% endif %}
</div>
{% if active is not null %}
<section class="state-block" aria-labelledby="state-block-title">
    <div class="sb-head">
        <h2 id="state-block-title">Now: {{ include(term_tpl, {term: 'pass', words: 'Review pass ' ~ (active.number ?? '(number not recorded)'), ask: true}, with_context = false) }} <span id="round-{{ active.round }}-now-phase">in review</span></h2>{% if active.isReplay %}{{ include(chip, replay_chip, with_context = false) }}{% endif %}    </div>
    <div class="sb-grid">
        <div>
            <h3>Reviewers</h3>
            <p class="muted" id="round-{{ active.round }}-now-progress">{{ active.outcomes|filter(o => o.progress.name != 'Running')|length }} of {{ active.reviewers }} reviewers finished.</p>
            <ul class="sb-list" id="round-{{ active.round }}-now-reviewers">
                {% for outcome in active.outcomes %}
                {{ include('dashboard/_now_reviewer.html.twig', {round: active.round, reviewer: outcome.id, outcome: outcome, state: outcome.progress.value}, with_context = false) }}
                {% else %}
                <li class="muted" id="round-{{ active.round }}-now-none">No reviewer has started yet.</li>
                {% endfor %}
            </ul>
        </div>
        <div>
            <h3>{{ include(term_tpl, {term: 'fix', words: 'To fix', ask: true}, with_context = false) }}</h3>
            {# Its own partial, because the judged round's live update replaces it with that round's findings to fix. #}
            {{ include('dashboard/_now_findings.html.twig', {round: active.round, open: open, judged: judged.round ?? null}, with_context = false) }}
        </div>
        <div>
            {# The owl sits beside the heading, outside the judge element, because the judged round's live update replaces that element. #}
            <div class="character-row">{{ include('dashboard/components/character.html.twig', {character: constant('Intakt\\Core\\Dashboard\\Domain\\Character::Judge'), size: 48}, with_context = false) }}<h3>The judge's call</h3></div>
            <p class="muted" id="round-{{ active.round }}-now-judge">The judge has not judged this round yet.</p>
        </div>
    </div>
</section>
{% endif %}
{# The To fix cards only while no pass is in review, because the state block lists the findings to fix then; the findings never show twice on one screen. #}
{% if active is null and open is not empty %}
{{ include('dashboard/_to_fix.html.twig', {open: open, judged: judged.round}, with_context = false) }}
{% endif %}
<a class="full-record" href="{{ path(constant('Intakt\\Core\\Dashboard\\Contract\\DashboardRoutes::SHOW_REVIEW_RECORD'), {round: round}) }}">
    <span class="full-record-text"><b>Full record</b><small>Timeline, reviewers, tokens and cost</small></span>
    {{ include('dashboard/components/icon.html.twig', {name: 'chevron', small: true, extra: 'fix-chev'}, with_context = false) }}
</a>
{% endblock %}
