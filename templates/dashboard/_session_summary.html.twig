{% import 'dashboard/_session_summary_parts.html.twig' as part %}
<section class="log-summary" data-controller="finding-highlight" aria-label="Session summary">
{% if summary is null %}
    <p class="muted">No session summary: Intakt holds no record of this round's tool calls and findings.</p>
{% else %}
    <div class="ls-grid">
        {{ part.tools(round, summary) }}
        <div>
            <h3>Cost</h3>
            <dl class="ls-dl ls-cost">
                <dt>This round</dt>{{ part.round_cost(round, summary) }}
                <dt>Review so far</dt><dd>{{ review_cost.reading }}</dd>
            </dl>
        </div>
    </div>
    {{ part.files(round, summary) }}
    {{ part.findings(round, summary) }}
{% endif %}
</section>
