{# The act list of the Now box, rendered by the review page and by the judged stream; "judged" is the round whose findings are listed, null before any round was judged. #}
<div id="round-{{ at }}-now-open">
    {% if open is empty %}
    <p class="muted">No finding is open.</p>
    {% else %}
    {% for finding in open %}
    <a class="sb-finding" href="#round-{{ judged.round }}-finding-{{ finding.id }}"><span class="sev">{{ finding.severity ?? '?' }}</span><span><span class="mono">{{ finding.entryId }}</span> {{ finding.text ?? 'Text not recorded.' }}</span></a>
    {% endfor %}
    {% endif %}
</div>
