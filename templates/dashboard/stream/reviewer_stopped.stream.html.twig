{{ include('dashboard/stream/_reviewer_row_placed.stream.html.twig', {round: round, reviewer: reviewer, state: 'stopped'}, with_context = false) }}
<turbo-stream action="replace" target="round-{{ round }}-reviewer-{{ reviewer }}-state"><template><td id="round-{{ round }}-reviewer-{{ reviewer }}-state">stopped</td></template></turbo-stream>
{# A selector, because the page has no stop cell while no reviewer can be stopped. #}
<turbo-stream action="replace" targets="#round-{{ round }}-reviewer-{{ reviewer }}-stop"><template><td id="round-{{ round }}-reviewer-{{ reviewer }}-stop"></td></template></turbo-stream>
{{ include('dashboard/stream/_now_reviewer_placed.stream.html.twig', {round: round, reviewer: reviewer, state: 'stopped'}, with_context = false) }}
<turbo-stream action="replace" target="round-{{ round }}-now-reviewer-{{ reviewer }}-state"><template><span id="round-{{ round }}-now-reviewer-{{ reviewer }}-state">stopped</span></template></turbo-stream>
