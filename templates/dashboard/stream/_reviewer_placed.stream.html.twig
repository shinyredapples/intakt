{# Matches no element once the reviewer has its place, so a reviewer that started after the page loaded gets one and a known one keeps its text. #}
<turbo-stream action="append" targets="#round-{{ round }}-live:not(:has(#reviewer-{{ reviewer }}-text))"><template>{{ include('dashboard/_live_reviewer.html.twig', {reviewer: reviewer, heading: outcome is not null ? outcome.role ~ ' (' ~ outcome.modelInWords ~ ')' : 'A reviewer (role not read)'}) }}</template></turbo-stream>
