{# Matches no element once the table lists the reviewer, so a reviewer that started after the page loaded gets a row and a known row keeps its role and tier; its stop cell stays empty, because a stream cannot carry this session's token. #}
<turbo-stream action="append" targets="#round-{{ round }}-reviewers:not(:has(#round-{{ round }}-reviewer-{{ reviewer }}-state))"><template><tr><td>{{ reviewer }}</td><td></td><td id="round-{{ round }}-reviewer-{{ reviewer }}-state">{{ state }}</td><td></td><td class="num"></td><td>started after this page loaded</td><td id="round-{{ round }}-reviewer-{{ reviewer }}-stop"></td></tr></template></turbo-stream>
