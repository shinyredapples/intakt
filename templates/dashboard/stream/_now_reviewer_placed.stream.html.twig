{# Matches no element once the block lists the reviewer, so a reviewer that started after the page loaded gets a row and a known row keeps its role and model. #}
<turbo-stream action="remove" target="round-{{ round }}-now-none"></turbo-stream>
<turbo-stream action="append" targets="#round-{{ round }}-now-reviewers:not(:has(#round-{{ round }}-now-reviewer-{{ reviewer }}-state))"><template>{{ include('dashboard/_now_reviewer.html.twig', {round: round, reviewer: reviewer, outcome: outcome, state: state}, with_context = false) }}</template></turbo-stream>
