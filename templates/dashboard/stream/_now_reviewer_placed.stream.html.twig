{# Matches no element once the block lists the reviewer, so a reviewer that started after the page loaded gets a row and a known row keeps its role and model. #}
<turbo-stream action="remove" target="round-{{ round }}-now-none"></turbo-stream>
{% if state == 'running' %}<turbo-stream action="remove" target="round-{{ round }}-now-stop-idle"></turbo-stream>{% endif %}
<turbo-stream action="append" targets="#round-{{ round }}-now-reviewers:not(:has(#round-{{ round }}-now-reviewer-{{ reviewer }}-state))"><template><li><span>{% if outcome is not null %}<strong>{{ outcome.role }}</strong> ({{ outcome.modelInWords }}){% else %}<strong>A reviewer</strong> (role not read){% endif %}: <span id="round-{{ round }}-now-reviewer-{{ reviewer }}-state">{{ include('dashboard/stream/_reviewer_outcome.html.twig', {state: state, outcome: outcome}, with_context = false) }}</span></span></li></template></turbo-stream>
