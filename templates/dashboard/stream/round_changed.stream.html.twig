<turbo-stream action="replace" target="round-{{ round }}-state"><template><p id="round-{{ round }}-state">{% if progress.judged %}Judged.{% else %}{{ progress.reviewersFinished }} of {{ progress.reviewers }} reviewers finished.{% endif %}</p></template></turbo-stream>
<turbo-stream action="replace" target="round-{{ round }}-now-progress"><template><p class="muted" id="round-{{ round }}-now-progress">{{ progress.reviewersFinished }} of {{ progress.reviewers }} reviewers finished.</p></template></turbo-stream>
{% for reviewer, state in progress.finished %}
{{ include('dashboard/stream/_reviewer_row_placed.stream.html.twig', {round: round, reviewer: reviewer, state: state.value, outcomes: outcomes ?? {}}, with_context = false) }}
<turbo-stream action="replace" target="round-{{ round }}-reviewer-{{ reviewer }}-state"><template><td id="round-{{ round }}-reviewer-{{ reviewer }}-state">{{ include('dashboard/stream/_reviewer_outcome.html.twig', {reviewer: reviewer, state: state.value, outcomes: outcomes ?? {}}, with_context = false) }}</td></template></turbo-stream>
{# A selector, because the page has no stop cell while no reviewer can be stopped. #}
<turbo-stream action="replace" targets="#round-{{ round }}-reviewer-{{ reviewer }}-stop"><template><td id="round-{{ round }}-reviewer-{{ reviewer }}-stop"></td></template></turbo-stream>
{{ include('dashboard/stream/_now_reviewer_placed.stream.html.twig', {round: round, reviewer: reviewer, state: state.value, outcomes: outcomes ?? {}}, with_context = false) }}
<turbo-stream action="replace" target="round-{{ round }}-now-reviewer-{{ reviewer }}-state"><template><span id="round-{{ round }}-now-reviewer-{{ reviewer }}-state">{{ include('dashboard/stream/_reviewer_outcome.html.twig', {reviewer: reviewer, state: state.value, outcomes: outcomes ?? {}}, with_context = false) }}</span></template></turbo-stream>
{% endfor %}
{% if progress.judged or progress.reviewersFinished >= progress.reviewers %}
<turbo-stream action="replace" target="round-{{ round }}-now-stop"><template><div id="round-{{ round }}-now-stop"></div></template></turbo-stream>
{% endif %}