{{ include('dashboard/stream/_reviewer_placed.stream.html.twig') }}
{# Built only from the typed answer's fields, never from the reviewer's text. #}
<turbo-stream action="append" target="reviewer-{{ reviewer }}-text"><template>{% if answer.wasRead %}<p class="answer-read">Verdict: {{ answer.verdict.value }}</p>{% for finding in answer.findings %}<p class="answer-finding">{{ finding.severity.value }} {% if finding.file is not null %}{{ finding.file }}{% if finding.line is not null %}:{{ finding.line }}{% endif %} {% endif %}{{ include('dashboard/_kind_symbol.html.twig', {words: finding.kind is null ? null : finding.kind.inWords}, with_context = false) }}{{ include('dashboard/_finding_spans.html.twig', {spans: finding_title_spans(finding.title)}, with_context = false) }}</p>{% endfor %}{% else %}<p class="answer-unreadable">The answer could not be read.</p>{% endif %}</template></turbo-stream>
