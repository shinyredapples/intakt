{# The state of the round first, so the finished count, the reviewer rows and the stop already read as judged; the judged parts follow. #}
{{ include('dashboard/stream/round_changed.stream.html.twig') }}
<turbo-stream action="replace" target="round-{{ round }}-head-state"><template><span id="round-{{ round }}-head-state">{{ include('dashboard/_round_state.html.twig', {state: constant('Intakt\\Core\\Dashboard\\Domain\\ReviewState::Judged')}, with_context = false) }}</span></template></turbo-stream>
<turbo-stream action="replace" target="round-{{ round }}-now-phase"><template><span id="round-{{ round }}-now-phase">judged</span></template></turbo-stream>
{% if (reviewed ?? null) is not null %}
<turbo-stream action="replace" target="round-{{ round }}-verdict"><template>{{ include('dashboard/_round_verdict.html.twig', {reviewed: reviewed}, with_context = false) }}</template></turbo-stream>
<turbo-stream action="replace" target="round-{{ round }}-judged"><template>{{ include('dashboard/_judged_round.html.twig', {reviewed: reviewed}, with_context = false) }}</template></turbo-stream>
<turbo-stream action="replace" target="round-{{ round }}-now-findings"><template>{{ include('dashboard/_now_findings.html.twig', {round: round, open: reviewed.actFindings, judged: reviewed.round}, with_context = false) }}</template></turbo-stream>
<turbo-stream action="replace" target="round-{{ round }}-now-judge"><template><p class="muted" id="round-{{ round }}-now-judge">The judge has judged this round. Its call and the findings to fix are in the round below.</p></template></turbo-stream>
{# The tokens and cost too, because the running summary stops at the judged state, so only this update brings the final figures. #}
{% import 'dashboard/_review_summary.html.twig' as review_summary %}
{% import 'dashboard/_session_summary_parts.html.twig' as part %}
<turbo-stream action="replace" target="round-{{ round }}-tokens"><template>{{ review_summary.round_tokens(reviewed)|trim }}</template></turbo-stream>
<turbo-stream action="replace" target="review-summary-tokens"><template>{{ review_summary.tokens(review.tokens)|trim }}</template></turbo-stream>
<turbo-stream action="replace" target="review-summary-cost"><template>{{ review_summary.cost(review.cost)|trim }}</template></turbo-stream>
<turbo-stream action="replace" target="round-{{ round }}-review-cost"><template>{{ part.review_cost(round, review.cost)|trim }}</template></turbo-stream>
{% else %}
{# Without the judged round, because the ledger could not be read when it was published. #}
<turbo-stream action="replace" target="round-{{ round }}-now-judge"><template><p class="muted" id="round-{{ round }}-now-judge">The judge has judged this round. Its call and the findings to fix could not be read for this update.</p></template></turbo-stream>
{% endif %}
