{#- An update of the select's options, not a replace of the select, so the shell's listeners on #projfilter stay bound; no option is marked selected, because the publisher cannot know each tab's choice, and the shell puts each tab's own back. -#}
<turbo-stream action="update" target="projfilter"><template>{{ include('dashboard/components/_options.html.twig', {options: [{value: '', label: 'All projects'}]|merge(projects|map(name => {value: name, label: name})), selected: null}, with_context = false) }}</template></turbo-stream>
