{% extends 'dashboard/base.html.twig' %}

{% block title %}Full record of {{ review.change ?: round }} - Intakt{% endblock %}

{% block content_width %} roomy{% endblock %}

{# Every review belongs to a project, so the rail keeps Projects current (decision D3 of #2184). #}
{% set rail_section = 'projects' %}

{% block body %}
{# The Full record of a review: every pass's timeline with its reviewers, findings, tokens and cost, and the live log while a pass is in review; the main view links here (owner decision for #3360). #}
{# The page's own stylesheet, linked here because the shared layout belongs to the frame. #}
<link rel="stylesheet" href="{{ asset('styles/review.css') }}">
{{ include('dashboard/components/breadcrumb.html.twig', {crumbs: [
    {label: 'Projects', href: path(constant('Intakt\\Core\\Dashboard\\Contract\\DashboardRoutes::LIST_PROJECTS'))},
    {label: review.project, href: path(constant('Intakt\\Core\\Dashboard\\Contract\\DashboardRoutes::LIST_REVIEWS'), {project: review.project})},
    {label: review.change ?: 'round ' ~ round, href: path(constant('Intakt\\Core\\Dashboard\\Contract\\DashboardRoutes::SHOW_REVIEW'), {round: round})},
    {label: 'Full record'},
]}, with_context = false) }}
{% import 'dashboard/_review_summary.html.twig' as totals %}
{% set latest = review.rounds|last %}
{% set active = review.activeRound %}
{% set chip = 'dashboard/components/chip.html.twig' %}
{# Each round carries its own mark, because a replay round can follow a live round of the same change. #}
{% set replay_chip = {label: 'Replay', on_page: true, extra: 'replay-mark'} %}
<div class="page-head">
    <div>
        <h1>Full record of {{ review.change ?: 'round ' ~ round }} in {{ review.project }}</h1>
        {% if review.everyRoundIsAReplay %}
        <p class="replay-mark">{{ include(chip, {label: 'Replay', on_page: true}, with_context = false) }} A recording played back: its verdicts were never given on this change and never count as one.</p>
        {% endif %}
        {# One kind label in this line, on the cost, because it is the one estimate among the facts (decision D5 of #2206). #}
        {{ include('dashboard/components/meta.html.twig', {facts: [
            {text: review.project},
            {text: review.change ?: 'round ' ~ round, mono: true},
            {icon: 'rounds', text: review.rounds|length ~ (review.rounds|length == 1 ? ' round' : ' rounds')},
            {icon: 'tokens', markup: totals.tokens(review)},
            {icon: 'wallet', text: 'Cost: ', markup: totals.cost(review)},
            {icon: 'clock', text: 'Latest round started ' ~ latest.startedAt|date('Y-m-d H:i:s', 'UTC') ~ ' UTC'},
        ]}, with_context = false) }}
        <p class="record-back"><a href="{{ path(constant('Intakt\\Core\\Dashboard\\Contract\\DashboardRoutes::SHOW_REVIEW'), {round: round}) }}">Back to the review</a></p>
    </div>
</div>
{% if active is not null %}
<div class="ttabs"><div class="seg" role="tablist" aria-label="Task views">
    {# Only the chosen tab is a Tab stop, because the arrow keys move between the tabs (the ARIA tabs pattern, decision 1 of #2638). #}
    <button type="button" role="tab" id="timeline-tab" aria-selected="true" tabindex="0" aria-controls="timeline-pane" data-pane="timeline">Timeline</button>
    <button type="button" role="tab" id="live-log-tab" aria-selected="false" tabindex="-1" aria-controls="live-log-pane" data-pane="log">Live log</button>
</div></div>
{% endif %}
<div class="task-grid" data-pane="timeline">
{# A tab panel only while the tabs exist, so its label never names a tab the page lacks. A pane is rendered as a phone shows it; assets/task-panes.js names it by its data-heading while both panes are shown. #}
<section class="tl-pane" id="timeline-pane"{% if active is not null %} role="tabpanel" aria-labelledby="timeline-tab" tabindex="0" data-heading="timeline-title"{% else %} aria-labelledby="timeline-title"{% endif %}>
<h2 class="timeline-title" id="timeline-title">Timeline</h2>
{% for reviewed in review.rounds %}
{% if reviewed.isJudged %}
<section class="section round" id="round-{{ reviewed.round }}">
    {# Only the newest round opens on arrival, because its verdict is what the reader came for and older rounds would push it down. A judged round followed by a round still in review stays closed, because only the newest round opens. #}
    <details class="ev"{% if loop.last %} open{% endif %}>
        <summary class="ev-head">
            {# No "?" in a summary, because a focusable term would nest a control in the disclosure's own control; the round body explains the words. #}
            <h2>Review pass {{ reviewed.number ?? '(number not recorded)' }}</h2>
            {% if reviewed.isReplay %}{{ include(chip, replay_chip, with_context = false) }}{% endif %}
            {% if reviewed.speedFactor is not null %}<span class="muted small replay-factor">Played {{ reviewed.speedFactor|number_format(6, '.', '')|trim('0', 'right')|trim('.', 'right') }} times as fast as recorded</span>{% endif %}
            {% set outcome = reviewed.reviewOutcome %}
            {% if outcome is not null %}{{ include('dashboard/components/outcome_chip.html.twig', {outcome: outcome, on_page: true, plain: true}, with_context = false) }}{% endif %}
            {# Plain muted text, because the outcome is the headline and the process state only says where the round stands. #}
            <span class="muted small state-judged" title="Judged">Checked</span>
            {# A round judged before Intakt kept the findings holds only the judge's marks, so a count would pass them off as the reviewers' findings. #}
            <span class="muted small">{% if outcome is null %}outcome not recorded, {% endif %}{% if reviewed.findingTextRecorded %}{{ reviewed.findings|length }} {{ reviewed.findings|length == 1 ? 'finding' : 'findings' }}{% else %}findings not recorded{% if reviewed.findings is not empty %}, {{ reviewed.findings|length }} marked by the judge{% endif %}{% endif %}</span>
            {% set spanFormat = reviewed.startedAt|date('Y-m-d', 'UTC') == reviewed.judgedAt|date('Y-m-d', 'UTC') ? 'H:i' : 'Y-m-d H:i' %}
            <time>{{ reviewed.startedAt|date(spanFormat, 'UTC') }} to {{ reviewed.judgedAt|date(spanFormat, 'UTC') }} UTC</time>
            {{ include('dashboard/components/icon.html.twig', {name: 'chevron', small: true, extra: 'chev'}, with_context = false) }}
        </summary>
        {# Only the newest round's tables carry the kind labels, so the page keeps at most five however many rounds it lists (decision D5 of #2206). #}
        {{ include('dashboard/_round_body.html.twig', {reviewed: reviewed, labeled: loop.last}, with_context = false) }}
    </details>
</section>
{% else %}
<section class="section round" id="round-{{ reviewed.round }}">
    <div class="round-head">
        <h2>Review pass {{ reviewed.number ?? '(number not recorded)' }}</h2>
        {% if reviewed.isReplay %}{{ include(chip, replay_chip, with_context = false) }}{% endif %}
        {% if reviewed.speedFactor is not null %}<span class="muted small replay-factor">Played {{ reviewed.speedFactor|number_format(6, '.', '')|trim('0', 'right')|trim('.', 'right') }} times as fast as recorded</span>{% endif %}
        <span id="round-{{ reviewed.round }}-head-state">{{ include('dashboard/_round_state.html.twig', {state: reviewed.state, outcome: reviewed.reviewOutcome, plain: true}, with_context = false) }}</span>
    </div>
    {% if reviewed.ending is not null %}
    <p class="muted round-ending" id="round-{{ reviewed.round }}-ending">{{ reviewed.reviewOutcome.value }}: {{ reviewed.ending.reason }}</p>
    {% endif %}
    {{ include('dashboard/_round_body.html.twig', {reviewed: reviewed, labeled: loop.last}, with_context = false) }}
</section>
{% endif %}
{% endfor %}
</section>
{% if active is not null %}
<aside class="log log-pane" id="live-log-pane" role="tabpanel" aria-labelledby="live-log-tab" tabindex="0" data-heading="live-log-title">
    <h2 id="live-log-title">Live log of review pass {{ active.number ?? '(number not recorded)' }}</h2>
    <div class="log-main">
    {# Outside the streams' container, so a reviewer's first update cannot remove it; the stylesheet hides it once a reviewer is placed. #}
    <p class="muted log-empty">Each reviewer's tool calls and text appear here as it works.</p>
    <div class="live-reviewers" id="round-{{ active.round }}-live">
    {% for outcome in active.outcomes %}
        {{ include('dashboard/_live_reviewer.html.twig', {reviewer: outcome.id, heading: outcome.role ~ ' (' ~ outcome.modelAndLab ~ ')', model: outcome.model}) }}
    {% endfor %}
    </div>
    </div>
    {{ include('dashboard/_session_summary.html.twig', {round: active.round, summary: summary, review_cost: review.cost}, with_context = false) }}
</aside>
{% endif %}
</div>
{% endblock %}
