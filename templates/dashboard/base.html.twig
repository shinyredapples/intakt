<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Intakt{% endblock %}</title>
    {# Runs before the first paint, so a stored or system dark theme never flashes light, a collapsed rail never flashes open and a closed demo caption never flashes; the shell script at the end of the body and assets/tour-caption.js store the keys it reads. #}
    <script>(() => {
        const root = document.documentElement;
        let theme = null;
        let rail = null;
        let tour = null;
        try {
            theme = localStorage.getItem('intakt-theme');
            rail = localStorage.getItem('intakt-rail');
            tour = sessionStorage.getItem('intakt-tour');
        } catch {}
        root.dataset.theme = theme === 'light' || theme === 'dark' ? theme : (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        if (rail === 'collapsed') {
            root.dataset.rail = 'collapsed';
        }
        if (tour === 'closed') {
            root.dataset.tour = 'closed';
        }
    })();</script>
    <link rel="icon" type="image/png" href="{{ asset('images/favicon-32.png') }}">
    <link rel="stylesheet" href="{{ asset('styles/fonts.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/tokens.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/base.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/components.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/demo.css') }}">
    {# Only a page the hub can reach is told to listen; the plain page shows the ledger's state either way. #}
    {% block importmap %}{% if live|default(false) %}{{ importmap('app') }}{% endif %}{% endblock %}
    {# Imported by their own address, not through the import map, so a danger button asks first, the search opens, the review page switches panes, a finding id highlights its entry, a collapsed board column, a crowded one and a phone banner open, the asleep octopus of a project the filter shows wakes into view, and the board's hidden side fades, the demo caption pauses and closes, and a command copies, also on a page without one. After the import map, which a browser ignores once a module has started to load. The edges are marked after the fold, so a click that opens a column is measured open. #}
    <script type="module">import { holdBackDangerButtons } from '{{ asset('arm.js') }}'; import { offerSearch } from '{{ asset('search.js') }}'; import { switchTaskPanes } from '{{ asset('task-panes.js') }}'; import { highlightFindings } from '{{ asset('finding-highlight.js') }}'; import { foldColumns } from '{{ asset('column-fold.js') }}'; import { showMoreCards } from '{{ asset('column-more.js') }}'; import { toggleBanners } from '{{ asset('banner-toggle.js') }}'; import { markBoardEdges } from '{{ asset('board-edge.js') }}'; import { captionTour } from '{{ asset('tour-caption.js') }}'; import { copyCommands } from '{{ asset('copy-command.js') }}'; import { showIdleProjectOctopus } from '{{ asset('board-octopus.js') }}'; holdBackDangerButtons(document); offerSearch(document); switchTaskPanes(document, window); highlightFindings(document); foldColumns(document); showMoreCards(document); toggleBanners(document); markBoardEdges(document, window); captionTour(document, sessionStorage); copyCommands(document, window); showIdleProjectOctopus(document);</script>
</head>
<body>
{# The connection controller runs only on a page that loads the import map, which is also the only kind of page with a live connection. #}
<div class="shell" data-controller="connection">
{# Now, You and Trends, the three places of the UX2 frame; Projects goes under More, which a phone shows instead of it. You counts what its page lists; the You page and the board pass the count of the list they show, so one response never reads the notices twice. #}
{{ include('dashboard/_rail.html.twig', {
    rail_items: [
        {key: 'board', label: 'Now', icon: 'home', route: constant('Intakt\\Core\\Dashboard\\Contract\\DashboardRoutes::SHOW_BOARD'), params: {board: 1}},
        {key: 'waiting', label: 'You', icon: 'clock', route: constant('Intakt\\Core\\Dashboard\\Contract\\DashboardRoutes::LIST_WAITING'), count: waiting_listed ?? waiting_count()},
        {key: 'trends', label: 'Trends', icon: 'trends', route: constant('Intakt\\Core\\Dashboard\\Contract\\DashboardRoutes::SHOW_TRENDS')},
    ],
    more_items: [
        {key: 'projects', label: 'Projects', icon: 'projects', route: constant('Intakt\\Core\\Dashboard\\Contract\\DashboardRoutes::LIST_PROJECTS')},
    ],
    current_route: app.current_route,
    current_section: rail_section ?? null,
}, with_context = false) }}
<div class="main">
{# One listener for the shell topic and the page's own. The cookie it sets also carries listener_grants, the same on every page, because every tab shares it. It sits here, not beside the rail, because any child of the shell takes a cell of its two-column grid. #}
{% if live|default(false) %}{% do mercure(null, {subscribe: listener_grants}) %}{{ turbo_stream_from([constant('Intakt\\Core\\Dashboard\\Contract\\DashboardTopics::SHELL')]|merge(topics|default([])), true) }}{% endif %}
<header class="topbar">
    <a class="brand-m" href="{{ path(constant('Intakt\\Core\\Dashboard\\Contract\\DashboardRoutes::SHOW_BOARD')) }}" aria-label="Intakt home"><img class="logo-light" src="{{ asset('images/intakt-lockup.svg') }}" alt="Intakt"><img class="logo-dark" src="{{ asset('images/intakt-lockup-dark.svg') }}" alt="Intakt"></a>
    <button class="search-trigger" type="button" aria-haspopup="dialog" aria-controls="search" aria-keyshortcuts="Control+K Meta+K">{{ include('dashboard/components/icon.html.twig', {name: 'search'}, with_context = false) }}<span class="ph">Search tasks, pull requests, settings…</span><span class="ph-short">Search</span><kbd>Ctrl K</kbd></button>
    <div class="grow"></div>
    {# The empty value is All projects, because no project name is empty, while a project may be named "all". A page linked to one project marks it selected, and the script below prefers it to the stored choice. The error page passes project_names, read where a failing ledger cannot take the shell down with it. #}
    {{ include('dashboard/components/select.html.twig', {id: 'projfilter', name: 'project', aria_label: 'Project', selected: linked_project ?? '', options: [{value: '', label: 'All projects'}]|merge((project_names ?? filter_projects())|map(name => {value: name, label: name}))}, with_context = false) }}
    <button class="icon-btn theme-toggle" type="button" aria-label="Switch light or dark theme" data-theme-toggle>{{ include('dashboard/components/icon.html.twig', {name: 'moon', extra: 'moon'}, with_context = false) }}{{ include('dashboard/components/icon.html.twig', {name: 'sun', extra: 'sun'}, with_context = false) }}</button>
    {{ include('dashboard/components/offline.html.twig', {live: true}, with_context = false) }}
</header>
{# A page whose content runs side by side, as the board's columns do, takes the full width with ` wide`. #}
<main class="content{% block content_width %}{% endblock %}">
{{ include('dashboard/components/connection.html.twig', {live: true}, with_context = false) }}
{% for line in app.flashes('success') %}
<p class="flash flash-success">{{ line }}</p>
{% endfor %}
{% for line in app.flashes('error') %}
<p class="flash flash-error">{{ line }}</p>
{% endfor %}
{# A toast floats over the page instead of a line above it, so a started round does not push the page down. #}
{% for line in app.flashes('toast') %}
{{ include('dashboard/components/toast.html.twig', {message: line}, with_context = false) }}
{% endfor %}
{% block body %}{% endblock %}
</main>
{# After the content and sticky at the bottom, so the caption takes its own room below the page and never covers its end; the error page leaves it out, because a failing ledger must not take that page down too. #}
{% block tour %}{{ include('dashboard/_tour_caption.html.twig', {caption: demo_tour()}, with_context = false) }}{% endblock %}
</div>
</div>
{# Outside the shell, because any child of it takes a cell of its grid, and because the search script makes the shell inert while this is open. assets/search.js opens it and fills the list box with the results fragment of the search route. #}
<div class="overlay" id="search" role="dialog" aria-modal="true" aria-label="Search" data-search-url="{{ path(constant('Intakt\\Core\\Dashboard\\Contract\\DashboardRoutes::SEARCH')) }}" hidden>
<div class="palette">
    <div class="q">{{ include('dashboard/components/icon.html.twig', {name: 'search'}, with_context = false) }}<input id="search-q" type="text" placeholder="Search tasks, pull requests, settings…" autocomplete="off" role="combobox" aria-label="Search" aria-autocomplete="list" aria-expanded="true" aria-controls="search-results"><kbd>Esc</kbd><button class="btn quiet" type="button" data-search-cancel>Cancel</button></div>
    <div class="results" id="search-results" role="listbox" aria-label="Results"></div>
    <footer><span><kbd>↑</kbd> <kbd>↓</kbd> move</span><span><kbd>Enter</kbd> open</span><span><kbd>Esc</kbd> close</span></footer>
</div>
</div>
{# Listens on the body, because Turbo replaces it on a visit and runs this script again, so no listener is left twice. #}
<script>(() => {
    const root = document.documentElement;
    const store = (key, value) => {
        try {
            localStorage.setItem(key, value);
        } catch {}
    };
    const railToggle = document.querySelector('[data-rail-toggle]');
    const search = document.querySelector('.search-trigger');
    const projectFilter = document.querySelector('#projfilter');
    const more = document.querySelector('[data-more-toggle]');
    const moreSheet = document.querySelector('[data-more-sheet]');
    // A phone's top bar has no project filter, so a choice it cannot show would hide rows with nothing to undo it.
    const phone = matchMedia('(max-width: 760px)');
    const read = (key) => {
        try {
            return localStorage.getItem(key);
        } catch {
            return null;
        }
    };
    // Looks the select up when called, because a listener bound once calls it after a visit has replaced the body.
    const showProject = () => {
        const shownFilter = document.querySelector('#projfilter');
        if (!shownFilter) {
            return;
        }
        // A project link's breadcrumb and Projects mark name its project, so they go once the filter shows another or all projects, as a reload of the address without the link would show.
        const trail = document.querySelector('[data-project-trail]');
        if (trail && trail.dataset.projectTrail !== shownFilter.value) {
            trail.remove();
            document.querySelectorAll('[data-section-current]').forEach((mark) => mark.removeAttribute('aria-current'));
        }
        const chosen = phone.matches ? '' : shownFilter.value;
        document.querySelectorAll('[data-project]').forEach((item) => {
            item.hidden = chosen !== '' && item.dataset.project !== chosen;
        });
        shownFilter.title = shownFilter.selectedOptions[0].textContent;
        // assets/column-more.js counts a crowded column's page limit over the cards left shown, so it hears of each run.
        document.dispatchEvent(new Event('intakt:project-shown'));
    };
    const showMore = (open) => {
        moreSheet.hidden = !open;
        more.setAttribute('aria-expanded', String(open));
    };
    const showRail = () => {
        const collapsed = root.dataset.rail === 'collapsed';
        railToggle.setAttribute('aria-expanded', String(!collapsed));
        railToggle.title = collapsed ? 'Expand menu' : 'Collapse menu';
    };

    showRail();
    railToggle.addEventListener('click', () => {
        if (root.dataset.rail === 'collapsed') {
            delete root.dataset.rail;
        } else {
            root.dataset.rail = 'collapsed';
        }
        store('intakt-rail', root.dataset.rail ?? 'open');
        showRail();
    });
    document.querySelectorAll('[data-theme-toggle]').forEach((toggle) => toggle.addEventListener('click', () => {
        root.dataset.theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
        store('intakt-theme', root.dataset.theme);
    }));
    // A project link (the option the server marked selected) is a choice and is kept like one. A stored project the install no longer lists falls back to All projects, so the select never hides rows under another name.
    const linkedProject = [...projectFilter.options].find((option) => option.defaultSelected && option.value !== '');
    const storedProject = read('intakt-project');
    if (linkedProject) {
        // Set as well as stored, so the shown and the stored choice are one even if a page marked more than one option.
        projectFilter.value = linkedProject.value;
        store('intakt-project', linkedProject.value);
    } else if ([...projectFilter.options].some((option) => option.value === storedProject)) {
        projectFilter.value = storedProject;
    }
    showProject();
    // The width and the document outlive the body Turbo replaces, so their listeners are bound on the first run only and act on whichever page is shown.
    if (!('shellBound' in root.dataset)) {
        root.dataset.shellBound = '';
        phone.addEventListener('change', showProject);
        // Turbo appends a stream to the document element, so only the document sees it.
        document.addEventListener('turbo:before-stream-render', (event) => {
            const replaced = document.getElementById(event.target.getAttribute('target') ?? '');
            if (event.target.getAttribute('action') === 'replace' && replaced?.id === 'working-now') {
                const render = event.detail.render;
                // The pushed Working now carries every project's cards, so the project choice is put back on them; a focused card is found again by its link, because a card the push moved or rebuilt is a new node and the keyboard would fall back to the page start.
                event.detail.render = (stream) => {
                    const focusedLink = replaced.contains(document.activeElement) ? document.activeElement.closest('a[href]')?.getAttribute('href') ?? null : null;
                    render(stream);
                    showProject();
                    if (focusedLink !== null) {
                        [...(document.getElementById('working-now')?.querySelectorAll('a[href]') ?? [])].find((link) => link.getAttribute('href') === focusedLink)?.focus({ preventScroll: true });
                    }
                };
                return;
            }
            if (event.target.getAttribute('action') === 'replace' && replaced?.matches('.board > .col')) {
                const render = event.detail.render;
                // The pushed column comes from the server with its start state and every card shown, so the person's own fold, Show more and project choice are put back on it; the Show more mark goes back before the filter runs, because assets/column-more.js reads it there.
                event.detail.render = (stream) => {
                    const collapsed = replaced.classList.contains('collapsed');
                    const expanded = replaced.hasAttribute('data-expanded');
                    // A replaced column is new markup, so a card the person had focused is found again by its link, and a glossary term inside it by its place among the card's focusable terms (their ids are random per render); without this the keyboard falls back to the page start at every push.
                    const focused = replaced.contains(document.activeElement) ? document.activeElement : null;
                    const focusedCard = focused?.closest('a[href]') ?? null;
                    const focusedLink = focusedCard?.getAttribute('href') ?? null;
                    const focusedTerm = focusedCard !== null && focused !== focusedCard ? [...focusedCard.querySelectorAll('[tabindex]')].indexOf(focused) : -1;
                    render(stream);
                    const pushed = document.getElementById(replaced.id);
                    pushed?.classList.toggle('collapsed', collapsed);
                    pushed?.querySelector('.col-fold')?.setAttribute('aria-expanded', String(!collapsed));
                    pushed?.toggleAttribute('data-expanded', expanded);
                    showProject();
                    if (focusedLink !== null) {
                        const card = [...(pushed?.querySelectorAll('a[href]') ?? [])].find((link) => link.getAttribute('href') === focusedLink);
                        (focusedTerm < 0 ? card : card?.querySelectorAll('[tabindex]')[focusedTerm])?.focus({ preventScroll: true });
                    }
                };
                return;
            }
            const shownFilter = document.querySelector('#projfilter');
            if (event.target.getAttribute('target') !== 'projfilter' || !shownFilter) {
                return;
            }
            const render = event.detail.render;
            // The pushed options carry no choice, so this tab's own is put back unless the project is gone; it is never stored, because only the person's own pick is.
            event.detail.render = (stream) => {
                const chosen = shownFilter.value;
                render(stream);
                shownFilter.value = [...shownFilter.options].some((option) => option.value === chosen) ? chosen : '';
                showProject();
            };
        });
    }
    if (more) {
        more.addEventListener('click', () => showMore(moreSheet.hidden));
        // A tap beside the sheet's pages lands on its backdrop.
        moreSheet.addEventListener('click', (event) => {
            if (event.target === moreSheet) {
                showMore(false);
            }
        });
    }
    projectFilter.addEventListener('change', () => {
        store('intakt-project', projectFilter.value);
        showProject();
        // Otherwise a reload would choose the linked project again; the state is kept because Turbo keeps its own there.
        const address = new URL(location.href);
        if (address.searchParams.has('project')) {
            address.searchParams.delete('project');
            history.replaceState(history.state, '', address);
        }
    });
    if (/Mac|iPhone|iPad/.test(navigator.platform)) {
        search.querySelector('kbd').textContent = '⌘K';
    }
    document.body.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && more && !moreSheet.hidden) {
            showMore(false);
            more.focus();
        }
    });
})();</script>
</body>
</html>
