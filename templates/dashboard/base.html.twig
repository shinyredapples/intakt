<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>{% block title %}Intakt{% endblock %}</title>
    {# Runs before the first paint, so a stored or system dark theme never flashes light; assets/controllers/theme_controller.js stores the key it reads. #}
    <script>(() => {
        let stored = null;
        try { stored = localStorage.getItem('intakt-theme'); } catch {}
        document.documentElement.dataset.theme = stored === 'light' || stored === 'dark' ? stored : (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    })();</script>
    <link rel="stylesheet" href="{{ asset('styles/fonts.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/tokens.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/base.css') }}">
    {% block importmap %}{% endblock %}
</head>
<body>
<nav>
    <a href="{{ path(constant('Intakt\\Core\\Dashboard\\Contract\\DashboardRoutes::LIST_PROJECTS')) }}">Projects</a>
    <a href="{{ path(constant('Intakt\\Core\\Dashboard\\Contract\\DashboardRoutes::LIST_REVIEWS')) }}">Reviews</a>
</nav>
<main>
{% for line in app.flashes('success') %}
<p class="flash flash-success">{{ line }}</p>
{% endfor %}
{% for line in app.flashes('error') %}
<p class="flash flash-error">{{ line }}</p>
{% endfor %}
{% block body %}{% endblock %}
</main>
</body>
</html>
