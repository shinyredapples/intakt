<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>{% block title %}Intakt{% endblock %}</title>
    <style>
        body { font-family: system-ui, sans-serif; margin: 2rem auto; max-width: 56rem; color: #1b1f24; }
        nav a { margin-right: 1rem; }
        table { border-collapse: collapse; width: 100%; }
        th, td { text-align: left; padding: .4rem .6rem; border-bottom: 1px solid #d0d7de; }
        .state-judged { color: #1a7f37; }
        .flash-success { color: #1a7f37; }
        .flash-error { color: #cf222e; }
        .state-running { color: #9a6700; }
    </style>
</head>
<body>
<nav>
    <a href="{{ path(constant('Intakt\\Core\\Dashboard\\Contract\\DashboardRoutes::LIST_PROJECTS')) }}">Projects</a>
    <a href="{{ path(constant('Intakt\\Core\\Dashboard\\Contract\\DashboardRoutes::LIST_REVIEWS')) }}">Reviews</a>
</nav>
<main>
{% for line in app.flashes('success') %}
<p class="flash flash-success">{{ line }}</p>
{% endfor %}
{% for line in app.flashes('error') %}
<p class="flash flash-error">{{ line }}</p>
{% endfor %}
{% block body %}{% endblock %}
</main>
</body>
</html>
