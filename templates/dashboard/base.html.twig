<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Intakt{% endblock %}</title>
    {# Runs before the first paint, so a stored or system dark theme never flashes light and a collapsed rail never flashes open; the shell script at the end of the body stores the keys it reads. #}
    <script>(() => {
        const root = document.documentElement;
        let theme = null;
        let rail = null;
        try {
            theme = localStorage.getItem('intakt-theme');
            rail = localStorage.getItem('intakt-rail');
        } catch {}
        root.dataset.theme = theme === 'light' || theme === 'dark' ? theme : (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        if (rail === 'collapsed') {
            root.dataset.rail = 'collapsed';
        }
    })();</script>
    <link rel="icon" type="image/png" href="{{ asset('images/favicon-32.png') }}">
    <link rel="stylesheet" href="{{ asset('styles/fonts.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/tokens.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/base.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/components.css') }}">
    {# Only a page the hub can reach is told to listen; the plain page shows the ledger's state either way. #}
    {% block importmap %}{% if live|default(false) %}{{ importmap('app') }}{% endif %}{% endblock %}
    {# Imported by their own address, not through the import map, so a danger button asks first and the search opens also on a page without one. After the import map, which a browser ignores once a module has started to load. #}
    <script type="module">import { holdBackDangerButtons } from '{{ asset('arm.js') }}'; import { offerSearch } from '{{ asset('search.js') }}'; holdBackDangerButtons(document); offerSearch(document);</script>
</head>
<body>
{# The connection controller runs only on a page that loads the import map, which is also the only kind of page with a live connection. #}
<div class="shell" data-controller="connection">
{# Only the items whose page is built; the others arrive with their page. History and Settings, once built, go under More, which a phone shows instead of them. #}
{{ include('dashboard/_rail.html.twig', {
    rail_items: [
        {key: 'projects', label: 'Projects', icon: 'projects', route: constant('Intakt\\Core\\Dashboard\\Contract\\DashboardRoutes::LIST_PROJECTS')},
    ],
    more_items: [],
    current_route: app.current_route,
}, with_context = false) }}
<div class="main">
{# One listener for the shell topic and the page's own. The cookie it sets also carries listener_grants, the same on every page, because every tab shares it. It sits here, not beside the rail, because any child of the shell takes a cell of its two-column grid. #}
{% if live|default(false) %}{% do mercure(null, {subscribe: listener_grants}) %}{{ turbo_stream_from([constant('Intakt\\Core\\Dashboard\\Contract\\DashboardTopics::SHELL')]|merge(topics|default([])), true) }}{% endif %}
<header class="topbar">
    <a class="brand-m" href="{{ path(constant('Intakt\\Core\\Dashboard\\Contract\\DashboardRoutes::OPEN_DASHBOARD')) }}" aria-label="Intakt home"><img class="logo-light" src="{{ asset('images/intakt-lockup.svg') }}" alt="Intakt"><img class="logo-dark" src="{{ asset('images/intakt-lockup-dark.svg') }}" alt="Intakt"></a>
    <button class="search-trigger" type="button" aria-haspopup="dialog" aria-controls="search" aria-keyshortcuts="Control+K Meta+K">{{ include('dashboard/components/icon.html.twig', {name: 'search'}, with_context = false) }}<span class="ph">Search tasks, pull requests, settings…</span><span class="ph-short">Search</span><kbd>Ctrl K</kbd></button>
    <div class="grow"></div>
    {# The empty value is All projects, because no project name is empty, while a project may be named "all". A page linked to one project marks it selected, and the script below prefers it to the stored choice. #}
    {{ include('dashboard/components/select.html.twig', {id: 'projfilter', name: 'project', aria_label: 'Project', selected: linked_project ?? '', options: [{value: '', label: 'All projects'}]|merge(filter_projects()|map(name => {value: name, label: name}))}, with_context = false) }}
    <button class="icon-btn theme-toggle" type="button" aria-label="Switch light or dark theme" data-theme-toggle>{{ include('dashboard/components/icon.html.twig', {name: 'moon', extra: 'moon'}, with_context = false) }}{{ include('dashboard/components/icon.html.twig', {name: 'sun', extra: 'sun'}, with_context = false) }}</button>
    {{ include('dashboard/components/offline.html.twig', {live: true}, with_context = false) }}
</header>
<main class="content">
{{ include('dashboard/components/connection.html.twig', {live: true}, with_context = false) }}
{% for line in app.flashes('success') %}
<p class="flash flash-success">{{ line }}</p>
{% endfor %}
{% for line in app.flashes('error') %}
<p class="flash flash-error">{{ line }}</p>
{% endfor %}
{% block body %}{% endblock %}
</main>
</div>
</div>
{# Outside the shell, because any child of it takes a cell of its grid, and because the search script makes the shell inert while this is open. assets/search.js opens it and fills the list box with the results fragment of the search route. #}
<div class="overlay" id="search" role="dialog" aria-modal="true" aria-label="Search" data-search-url="{{ path(constant('Intakt\\Core\\Dashboard\\Contract\\DashboardRoutes::SEARCH')) }}" hidden>
<div class="palette">
    <div class="q">{{ include('dashboard/components/icon.html.twig', {name: 'search'}, with_context = false) }}<input id="search-q" type="text" placeholder="Search tasks, pull requests, settings…" autocomplete="off" role="combobox" aria-label="Search" aria-autocomplete="list" aria-expanded="true" aria-controls="search-results"><kbd>Esc</kbd><button class="btn quiet" type="button" data-search-cancel>Cancel</button></div>
    <div class="results" id="search-results" role="listbox" aria-label="Results"></div>
    <footer><span><kbd>↑</kbd> <kbd>↓</kbd> move</span><span><kbd>Enter</kbd> open</span><span><kbd>Esc</kbd> close</span></footer>
</div>
</div>
{# Listens on the body, because Turbo replaces it on a visit and runs this script again, so no listener is left twice. #}
<script>(() => {
    const root = document.documentElement;
    const store = (key, value) => {
        try {
            localStorage.setItem(key, value);
        } catch {}
    };
    const railToggle = document.querySelector('[data-rail-toggle]');
    const search = document.querySelector('.search-trigger');
    const projectFilter = document.querySelector('#projfilter');
    const more = document.querySelector('[data-more-toggle]');
    const moreSheet = document.querySelector('[data-more-sheet]');
    // A phone's top bar has no project filter, so a choice it cannot show would hide rows with nothing to undo it.
    const phone = matchMedia('(max-width: 760px)');
    const read = (key) => {
        try {
            return localStorage.getItem(key);
        } catch {
            return null;
        }
    };
    const showProject = () => {
        const chosen = phone.matches ? '' : projectFilter.value;
        document.querySelectorAll('[data-project]').forEach((item) => {
            item.hidden = chosen !== '' && item.dataset.project !== chosen;
        });
        projectFilter.title = projectFilter.selectedOptions[0].textContent;
    };
    const showMore = (open) => {
        moreSheet.hidden = !open;
        more.setAttribute('aria-expanded', String(open));
    };
    const showRail = () => {
        const collapsed = root.dataset.rail === 'collapsed';
        railToggle.setAttribute('aria-expanded', String(!collapsed));
        railToggle.title = collapsed ? 'Expand menu' : 'Collapse menu';
    };

    showRail();
    railToggle.addEventListener('click', () => {
        if (root.dataset.rail === 'collapsed') {
            delete root.dataset.rail;
        } else {
            root.dataset.rail = 'collapsed';
        }
        store('intakt-rail', root.dataset.rail ?? 'open');
        showRail();
    });
    document.querySelectorAll('[data-theme-toggle]').forEach((toggle) => toggle.addEventListener('click', () => {
        root.dataset.theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
        store('intakt-theme', root.dataset.theme);
    }));
    // A project link (the option the server marked selected) is a choice and is kept like one. A stored project the install no longer lists falls back to All projects, so the select never hides rows under another name.
    const linkedProject = [...projectFilter.options].find((option) => option.defaultSelected && option.value !== '');
    const storedProject = read('intakt-project');
    if (linkedProject) {
        // Set as well as stored, so the shown and the stored choice are one even if a page marked more than one option.
        projectFilter.value = linkedProject.value;
        store('intakt-project', linkedProject.value);
    } else if ([...projectFilter.options].some((option) => option.value === storedProject)) {
        projectFilter.value = storedProject;
    }
    showProject();
    // The width outlives the body Turbo replaces, so the listener of a page left behind does nothing.
    phone.addEventListener('change', () => {
        if (projectFilter.isConnected) {
            showProject();
        }
    });
    // Turbo appends a stream to the document element, so only the document sees it; a page left behind does nothing.
    document.addEventListener('turbo:before-stream-render', (event) => {
        if (event.target.getAttribute('target') !== 'projfilter' || !projectFilter.isConnected) {
            return;
        }
        const render = event.detail.render;
        // The pushed options carry no choice, so this tab's own is put back unless the project is gone; it is never stored, because only the person's own pick is.
        event.detail.render = (stream) => {
            const chosen = projectFilter.value;
            render(stream);
            projectFilter.value = [...projectFilter.options].some((option) => option.value === chosen) ? chosen : '';
            showProject();
        };
    });
    if (more) {
        more.addEventListener('click', () => showMore(moreSheet.hidden));
        // A tap beside the sheet's pages lands on its backdrop.
        moreSheet.addEventListener('click', (event) => {
            if (event.target === moreSheet) {
                showMore(false);
            }
        });
    }
    projectFilter.addEventListener('change', () => {
        store('intakt-project', projectFilter.value);
        showProject();
        // Otherwise a reload would choose the linked project again; the state is kept because Turbo keeps its own there.
        const address = new URL(location.href);
        if (address.searchParams.has('project')) {
            address.searchParams.delete('project');
            history.replaceState(history.state, '', address);
        }
    });
    if (/Mac|iPhone|iPad/.test(navigator.platform)) {
        search.querySelector('kbd').textContent = '⌘K';
    }
    document.body.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && more && !moreSheet.hidden) {
            showMore(false);
            more.focus();
        }
    });
})();</script>
</body>
</html>
