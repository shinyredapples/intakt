{# FrankenPHP sets this only under hot_reload, which only the development Caddyfile (docker/dev/Caddyfile) declares; a watched file's change then reloads the page. A plain EventSource, so the page loads nothing from outside. #}
{% set hot_reload = app.request ? app.request.server.get('FRANKENPHP_HOT_RELOAD') : null %}
{% if hot_reload %}<meta name="frankenphp-hot-reload:url" content="{{ hot_reload }}">
<script>new EventSource(document.querySelector('meta[name="frankenphp-hot-reload:url"]').content).onmessage = () => location.reload();</script>{% endif %}
