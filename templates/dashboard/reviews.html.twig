{% extends 'dashboard/base.html.twig' %}

{% block title %}Reviews - Intakt{% endblock %}

{# A project link from the Projects page makes this its project's list, so the rail keeps Projects current (decision D3 of #2184); "0" is a project name, so emptiness is tested, not truth. project_trail is the linked project only when the install lists it, and the shell drops the breadcrumb and the mark once the filter shows another. #}
{% set rail_section = project_trail is not empty ? 'projects' : null %}

{% block body %}
{% if project_trail is not empty %}
{{ include('dashboard/components/breadcrumb.html.twig', {crumbs: [
    {label: 'Projects', href: path(constant('Intakt\\Core\\Dashboard\\Contract\\DashboardRoutes::LIST_PROJECTS'))},
    {label: project_trail},
], project_trail: project_trail}, with_context = false) }}
{% endif %}
<div class="page-head">
    <div>
        <h1>Reviews</h1>
        <p class="lead">Every review round, newest first. Open a round to see its review.</p>
    </div>
</div>
{% if forge_budgets is not empty %}
<section class="section forge-budgets">
<h2>Forge budget this hour</h2>
<div class="table-scroll" tabindex="0" role="region" aria-label="Forge budget this hour">
<table class="ledger">
    <thead><tr><th>Installation</th><th>Calls used</th><th>Calls remaining</th><th>Forge reserve</th></tr></thead>
    <tbody>
    {% for budget in forge_budgets %}
        <tr data-installation="{{ budget.installation }}">
            <td class="mono">{{ budget.installation }}</td>
        {% if budget.read %}
            <td class="num">{{ budget.used }}</td>
            <td class="num">{{ budget.remaining }}</td>
            <td>{{ budget.reserveInForce
                ? include('dashboard/components/chip.html.twig', {icon: 'clock', label: 'In force: routine reads wait', on_page: true, extra: 'reserve-in-force'}, with_context = false)
                : include('dashboard/components/chip.html.twig', {dot: 'ok', label: 'Not in force', on_page: true, extra: 'reserve-idle'}, with_context = false) }}</td>
        {% else %}
            <td colspan="3" class="unread">No reading this hour</td>
        {% endif %}
        </tr>
    {% endfor %}
    </tbody>
</table>
</div>
</section>
{% endif %}
{% if failing is not empty %}
<section class="section failing-heads" id="failing-heads">
<h2>Pull requests that failed</h2>
<div class="cards">
{% for head in failing %}
    <article data-project="{{ head.project }}">
        {{ include('dashboard/components/card.html.twig', {
            number: head.change,
            project: head.project,
            title: 'Pull request ' ~ head.change ~ ': ' ~ (head.handedOver ? 'handed over to the maintainer agent' : 'backing off'),
            emphasis: {icon: 'broken', text: head.fault.cause, broken: true},
            meta: [
                {icon: 'broken', text: head.fault.failures ~ (head.fault.failures == 1 ? ' failure' : ' failures') ~ ' in a row'},
                {icon: 'clock', text: 'Next try ' ~ head.fault.retryAt|date('Y-m-d H:i:s', 'UTC') ~ ' UTC'},
            ],
        }, with_context = false) }}
    </article>
{% endfor %}
</div>
{{ include('dashboard/_project_empty.html.twig', {text: 'No failed pull request for this project'}, with_context = false) }}
</section>
{% endif %}
{% if reviews is empty %}
{{ include('dashboard/components/empty.html.twig', {title: 'No reviews yet', text: 'No review has started yet.', pose: enum('Intakt\\Core\\Dashboard\\Domain\\MascotPose').Waiting}, with_context = false) }}
{% else %}
<section class="section">
<ol class="review-rows" aria-label="Review rounds">
{% for row in reviews %}
    {% set review = row.review %}
    <li class="review-row" data-project="{{ review.project }}">
        <a class="review-link" href="{{ path(constant('Intakt\\Core\\Dashboard\\Contract\\DashboardRoutes::SHOW_REVIEW'), {round: review.round}) }}">
            {# The outcome leads the row, because it is what the reader scans the list for; the process state stays among the facts (decision D1 of #2186). #}
            {% if review.outcome is not null %}<span class="review-outcome">{{ include('dashboard/components/outcome_chip.html.twig', {outcome: review.outcome, on_page: true}, with_context = false) }}</span>{% endif %}
            <span class="review-title">{{ row.review.title }}</span>
            <span class="review-facts">
                <span class="pname">{{ review.project }}</span>
                {% if review.outcome is null %}{{ include('dashboard/_round_state.html.twig', {state: review.state}, with_context = false) }}{% endif %}
                {% if review.findingCount is not null %}<span class="findings">{{ review.findingCount }} {{ review.findingCount == 1 ? 'finding' : 'findings' }}</span>{% endif %}
                <span class="reviewers">{{ review.reviewers }} {{ review.reviewers == 1 ? 'reviewer' : 'reviewers' }}</span>
                <time datetime="{{ review.startedAt|date('c', 'UTC') }}" title="{{ review.startedAt|date('Y-m-d H:i:s', 'UTC') }} UTC">{{ row.startedAgo }}</time>
            </span>
        </a>
        <p class="round-id">Round id <code>{{ review.round }}</code></p>
    </li>
{% endfor %}
</ol>
{{ include('dashboard/_project_empty.html.twig', {text: 'No review for this project yet'}, with_context = false) }}
</section>
{% endif %}
{% endblock %}
