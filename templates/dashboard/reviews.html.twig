{% extends 'dashboard/base.html.twig' %}

{% block title %}Reviews - Intakt{% endblock %}

{% block body %}
<div class="page-head">
    <div>
        <h1>Reviews</h1>
        <p class="lead">Every review round, newest first. Open a round to see its review.</p>
    </div>
</div>
{% if failing is not empty %}
<section class="section failing-heads">
<h2>Pull requests that failed</h2>
<div class="cards">
{% for head in failing %}
    <article data-project="{{ head.project }}">
        {{ include('dashboard/components/card.html.twig', {
            number: head.change,
            project: head.project,
            title: 'Pull request ' ~ head.change ~ ': ' ~ (head.handedOver ? 'handed over to the maintainer agent' : 'backing off'),
            emphasis: {icon: 'broken', text: head.fault.cause, broken: true},
            meta: [
                {icon: 'broken', text: head.fault.failures ~ (head.fault.failures == 1 ? ' failure' : ' failures') ~ ' in a row'},
                {icon: 'clock', text: 'Next try ' ~ head.fault.retryAt|date('Y-m-d H:i:s', 'UTC') ~ ' UTC'},
            ],
        }, with_context = false) }}
    </article>
{% endfor %}
</div>
</section>
{% endif %}
{% if reviews is empty %}
{{ include('dashboard/components/empty.html.twig', {title: 'No reviews yet', text: 'No review has started yet.'}, with_context = false) }}
{% else %}
<section class="section">
<div class="table-scroll">
<table class="ledger">
    <thead><tr><th>Round</th><th>Project</th><th>Reviewers</th><th>Started (UTC)</th><th>State</th></tr></thead>
    <tbody>
    {% for review in reviews %}
        <tr data-project="{{ review.project }}">
            <td class="mono"><a href="{{ path(constant('Intakt\\Core\\Dashboard\\Contract\\DashboardRoutes::SHOW_REVIEW'), {round: review.round}) }}">{{ review.round }}</a></td>
            <td>{{ review.project }}</td>
            <td class="num">{{ review.reviewers }}</td>
            <td class="when">{{ review.startedAt|date('Y-m-d H:i:s', 'UTC') }}</td>
            <td>{{ include('dashboard/_round_state.html.twig', {state: review.state}, with_context = false) }}</td>
        </tr>
    {% endfor %}
    </tbody>
</table>
</div>
</section>
{% endif %}
{% endblock %}
