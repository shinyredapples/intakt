{#- Its own partial, because the judged round's live update replaces it with the same markup a reload renders. -#}
<div class="table-scroll" id="round-{{ reviewed.round }}-tokens" tabindex="0" role="region" aria-label="Tokens and cost of round {{ reviewed.round }}">
<table class="ledger tokens">
    {#- One label for the table, on the cost, because the token counts are the provider's own figures and the cost is the one figure Intakt works out (decision D5 of #2206). An unknown cost has no figure to label. An older round's table goes without, and the judged round's live update is the newest round's, so it keeps the label. -#}
    <thead><tr><th class="num">Prompt</th><th class="num">Cache read</th><th class="num">Cache write</th><th class="num">Cached</th><th class="num">Completion</th><th class="num">Total</th><th>Cost{% if (labeled ?? true) and reviewed.cost.usd is not null %} {{ include('dashboard/components/figure_kind.html.twig', {kind: enum('Intakt\\Core\\Platform\\Contract\\FigureKind').Estimated, at: 'round-' ~ reviewed.round ~ '-cost'}, with_context = false) }}{% endif %}</th></tr></thead>
    <tbody>
        <tr>
            {#- Each cell names its column, so a phone stacks the figures under their labels instead of cutting the table (#3133). -#}
            {% for label, tokens in {'Prompt': reviewed.tokens.prompt, 'Cache read': reviewed.tokens.cacheRead, 'Cache write': reviewed.tokens.cacheWrite, 'Cached': reviewed.tokens.cached, 'Completion': reviewed.tokens.completion, 'Total': reviewed.tokens.total} %}
            <td class="num" data-label="{{ label }}">{{ tokens }}</td>
            {% endfor %}
            <td data-label="Cost">{{ include('dashboard/components/cost_plain.html.twig', {cost: reviewed.cost}, with_context = false) }}</td>
        </tr>
    </tbody>
</table>
</div>
