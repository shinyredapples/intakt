{#- The answer of the latest pass in plain words, with the owl that judged it (its 48 px images shown at 96 px by the stylesheet, from their double), because an older pass's verdict was given on an older head; the count is of the last judged pass's findings to fix, which the To fix cards below show one card each. The judged round's live update replaces it by its id. -#}
{%- set outcomes = enum('Intakt\\Core\\Dashboard\\Domain\\ReviewOutcome') -%}
{%- set outcome = latest.reviewOutcome -%}
{%- set needs = outcome is same as(outcomes.ChangesRequested) -%}
{%- set urgent = open|filter(f => f.urgency is same as(enum('Intakt\\Core\\Dashboard\\Domain\\FindingUrgency').Urgent))|length -%}
<section class="verdict-card{% if needs %} needs{% elseif outcome is same as(outcomes.Approved) %} good{% endif %}" id="review-verdict" data-round="{{ latest.round }}" aria-labelledby="verdict-title">
    {{ include('dashboard/components/character.html.twig', {character: constant('Intakt\\Core\\Dashboard\\Domain\\Character::Judge'), size: 48}, with_context = false) }}
    <div class="verdict-text">
        <p class="kicker">{{ latest.number is null ? 'Pass' : 'Pass ' ~ latest.number }}{% if latest.isJudged %} · Checked{% endif %}
            {%- if latest.isReplay %} {{ include('dashboard/components/chip.html.twig', {label: 'Replay', on_page: true, extra: 'verdict-replay'}, with_context = false) }}{% endif -%}
        </p>
        <h2 class="verdict-words" id="verdict-title">
            {%- if outcome is same as(outcomes.Approved) -%}
            Approved
            {%- elseif needs -%}
            Changes needed
            {%- elseif outcome is same as(outcomes.Blocked) -%}
            Blocked: {{ latest.ending.reason ?? 'the reviewers could not give a verdict on this change' }}
            {%- elseif outcome is same as(outcomes.Failed) -%}
            Failed: {{ latest.ending.reason ?? 'every reviewer failed, so nobody checked this change' }}
            {%- else -%}
            Checked, but the outcome was not recorded
            {%- endif -%}
        </h2>
        {#- Both numbers on every judged pass, zeros included, so an Approved pass reads 0 to fix; a pass that ended without a verdict has no count to give. #}
        {% if latest.isJudged %}
        <p class="verdict-count"><span class="figure">{{ open|length }} to fix</span> · {{ urgent }} urgent</p>
        {% endif %}
    </div>
</section>
