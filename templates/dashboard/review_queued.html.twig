{% extends 'dashboard/base.html.twig' %}

{% block title %}Review of {{ queued.title|lower }} - Intakt{% endblock %}

{# A queued round belongs to a project as any review does, so the rail keeps Projects current (decision D3 of #2184). #}
{% set rail_section = 'projects' %}

{% block body %}
{{ include('dashboard/components/breadcrumb.html.twig', {crumbs: [
    {label: 'Projects', href: path(constant('Intakt\\Core\\Dashboard\\Contract\\DashboardRoutes::LIST_PROJECTS'))},
    {label: queued.project, href: path(constant('Intakt\\Core\\Dashboard\\Contract\\DashboardRoutes::LIST_REVIEWS'), {project: queued.project})},
    {label: queued.title},
]}, with_context = false) }}
<div class="page-head">
    <div>
        <h1>Review of {{ queued.title|lower }} in {{ queued.project }}</h1>
        <p class="queued muted">Waiting to start: the watcher queued this round and no worker has started it yet.</p>
        <p class="muted">Reload this page once a worker starts it to follow its reviewers.</p>
    </div>
</div>
{% endblock %}
