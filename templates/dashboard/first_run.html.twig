{% extends 'dashboard/base.html.twig' %}

{% block title %}Set up - Intakt{% endblock %}

{% block content_width %} wide{% endblock %}

{% block body %}
{%- set titles = ['AI providers', 'A project', 'First review', 'Your own agent'] -%}
{%- set states = first_run.states -%}
<div class="setup">
    <div class="page-head">
        {{ include('dashboard/components/character.html.twig', {character: first_run.firstReview.mascot, size: 144}, with_context = false) }}
        <div>
            <h1>Set up Intakt</h1>
        </div>
    </div>
    {{ include('dashboard/_review_strip.html.twig', with_context = false) }}
    {%- set demo_ready = demo is same as(constant('Intakt\\Core\\Dashboard\\UseCase\\PlayDemo\\DemoReadiness::Ready')) %}
    {#- With a recording ready, watching it is the one primary action: a juror without a key needs only that button. -#}
    {%- set step_button = demo_ready ? 'secondary' : 'primary' %}
    {%- if demo_ready and first_run.choices is null %}
    <div class="play-demo-offer step-nav">
        {{ _self.play_demo() }}
        {{ _self.no_key() }}
    </div>
    {%- endif %}

    {%- set choices = first_run.choices %}
    {%- if choices is not null %}
    <section class="step choices" id="demo-choices" aria-labelledby="demo-choices-h">
        <h2 id="demo-choices-h">See a review</h2>
        <div class="choice" id="choice-recorded">
            <h3>Watch a recorded review</h3>
            {%- if demo_ready %}
            <div class="demo-play">{{ _self.play_demo() }}{{ _self.no_key() }}</div>
            {%- else %}
            <p class="recorded-when">{{ demo.sentence }}</p>
            {%- endif %}
        </div>
        <div class="choice" id="choice-live">
            <h3>Run it live with your key</h3>
            <p class="next">{{ choices.liveReviewNext }}</p>
        </div>
    </section>
    {%- endif %}

    {#- After the ways to see a review, so a visitor without a key meets Play before the setup steps. -#}
    <ol class="steps" aria-label="Setup progress">
        {%- for title in titles %}
        {%- if loop.index0 === first_run.current %}
        <li class="{{ states[loop.index0].value }} current" aria-current="step">{{ loop.index }} {{ title }}</li>
        {%- else %}
        <li class="{{ states[loop.index0].value }}">{{ loop.index }} {{ title }}</li>
        {%- endif %}
        {%- endfor %}
    </ol>
    <p class="step-count">{{ first_run.done }} of {{ first_run.needed }} steps done</p>

    {%- set step = first_run.providers %}
    <section class="step" id="step-providers" data-state="{{ step.state.value }}" aria-labelledby="step-providers-h">
        <h2 id="step-providers-h">1 {{ titles[0] }} {{ _self.state(step.state) }}</h2>
        <p class="lead">{{ step.sentence }}</p>
        {%- if step.offersKeyForm %}
        <form method="post" action="{{ path(constant('Intakt\\Core\\Dashboard\\Contract\\DashboardRoutes::KEEP_PROVIDER_KEY')) }}" class="keep-provider-key step-nav">
            <input type="hidden" name="_token" value="{{ csrf_token(constant('Intakt\\Core\\Dashboard\\UseCase\\KeepProviderKey\\KeepProviderKeyController::TOKEN_ID')) }}">
            <label for="provider-key">A key or token for {{ step.keyLabels|join(', ', ' or ') }}</label>
            <input type="password" id="provider-key" name="{{ constant('Intakt\\Core\\Dashboard\\UseCase\\KeepProviderKey\\KeepProviderKeyController::FIELD') }}" autocomplete="off" required>
            {{ include('dashboard/components/button.html.twig', {kind: step_button, type: 'submit', label: 'Keep the key'}, with_context = false) }}
        </form>
        {%- endif %}
        {%- if step.keyless is not empty or step.firstProject is not null %}
        {#- Closed, because which providers lack a key and which model each tier uses matter only to someone setting up a key. -#}
        <details class="step-details">
            <summary>Providers and tiers</summary>
        {%- if step.keyless is not empty %}
        <ul class="keyless">
            {%- for message in step.keyless %}
            <li>{{ message }}</li>
            {%- endfor %}
        </ul>
        {%- endif %}
        {%- if step.firstProject is not null %}
        <p class="tiers-of">The tiers of the project {{ step.firstProject }}:</p>
        <table class="ledger tiers">
            <thead><tr><th scope="col">Tier</th><th scope="col">Provider</th><th scope="col">Model or problem</th></tr></thead>
            <tbody>
                {%- for line in step.tiers %}
                <tr><td>{{ line.tier }}</td><td>{{ line.provider }}</td><td>{{ line.modelOrProblem }}</td></tr>
                {%- endfor %}
            </tbody>
        </table>
        {%- endif %}
        </details>
        {%- endif %}
    </section>

    {%- set step = first_run.project %}
    <section class="step" id="step-project" data-state="{{ step.state.value }}" aria-labelledby="step-project-h">
        <h2 id="step-project-h">2 {{ titles[1] }} {{ _self.state(step.state) }}</h2>
        <p class="lead">{{ step.sentence }}</p>
        {%- if step.panels is not empty %}
        <div class="list">
            {%- for panel in step.panels %}
            {{ include('dashboard/components/list_row.html.twig', {title: panel.project, explanation: panel.description}, with_context = false) }}
            {%- endfor %}
        </div>
        {%- endif %}
    </section>

    {%- set step = first_run.firstReview %}
    <section class="step" id="step-first-review" data-state="{{ step.state.value }}" aria-labelledby="step-first-review-h">
        <h2 id="step-first-review-h">3 {{ titles[2] }} {{ _self.state(step.state) }}</h2>
        <p class="lead">{{ step.sentence }}</p>
        {%- if step.round is not null %}
        <div class="step-nav">
            <a class="btn {{ step_button }}" href="{{ path(constant('Intakt\\Core\\Dashboard\\Contract\\DashboardRoutes::SHOW_REVIEW'), {round: step.round}) }}">Open the review</a>
        </div>
        {%- elseif step.sampleCanStart %}
        <form method="post" action="{{ path(constant('Intakt\\Core\\Dashboard\\Contract\\DashboardRoutes::START_FIRST_REVIEW')) }}" class="start-first-review step-nav">
            <input type="hidden" name="_token" value="{{ csrf_token(constant('Intakt\\Core\\Dashboard\\UseCase\\StartReview\\StartFirstReviewController::TOKEN_ID')) }}">
            {{ include('dashboard/components/button.html.twig', {kind: step_button, type: 'submit', label: 'Start the first review'}, with_context = false) }}
        </form>
        {%- endif %}
    </section>

    {%- set step = first_run.agent %}
    <section class="step" id="step-agent" data-state="{{ step.state.value }}" aria-labelledby="step-agent-h">
        <h2 id="step-agent-h">4 {{ titles[3] }} {{ _self.state(step.state) }}</h2>
        <p class="lead">{{ step.sentence }}</p>
        <p>The MCP address: <code class="mono address">{{ step.address }}</code></p>
        <p>The client line for Claude Code:</p>
        <pre class="command"><code class="client-line">{{ step.clientLine }}</code></pre>
        {%- if step.hasToken %}
        {%- if step.tokenCommand is not null %}
        <p class="token-from">This command prints the line with the token filled in:</p>
        <pre class="command"><code class="token-command">{{ step.tokenCommand }}</code></pre>
        {%- else %}
        <p class="token-from">Replace &lt;the token&gt; with the value of MCP_OWNER_TOKEN.</p>
        {%- endif %}
        {%- endif %}
    </section>
</div>
{% endblock %}

{% macro state(state) -%}
{{ include('dashboard/components/chip.html.twig', {label: state.words, dot: state.dot, on_page: true}, with_context = false) }}
{%- endmacro %}

{#- The page's one primary button whenever it is offered, because a juror without a key needs only this. -#}
{% macro play_demo() -%}
<form method="post" action="{{ path(constant('Intakt\\Core\\Dashboard\\Contract\\DashboardRoutes::PLAY_DEMO')) }}" class="play-demo">
    <input type="hidden" name="_token" value="{{ csrf_token(constant('Intakt\\Core\\Dashboard\\UseCase\\PlayDemo\\PlayDemoController::TOKEN_ID')) }}">
    {{ include('dashboard/components/button.html.twig', {kind: 'primary', type: 'submit', label: 'Play the demo run'}, with_context = false) }}
</form>
{%- endmacro %}

{% macro no_key() -%}
{{ include('dashboard/components/chip.html.twig', {label: 'No key needed', icon: 'check', on_page: true}, with_context = false) }}
{%- endmacro %}
