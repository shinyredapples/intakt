{% extends 'dashboard/base.html.twig' %}

{% block title %}Waiting on you - Intakt{% endblock %}

{# The same project trail as Reviews, but no rail section: this page has its own rail entry, so Projects is not marked current beside it. The notices on this page belong to no project, so no filter hides them. #}
{% block body %}
{% if project_trail is not empty %}
{{ include('dashboard/components/breadcrumb.html.twig', {crumbs: [
    {label: 'Projects', href: path(constant('Intakt\\Core\\Dashboard\\Contract\\DashboardRoutes::LIST_PROJECTS'))},
    {label: project_trail},
], project_trail: project_trail, current: false}, with_context = false) }}
{% endif %}
{% if items is empty %}
<div class="page-head">
    <div>
        <h1>Waiting on you</h1>
        <p class="lead">Things only you can do show up here, oldest first.</p>
    </div>
</div>
{{ include('dashboard/components/empty.html.twig', {title: 'Nothing needs you', text: 'Intakt keeps building and reviewing. When it needs a decision, it shows up here.', pose: enum('Intakt\\Core\\Dashboard\\Domain\\MascotPose').Waiting}, with_context = false) }}
{% else %}
{# The octopus conducts once, at the top; each card shows the role who waits on the owner. No Why and no command to copy: the card says what needs you and what one tap does. #}
<div class="wait-hero needs">
    {{ include('dashboard/components/character.html.twig', {character: enum('Intakt\\Core\\Dashboard\\Domain\\MascotPose').Waiting, size: 96}, with_context = false) }}
    <div>
        <p class="wait-kicker">Waiting on you</p>
        <h1>{{ items|length == 1 ? '1 thing needs you' : items|length ~ ' things need you' }}</h1>
        <p class="lead">Everything else keeps running. Oldest first.</p>
    </div>
</div>
<div class="wait-list">
{% for item in items %}
<article class="wait-item needs" aria-labelledby="wait-{{ loop.index }}">
    {{ include('dashboard/components/character.html.twig', {character: item.character, size: 48}, with_context = false) }}
    <h2 class="wait-lead" id="wait-{{ loop.index }}">{{ item.lead }}</h2>
    {{ include('dashboard/components/meta.html.twig', {facts: [
        {text: item.character.label},
        {text: 'All projects'},
        {icon: 'clock', text: item.waitingFor(now)},
    ]}, with_context = false) }}
    <p class="conseq">{{ item.consequence }}</p>
    <div class="wait-acts">
        <a class="wait-act primary" href="{{ item.link ?? path(constant('Intakt\\Core\\Dashboard\\Contract\\DashboardRoutes::SHOW_BOARD'), {board: 1}) }}">{{ include('dashboard/components/icon.html.twig', {name: item.link is null ? 'board' : 'link'}, with_context = false) }}<span><b>{{ item.linkLabel }}</b><small>{{ item.linkOutcome }}</small></span></a>
    </div>
</article>
{% endfor %}
</div>
{% endif %}
{% endblock %}
