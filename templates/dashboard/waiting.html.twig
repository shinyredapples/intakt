{% extends 'dashboard/base.html.twig' %}

{% block title %}Waiting on you - Intakt{% endblock %}

{# The same project trail as Reviews, but no rail section: this page has its own rail entry, so Projects is not marked current beside it. The notices on this page belong to no project, so no filter hides them. #}
{% block body %}
{% if project_trail is not empty %}
{{ include('dashboard/components/breadcrumb.html.twig', {crumbs: [
    {label: 'Projects', href: path(constant('Intakt\\Core\\Dashboard\\Contract\\DashboardRoutes::LIST_PROJECTS'))},
    {label: project_trail},
], project_trail: project_trail}, with_context = false) }}
{% endif %}
<div class="page-head">
    <div>
        <h1>Waiting on you</h1>
        <p class="lead">{% if items is empty %}Things only you can do show up here, oldest first.{% else %}{{ items|length == 1 ? 'One thing' : items|length ~ ' things' }} only you can do, oldest first. Everything else keeps running while {{ items|length == 1 ? 'it waits' : 'these wait' }}.{% endif %}</p>
    </div>
</div>
{% if items is empty %}
{{ include('dashboard/components/empty.html.twig', {title: 'Nothing needs you', text: 'Intakt keeps building and reviewing. When it needs a decision, it shows up here.', pose: enum('Intakt\\Core\\Dashboard\\Domain\\MascotPose').Waiting}, with_context = false) }}
{% else %}
<div class="wait-list">
{% for item in items %}
<article class="wait-item" aria-labelledby="wait-{{ loop.index }}">
    <h2 class="wait-lead" id="wait-{{ loop.index }}"><span class="dot needs"></span>{{ item.lead }}</h2>
    {{ include('dashboard/components/meta.html.twig', {facts: [
        {text: 'All projects'},
        {icon: 'clock', text: item.waitingFor(now)},
    ]}, with_context = false) }}
    <p class="conseq">{{ item.consequence }}</p>
    {# Closed, the phone's form; `copy-command.js` opens it on a wide screen. Before the choices, so Tab reaches it before Copy and the link (D6). #}
    <details class="why"><summary>Why</summary>
        <p>{{ item.why }}</p>
    </details>
    <ul class="act" aria-label="Your choices">
    {% for choice in item.choices %}
        <li>
            {% if choice.recommended %}<span class="recommended">Recommended</span>{% endif %}
            {% if choice.command is not null %}{{ include('dashboard/components/copy.html.twig', {text: choice.command}, with_context = false) }}{% endif %}
            <span class="outcome">{{ choice.outcome }}</span>
        </li>
    {% endfor %}
        <li><a class="btn secondary sm" href="{{ item.link ?? path(constant('Intakt\\Core\\Dashboard\\Contract\\DashboardRoutes::SHOW_BOARD')) }}">{{ item.linkLabel }}</a></li>
    </ul>
</article>
{% endfor %}
</div>
{% endif %}
{% endblock %}
