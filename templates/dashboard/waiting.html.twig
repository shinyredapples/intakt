{% extends 'dashboard/base.html.twig' %}

{% block title %}Waiting on you - Intakt{% endblock %}

{# Roomy, because DESIGN.md's split page grows to 1720 px from 1500 px with the panels beside the list. #}
{% block content_width %} roomy{% endblock %}

{# The same project trail as Reviews, but no rail section: this page has its own rail entry, so Projects is not marked current beside it. The notices on this page belong to no project, so no filter hides them. #}
{% block body %}
{% if project_trail is not empty %}
{{ include('dashboard/components/breadcrumb.html.twig', {crumbs: [
    {label: 'Projects', href: path(constant('Intakt\\Core\\Dashboard\\Contract\\DashboardRoutes::LIST_PROJECTS'))},
    {label: project_trail},
], project_trail: project_trail, current: false}, with_context = false) }}
{% endif %}
<div class="page-head">
    <div>
        <h1>Waiting on you</h1>
        <p class="lead" id="waiting-lead">{{ include('dashboard/_waiting_lead.html.twig', {items: page.items}, with_context = false) }}</p>
    </div>
</div>
{# The list before the panels, so a phone shows it first and the keyboard reaches the items before the panels. #}
<div class="split">
{{ include('dashboard/_waiting_list.html.twig', {items: page.items, now: now}, with_context = false) }}
{{ include('dashboard/_waiting_side.html.twig', {page: page, now: now}, with_context = false) }}
</div>
{% endblock %}
