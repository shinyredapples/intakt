{% extends 'dashboard/base.html.twig' %}

{% block title %}Projects - Intakt{% endblock %}

{% block body %}
<div class="page-head">
    <div>
        <h1>Projects</h1>
        <p class="lead">Every project at a glance: what it works on now, what it has used, and what waits on you.</p>
    </div>
    {# The board links the first-run page until a review has run, and the link moves here once a project has a card (#2067, D3). #}
    {% if projects is not empty %}
    <div class="actions">
        <a class="btn secondary" href="{{ path(constant('Intakt\\Core\\Dashboard\\Contract\\DashboardRoutes::FIRST_RUN')) }}">Set up Intakt</a>
    </div>
    {% endif %}
</div>
{{ include('dashboard/_project_cards.html.twig', {projects: projects}, with_context = false) }}
{% endblock %}
