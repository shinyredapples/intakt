{% extends 'dashboard/base.html.twig' %}

{% block title %}Projects - Intakt{% endblock %}

{% block body %}
<div class="page-head">
    <div>
        <h1>Projects</h1>
        <p class="lead">Every project that has started a review. Open one to see its reviews.</p>
    </div>
    {# The board links the setup wizard until a review has run, and a project is listed only once one has, so the link moves here then (#2067, D3); later projects are added from here (mock projects.html), while an empty list keeps setup as its one way on. #}
    {% if projects is not empty %}
    <div class="actions">
        <a class="btn secondary" href="{{ path(constant('Intakt\\Core\\Dashboard\\Contract\\DashboardRoutes::RUN_SETUP')) }}">Set up Intakt</a>
        <a class="btn primary" href="{{ path(constant('Intakt\\Core\\Dashboard\\Contract\\DashboardRoutes::ADD_PROJECT')) }}">Add a project</a>
    </div>
    {% endif %}
</div>
{% if projects is empty %}
{{ include('dashboard/components/empty.html.twig', {title: 'No projects yet', text: 'No project has started a review yet.', action: {href: path(constant('Intakt\\Core\\Dashboard\\Contract\\DashboardRoutes::RUN_SETUP')), label: 'Set up Intakt'}}, with_context = false) }}
{% else %}
<div class="list">
    {% for project in projects %}
    <div data-project="{{ project.name }}">
        {{ include('dashboard/components/list_row.html.twig', {
            title: project.name,
            href: path(constant('Intakt\\Core\\Dashboard\\Contract\\DashboardRoutes::LIST_REVIEWS'), {project: project.name}),
            explanation: project.rounds ~ (project.rounds == 1 ? ' review round, ' : ' review rounds, ') ~ project.judgedRounds ~ ' judged.',
        }, with_context = false) }}
    </div>
    {% endfor %}
</div>
{% endif %}
{% endblock %}
