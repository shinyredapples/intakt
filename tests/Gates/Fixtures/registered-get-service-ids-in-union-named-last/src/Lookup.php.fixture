<?php

declare(strict_types=1);

namespace Fixture;

use Symfony\Component\DependencyInjection\ContainerInterface;

final readonly class Lookup
{
    public function __construct(private ContainerInterface $container)
    {
    }

    public function kernel(int $choice): object
    {
        $id = 0 === $choice ? 'kernel' : 'service_container';

        return $this->container->get(invalidBehavior: ContainerInterface::EXCEPTION_ON_INVALID_REFERENCE, id: $id);
    }
}
