<?php

declare(strict_types=1);

namespace Intakt\Sample;

use Intakt\Core\Review\Contract\ReviewerConversation;
use Symfony\Component\Uid\UuidV7;

final readonly class RetryingVendor
{
    public function askedAgain(string $rolePrompt): ReviewerConversation
    {
        return new ReviewerConversation($rolePrompt, new UuidV7());
    }
}
