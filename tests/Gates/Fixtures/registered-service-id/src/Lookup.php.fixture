<?php

declare(strict_types=1);

namespace Fixture;

use Symfony\Component\DependencyInjection\ContainerInterface;

final readonly class Lookup
{
    /**
     * Takes the container per call, because a container in the constructor is
     * a service locator that intakt.noServiceLocator refuses in src/.
     */
    public function mailer(ContainerInterface $container): object
    {
        return $container->get('fixture.mailer');
    }
}
