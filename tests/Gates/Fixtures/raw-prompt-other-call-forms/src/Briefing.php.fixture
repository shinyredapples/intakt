<?php

declare(strict_types=1);

namespace Intakt\Sample;

use Closure;
use Symfony\AI\Platform\Message as Messages;
use Symfony\AI\Platform\Message\Message as Msg;
use Symfony\AI\Platform\Message\SystemMessage;
use Symfony\AI\Platform\Message\UserMessage;

final readonly class Briefing
{
    public function aliased(string $issueText): UserMessage
    {
        return Msg::ofUser($issueText);
    }

    public function throughTheNamespace(string $role): SystemMessage
    {
        return new Messages\SystemMessage($role);
    }

    public function firstClassCallable(): Closure
    {
        return Msg::ofUser(...);
    }

    public function fromAClassString(string $issueText): UserMessage
    {
        $messages = Msg::class;

        return $messages::ofUser($issueText);
    }

    public function constructedFromAClassString(string $role): SystemMessage
    {
        $message = SystemMessage::class;

        return new $message($role);
    }

    public function withADifferentCase(string $issueText): UserMessage
    {
        return Msg::OFUSER($issueText);
    }
}
