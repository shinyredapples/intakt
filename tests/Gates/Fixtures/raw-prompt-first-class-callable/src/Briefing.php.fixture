<?php

declare(strict_types=1);

namespace Intakt\Sample;

use Closure;
use Symfony\AI\Platform\Message\Message;

final readonly class Briefing
{
    public function messageFactory(): Closure
    {
        return Message::ofUser(...);
    }

    public function otherCallable(): Closure
    {
        return Message::ofToolCall(...);
    }
}
