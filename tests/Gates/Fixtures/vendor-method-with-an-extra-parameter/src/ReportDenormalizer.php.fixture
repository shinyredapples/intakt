<?php

declare(strict_types=1);

namespace Intakt\Sample;

use Symfony\Component\Serializer\Normalizer\DenormalizerInterface;

final readonly class ReportDenormalizer implements DenormalizerInterface
{
    public function denormalize(mixed $data, string $type, ?string $format = null, array $context = [], string $locale = 'en'): mixed
    {
        return [$data, $locale];
    }

    public function supportsDenormalization(mixed $data, string $type, ?string $format = null, array $context = []): bool
    {
        return 'report' === $type;
    }

    public function getSupportedTypes(?string $format): array
    {
        return ['report' => true];
    }
}
