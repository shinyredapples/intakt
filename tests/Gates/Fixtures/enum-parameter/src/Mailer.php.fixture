<?php

declare(strict_types=1);

namespace Intakt\Sample;

enum Priority: string
{
    case Urgent = 'urgent';
    case Normal = 'normal';
}

final readonly class Mailer
{
    public function send(string $body, Priority $priority): string
    {
        return Priority::Urgent === $priority ? strtoupper($body) : $body;
    }
}
