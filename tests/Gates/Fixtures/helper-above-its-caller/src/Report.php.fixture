<?php

declare(strict_types=1);

namespace Intakt\Sample;

final readonly class Report
{
    public function title(string $name): string
    {
        return ucfirst($name);
    }

    private function framed(string $text): string
    {
        return '['.$text.']';
    }

    protected function render(string $name): string
    {
        return $this->framed($this->title($name));
    }
}
