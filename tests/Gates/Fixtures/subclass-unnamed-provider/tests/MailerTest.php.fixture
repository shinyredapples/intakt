<?php

declare(strict_types=1);

namespace Intakt\Tests\Sample;

use PHPUnit\Framework\Attributes\DataProvider;
use PHPUnit\Framework\TestCase;

abstract class MailerCases extends TestCase
{
    #[DataProvider('mailCases')]
    public function testEachCaseIsSentOnce(int $case): void
    {
    }
}

final class MailerTest extends MailerCases
{
    public static function mailCases(): iterable
    {
        yield 'one' => [1];
    }

    public static function testCases(): iterable
    {
        yield 'one' => [1];
    }
}
