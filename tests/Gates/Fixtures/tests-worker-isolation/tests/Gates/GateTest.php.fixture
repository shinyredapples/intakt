<?php

declare(strict_types=1);

use PHPUnit\Framework\Attributes\CoversNothing;
use PHPUnit\Framework\TestCase;

#[CoversNothing]
final class GateTest extends TestCase
{
    public function testHoldsItsNamesWhileTheSqliteWorkerHoldsTheSameNames(): void
    {
        holdTheNamesOfThisWorkerTogetherWith('gates', 'sqlite');

        self::assertFileExists(dirname(__DIR__, 2).'/rendezvous/sqlite');
    }
}
