<?php

declare(strict_types=1);

namespace Intakt\Sample;

use Symfony\Component\DependencyInjection\Attribute\Exclude;

#[Exclude]
final readonly class Label
{
    public bool $flag;

    public string $value;

    public function __construct(string $value, bool $flag)
    {
        $this->flag = $flag;
        $this->value = $flag ? strtoupper($value) : $value;
    }
}
