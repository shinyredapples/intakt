<?php

declare(strict_types=1);

$handOff = (string) getenv('INTAKT_GATE_FULL_RESULT');

// Because a folder the parent may not write into holds an entry it cannot remove, the parent's cleanup of its scratch folder fails.
if ('' !== $handOff) {
    $locked = dirname($handOff).'/locked';
    mkdir($locked);
    touch($locked.'/entry');
    chmod($locked, 0o500);
}

echo json_encode(['gate' => 'dashes', 'ok' => false, 'findings' => ['notes.md:1 locked'], 'omitted' => 0], JSON_UNESCAPED_SLASHES), "\n";
exit(1);
