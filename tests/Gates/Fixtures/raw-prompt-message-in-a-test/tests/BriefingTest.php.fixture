<?php

declare(strict_types=1);

namespace Intakt\Sample\Tests;

use Symfony\AI\Platform\Message\Message;
use Symfony\AI\Platform\Message\MessageBag;

final readonly class BriefingTest
{
    public function storedConversation(string $patch): MessageBag
    {
        return new MessageBag(Message::forSystem('You review.'), Message::ofUser($patch));
    }
}
