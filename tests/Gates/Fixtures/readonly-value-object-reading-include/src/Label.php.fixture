<?php

declare(strict_types=1);

namespace Intakt\Sample;

use Symfony\Component\DependencyInjection\Attribute\Exclude;

#[Exclude]
final readonly class Label
{
    public string $value;

    public function __construct(string $value, public bool $upper)
    {
        $this->value = (bool) (include __DIR__.'/upper.php') ? strtoupper($value) : $value;
    }
}
