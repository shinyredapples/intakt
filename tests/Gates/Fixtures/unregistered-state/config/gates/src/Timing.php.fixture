<?php

declare(strict_types=1);

namespace Intakt\Sample\Gates;

final class Timing
{
    private ?int $startedAt = null;

    public function start(int $moment): void
    {
        $this->startedAt = $moment;
    }

    public function elapsedUntil(int $moment): int
    {
        return $moment - ($this->startedAt ?? $moment);
    }
}
