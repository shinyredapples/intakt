<?php

declare(strict_types=1);

namespace Intakt\Sample;

final readonly class Tree
{
    private function unused(): string
    {
        return 'never called';
    }

    /**
     * @param array<mixed> $branches
     */
    public function depth(array $branches): int
    {
        return $this->walk($branches);
    }

    /**
     * @param array<mixed> $branches
     */
    private function walk(array $branches): int
    {
        $deepest = 0;

        foreach ($branches as $branch) {
            $deepest = max($deepest, is_array($branch) ? $this->walk($branch) : 0);
        }

        return $deepest + 1;
    }
}
