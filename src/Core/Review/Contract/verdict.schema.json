{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Intakt review verdict",
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "findings", "resolved", "follow_ups"],
  "properties": {
    "verdict": {"enum": ["approve", "changes", "blocked"]},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "resolved": {"type": "array", "items": {"type": "string"}},
    "follow_ups": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "severity", "file", "line", "symbol", "text", "fixable_by", "repeat", "requirement", "evidence"],
      "properties": {
        "id": {"type": "string"},
        "severity": {"enum": ["P1", "P2", "P3"]},
        "file": {"type": ["string", "null"]},
        "line": {"type": ["integer", "null"]},
        "symbol": {"type": ["string", "null"]},
        "text": {"type": "string"},
        "fixable_by": {"enum": ["builder", "owner"]},
        "repeat": {"type": "boolean"},
        "requirement": {"type": ["string", "null"]},
        "evidence": {"anyOf": [{"$ref": "#/$defs/evidence"}, {"type": "null"}]}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["probe", "output"],
      "properties": {
        "probe": {"type": "string"},
        "output": {"type": "string"}
      }
    }
  }
}
