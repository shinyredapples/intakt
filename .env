# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

# The port the owner publishes the dashboard on, on the host's loopback address; requests naming another port are refused.
DASHBOARD_PORT=7780

###> doctrine/doctrine-bundle ###
# SQLite is the default. MySQL, MariaDB and PostgreSQL work with their own URL in .env.local.
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
# The queue the reviewers of a round wait in; start workers with: php bin/console messenger:consume async
MESSENGER_TRANSPORT_DSN=doctrine://default
###< symfony/messenger ###

# Provider keys: set them in .env.local, the real environment or Symfony secrets (secrets:set), never here.
###> symfony/ai-anthropic-platform ###
ANTHROPIC_API_KEY=
###< symfony/ai-anthropic-platform ###

###> symfony/ai-generic-platform ###
# An OpenAI-compatible endpoint: both must be set, or the provider is disabled.
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
###< symfony/ai-generic-platform ###

###> symfony/ai-open-ai-platform ###
OPENAI_API_KEY=
###< symfony/ai-open-ai-platform ###

# Intakt's GitHub App: set them in .env.local, the real environment or Symfony secrets (secrets:set), never here.
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=

# The owner's MCP endpoint: reads need no token. A write needs MCP_OWNER_ACCESS=mcp_tool_write and the token in MCP_OWNER_TOKEN, set in .env.local, never here.
MCP_OWNER_ACCESS=mcp_tool_read
MCP_OWNER_TOKEN=
