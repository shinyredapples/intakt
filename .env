# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

# Where a reviewer reaches the per-review MCP server of this installation; plain http on localhost, because the reviewer runs in the same container.
REVIEW_MCP_BASE_URL=http://localhost:7780

# The compose service this installation runs as, set by compose.yaml, so the first start prints commands the host shell can run; empty outside the compose demo.
INTAKT_COMPOSE_SERVICE=

# A file every live dashboard update is appended to, one JSON line each, so intakt:demo:record can keep them; empty captures nothing.
INTAKT_LIVE_CAPTURE=

# The container engine for review jobs: docker (the Docker Engine at /var/run/docker.sock) or empty. Nothing reads it yet; the next part of #2017 makes reviews run in review jobs when it names an engine.
INTAKT_CONTAINER_ENGINE=

# The recording the /demo page plays into the demo project, a file written by intakt:demo:record; empty offers no demo run. The image names the shipped recording, /app/fixtures/demo/sample-change-review.json; .env.local can name another or empty it.
INTAKT_DEMO_RECORDING=

# The port the owner publishes the dashboard on, on the host's loopback address; requests naming another port are refused.
DASHBOARD_PORT=7780

# A FrankenPHP worker that holds more than this many megabytes after a request ends cleanly and is replaced, because PHP never gives all leaked memory back.
WORKER_MEMORY_CEILING_MB=256

###> doctrine/doctrine-bundle ###
# SQLite is the default. MySQL, MariaDB and PostgreSQL work with their own URL in .env.local.
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
# The queue the reviewers of a round wait in; start workers with: php bin/console messenger:consume async
MESSENGER_TRANSPORT_DSN=doctrine://default
###< symfony/messenger ###

# Provider keys: set them in .env.local, the real environment or Symfony secrets (secrets:set), never here.
###> symfony/ai-anthropic-platform ###
ANTHROPIC_API_KEY=
###< symfony/ai-anthropic-platform ###

###> symfony/ai-generic-platform ###
# An OpenAI-compatible endpoint: both must be set, or the provider is disabled.
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
###< symfony/ai-generic-platform ###

###> symfony/ai-open-ai-platform ###
OPENAI_API_KEY=
###< symfony/ai-open-ai-platform ###

# Intakt's GitHub App: set them in .env.local, the real environment or Symfony secrets (secrets:set), never here.
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=
# What the installation must hold exactly, checked at start: name:level pairs and owner/repo names, comma separated.
GITHUB_APP_PERMISSIONS=
GITHUB_APP_REPOSITORIES=
# The slug of the maintainer's own GitHub App, whose bot account may steer like Intakt's; empty means none.
GITHUB_MAINTAINER_APP_SLUG=
# The owner's GitHub login, the only account whose `approve <sha>` lets a held CI change push; empty means no approval counts.
GITHUB_OWNER_LOGIN=

# The lowest level the log writes: any PSR-3 level (debug, info, notice, warning, error, critical, alert, emergency); an unknown one stops the start, so a typo never hides records.
INTAKT_LOG_LEVEL=warning

# The owner's MCP endpoint: reads need no token. A write needs MCP_OWNER_ACCESS=mcp_tool_write and the token in MCP_OWNER_TOKEN, set in .env.local, never here.
MCP_OWNER_ACCESS=mcp_tool_read
MCP_OWNER_TOKEN=

# FrankenPHP's admin API (metrics, worker threads, hub health); plain http on localhost only, because it is never exposed.
FRANKENPHP_ADMIN_URL=http://localhost:2019

###> symfony/mercure-bundle ###
# The built-in hub of FrankenPHP (see the Caddyfile): the app publishes to MERCURE_URL, a browser subscribes at MERCURE_PUBLIC_URL.
MERCURE_URL=http://localhost:7781/.well-known/mercure
MERCURE_PUBLIC_URL=http://localhost:7781/.well-known/mercure
# The key of the hub's publisher and subscriber tokens, at least 32 characters; set it in .env.local, never here.
MERCURE_JWT_SECRET=
# The issuer the hub accepts in a token's iss claim.
MERCURE_JWT_ISSUER=http://localhost:7781
###< symfony/mercure-bundle ###
