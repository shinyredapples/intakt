includes:
    - ../../vendor/phpstan/phpstan-strict-rules/rules.neon
    - ../../vendor/phpstan/phpstan-deprecation-rules/rules.neon
    - ../../vendor/tomasvotruba/cognitive-complexity/config/extension.neon
    - phpstan-cache.php

parameters:
    level: max
    phpVersion: 80500
    excludePaths:
        - %currentWorkingDirectory%/upstream (?)
        - %currentWorkingDirectory%/var (?)
        - %currentWorkingDirectory%/vendor (?)
        - %currentWorkingDirectory%/tests/Gates/Fixtures (?)
    cognitive_complexity:
        class: 40
        function: 8

rules:
    - Intakt\Gates\PhpStan\ParameterLimitRule
    - Intakt\Gates\PhpStan\NoNestedTryRule
    - Intakt\Gates\PhpStan\ClockOnlyRule
    - Intakt\Gates\PhpStan\NoMockOptOutRule

services:
    -
        class: Intakt\Gates\PhpStan\FlagParameterRule
        arguments:
            root: %currentWorkingDirectory%
        tags:
            - phpstan.rules.rule
    -
        class: Intakt\Gates\PhpStan\StatefulServiceResetRule
        arguments:
            root: %currentWorkingDirectory%
        tags:
            - phpstan.rules.rule
