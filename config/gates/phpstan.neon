includes:
    - ../../vendor/phpstan/phpstan-strict-rules/rules.neon
    - ../../vendor/phpstan/phpstan-deprecation-rules/rules.neon
    - ../../vendor/tomasvotruba/cognitive-complexity/config/extension.neon
    - ../../vendor/phpstan/phpstan-symfony/extension.neon
    - ../../vendor/phpstan/phpstan-symfony/rules.neon
    - phpstan-cache.php
    - phpstan-symfony.php
    - ../../ratchet/provider-literals.neon

parameters:
    level: max
    phpVersion: 80500
    excludePaths:
        - %currentWorkingDirectory%/upstream (?)
        - %currentWorkingDirectory%/var (?)
        - %currentWorkingDirectory%/vendor (?)
        - %currentWorkingDirectory%/tests/Gates/Fixtures (?)
    cognitive_complexity:
        class: 40
        function: 8

rules:
    - Intakt\Gates\PhpStan\NoNestedTryRule
    - Intakt\Gates\PhpStan\ClockOnlyRule
    - Intakt\Gates\PhpStan\NoMockOptOutRule
    - Intakt\Gates\PhpStan\ImportFormRule
    - Intakt\Gates\PhpStan\ContainerUnknownHasIdRule
    - Intakt\Gates\PhpStan\ContainerUnknownParameterRule
    - Intakt\Gates\PhpStan\ContainerUnknownGetIdRule
    - Intakt\Gates\PhpStan\BareSerializerFormatRule
    - Intakt\Gates\PhpStan\HelperOrderRule

services:
    -
        class: Intakt\Gates\PhpStan\AskedServiceIds
    -
        class: Intakt\Gates\PhpStan\ContainerRegistration
        arguments:
            root: %currentWorkingDirectory%
    -
        class: Intakt\Gates\PhpStan\ParameterLimitRule
        arguments:
            root: %currentWorkingDirectory%
        tags:
            - phpstan.rules.rule
    -
        class: Intakt\Gates\PhpStan\FlagParameterRule
        arguments:
            root: %currentWorkingDirectory%
        tags:
            - phpstan.rules.rule
    -
        class: Intakt\Gates\PhpStan\StatefulServiceResetRule
        tags:
            - phpstan.rules.rule
    -
        class: Intakt\Gates\PhpStan\FileScopeDeprecation
        arguments:
            parser: @defaultAnalysisParser
    -
        class: Intakt\Gates\PhpStan\DeprecatedClasses
    -
        class: Intakt\Gates\PhpStan\NoDeprecatedReferenceRule
        tags:
            - phpstan.rules.rule
    -
        class: Intakt\Gates\PhpStan\DeprecatedDocblockTypes
    -
        class: Intakt\Gates\PhpStan\NoDeprecatedDocblockTypeRule
        tags:
            - phpstan.rules.rule
    -
        class: Intakt\Gates\PhpStan\NoDeprecatedClassDocblockTypeRule
        tags:
            - phpstan.rules.rule
    -
        class: Intakt\Gates\PhpStan\ReSpelledNameRule
        arguments:
            root: %currentWorkingDirectory%
            provider: Intakt\Core\Ai\Contract\Provider
        tags:
            - phpstan.rules.rule
    -
        class: Intakt\Gates\PhpStan\ProviderLiteralRule
        arguments:
            root: %currentWorkingDirectory%
            catalog: Intakt\Plugin\Vendor\Contract\ProviderDescriptor
        tags:
            - phpstan.rules.rule
    -
        class: Intakt\Gates\PhpStan\FinalClassRule
        arguments:
            root: %currentWorkingDirectory%
        tags:
            - phpstan.rules.rule
    -
        class: Intakt\Gates\PhpStan\NoStaticPropertyRule
        arguments:
            root: %currentWorkingDirectory%
        tags:
            - phpstan.rules.rule
    -
        class: Intakt\Gates\PhpStan\RawPromptMessageRule
        arguments:
            root: %currentWorkingDirectory%
        tags:
            - phpstan.rules.rule
    -
        class: Intakt\Gates\PhpStan\RawPromptMessageCallableRule
        arguments:
            root: %currentWorkingDirectory%
        tags:
            - phpstan.rules.rule
    -
        class: Intakt\Gates\PhpStan\NoPublicSetterRule
        arguments:
            root: %currentWorkingDirectory%
        tags:
            - phpstan.rules.rule
    -
        class: Intakt\Gates\PhpStan\NoMagicMethodRule
        arguments:
            root: %currentWorkingDirectory%
        tags:
            - phpstan.rules.rule
    -
        class: Intakt\Gates\PhpStan\NoPublicTraitSetterRule
        arguments:
            root: %currentWorkingDirectory%
        tags:
            - phpstan.rules.rule
    -
        class: Intakt\Gates\PhpStan\TraitSetterDeclarationCollector
        tags:
            - phpstan.collector
    -
        class: Intakt\Gates\PhpStan\TraitSetterUseCollector
        tags:
            - phpstan.collector
    -
        class: Intakt\Gates\PhpStan\AbstractTraitSetterUseCollector
        tags:
            - phpstan.collector
    -
        class: Intakt\Gates\PhpStan\RunTimeTraitConstructionCollector
        tags:
            - phpstan.collector
    -
        class: Intakt\Gates\PhpStan\UsedTraitCollector
        tags:
            - phpstan.collector
    -
        class: Intakt\Gates\PhpStan\UnusedTraitCarrierRule
        arguments:
            root: %currentWorkingDirectory%
        tags:
            - phpstan.rules.rule
    -
        class: Intakt\Gates\PhpStan\TestMethodSentenceRule
        arguments:
            root: %currentWorkingDirectory%
        tags:
            - phpstan.rules.rule
    -
        class: Intakt\Gates\PhpStan\TestMethodCollector
        tags:
            - phpstan.collector
    -
        class: Intakt\Gates\PhpStan\TestProviderCollector
        tags:
            - phpstan.collector
    -
        class: Intakt\Gates\PhpStan\TraitAliasCollector
        tags:
            - phpstan.collector
    -
        class: Intakt\Gates\PhpStan\TraitMethodLineCollector
        tags:
            - phpstan.collector
    -
        class: Intakt\Gates\PhpStan\NoServiceLocatorRule
        arguments:
            root: %currentWorkingDirectory%
        tags:
            - phpstan.rules.rule
    -
        class: Intakt\Gates\PhpStan\NoRequiredAttributeRule
        arguments:
            root: %currentWorkingDirectory%
        tags:
            - phpstan.rules.rule
    -
        class: Intakt\Gates\PhpStan\NarrowCatchRule
        arguments:
            root: %currentWorkingDirectory%
        tags:
            - phpstan.rules.rule
