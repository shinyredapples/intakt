{
  "name": "shinyredapples/intakt",
  "description": "Intakt: a loop runner for AI coding agents",
  "type": "project",
  "license": "MIT",
  "minimum-stability": "beta",
  "prefer-stable": true,
  "require": {
    "php": ">=8.5.12",
    "ext-ctype": "*",
    "ext-dom": "*",
    "ext-fileinfo": "*",
    "ext-filter": "*",
    "ext-iconv": "*",
    "ext-intl": "*",
    "ext-libxml": "*",
    "ext-mbstring": "*",
    "ext-openssl": "*",
    "ext-pcntl": "*",
    "ext-pdo": "*",
    "ext-pdo_sqlite": "*",
    "ext-phar": "*",
    "ext-posix": "*",
    "ext-simplexml": "*",
    "ext-sodium": "*",
    "ext-tokenizer": "*",
    "ext-xml": "*",
    "ext-xmlwriter": "*",
    "ext-zip": "*",
    "composer/semver": "^3.6",
    "doctrine/doctrine-bundle": "^3.4",
    "doctrine/doctrine-migrations-bundle": "^4.0",
    "doctrine/orm": "^3.8",
    "guzzlehttp/psr7": "^3.4",
    "mcp/sdk": "0.9.0",
    "symfony/ai-agent": "1.0.0-BETA1",
    "symfony/ai-anthropic-platform": "1.0.0-BETA1",
    "symfony/ai-bundle": "1.0.0-BETA1",
    "symfony/ai-claude-code-platform": "1.0.0-BETA1",
    "symfony/ai-codex-platform": "1.0.0-BETA1",
    "symfony/ai-doctrine-message-store": "1.0.0-BETA1",
    "symfony/ai-failover-platform": "1.0.0-BETA1",
    "symfony/ai-generic-platform": "1.0.0-BETA1",
    "symfony/ai-mcp-tool": "1.0.0-BETA1",
    "symfony/ai-open-ai-platform": "1.0.0-BETA1",
    "symfony/ai-open-responses-platform": "1.0.0-BETA1",
    "symfony/ai-platform": "1.0.0-BETA1",
    "symfony/ai-sqlite-store": "1.0.0-BETA1",
    "symfony/ai-store": "1.0.0-BETA1",
    "symfony/asset": "^8.2",
    "symfony/asset-mapper": "^8.2",
    "symfony/console": "^8.2",
    "symfony/doctrine-messenger": "^8.2",
    "symfony/dotenv": "^8.2",
    "symfony/flex": "^2.12",
    "symfony/framework-bundle": "^8.2",
    "symfony/http-client": "^8.2",
    "symfony/lock": "^8.2",
    "symfony/mcp-bundle": "1.0.0-BETA1",
    "symfony/mercure-bundle": "^0.7.0",
    "symfony/messenger": "^8.2",
    "symfony/process": "^8.2",
    "symfony/property-info": "^8.2",
    "symfony/rate-limiter": "^8.2",
    "symfony/runtime": "^8.2",
    "symfony/scheduler": "^8.2",
    "symfony/security-bundle": "^8.2",
    "symfony/semaphore": "^8.2",
    "symfony/serializer": "^8.2",
    "symfony/stimulus-bundle": "^3.7",
    "symfony/twig-bundle": "^8.2",
    "symfony/uid": "^8.2",
    "symfony/ux-turbo": "^3.7",
    "symfony/validator": "^8.2",
    "symfony/workflow": "^8.2",
    "symfony/yaml": "^8.2"
  },
  "require-dev": {
    "ext-sqlite3": "*",
    "friendsofphp/php-cs-fixer": "^3.95",
    "justinrainbow/json-schema": "^6.14",
    "nikic/php-parser": "^5.9",
    "phparkitect/phparkitect": "^1.3",
    "phpstan/phpstan": "^2.3",
    "phpstan/phpstan-deprecation-rules": "^2.0",
    "phpstan/phpstan-strict-rules": "^2.1",
    "phpstan/phpstan-symfony": "^2.1",
    "phpunit/phpunit": "^13.4",
    "rector/rector": "^2.8",
    "symfony/ai-mate": "1.0.0-BETA1",
    "symfony/ai-symfony-mate-extension": "1.0.0-BETA1",
    "symfony/browser-kit": "^8.2",
    "symfony/css-selector": "^8.2",
    "tomasvotruba/cognitive-complexity": "^1.3"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "php-http/discovery": false,
      "symfony/flex": true,
      "symfony/runtime": true
    },
    "optimize-autoloader": true,
    "platform": {
      "php": "8.5.12"
    },
    "policy": {
      "cooldown": {
        "period": "3 days",
        "block": true,
        "audit": "fail",
        "ignore": {
          "symfony/*": {
            "constraint": "8.2.0-BETA2",
            "reason": "Owner decision 2026-11-13: one-time exception for v8.2.0-BETA2 (released 2026-11-13 17:29 UTC), removed once that release is older than the cooldown"
          }
        }
      }
    }
  },
  "autoload": {
    "psr-4": {
      "Intakt\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "DoctrineMigrations\\": "migrations/",
      "Intakt\\Gates\\": "config/gates/src/",
      "Intakt\\Tests\\": "tests/"
    }
  },
  "extra": {
    "symfony": {
      "allow-contrib": false,
      "require": "^8.2"
    },
    "ai-mate": {
      "includes": [
        "mate/config.php"
      ]
    }
  },
  "scripts": {
    "auto-scripts": {
      "cache:clear": "symfony-cmd",
      "assets:install %PUBLIC_DIR%": "symfony-cmd"
    },
    "check": "bin/check"
  }
}
