{
  "name": "shinyredapples/intakt",
  "description": "Intakt: a loop runner for AI coding agents",
  "type": "project",
  "license": "MIT",
  "minimum-stability": "beta",
  "prefer-stable": true,
  "require": {
    "php": ">=8.5.12",
    "ext-ctype": "*",
    "ext-iconv": "*",
    "ext-openssl": "*",
    "ext-pdo_sqlite": "*",
    "doctrine/doctrine-bundle": "^3.3",
    "doctrine/doctrine-migrations-bundle": "^4.0",
    "doctrine/orm": "^3.7",
    "guzzlehttp/psr7": "^3.2",
    "mcp/sdk": "0.9.0",
    "symfony/ai-agent": "1.0.0-BETA1",
    "symfony/ai-anthropic-platform": "1.0.0-BETA1",
    "symfony/ai-bundle": "1.0.0-BETA1",
    "symfony/ai-claude-code-platform": "1.0.0-BETA1",
    "symfony/ai-codex-platform": "1.0.0-BETA1",
    "symfony/ai-doctrine-message-store": "1.0.0-BETA1",
    "symfony/ai-failover-platform": "1.0.0-BETA1",
    "symfony/ai-generic-platform": "1.0.0-BETA1",
    "symfony/ai-open-ai-platform": "1.0.0-BETA1",
    "symfony/ai-platform": "1.0.0-BETA1",
    "symfony/ai-sqlite-store": "1.0.0-BETA1",
    "symfony/ai-store": "1.0.0-BETA1",
    "symfony/console": "^8.1",
    "symfony/doctrine-messenger": "^8.1",
    "symfony/dotenv": "^8.1",
    "symfony/flex": "^2.11",
    "symfony/framework-bundle": "^8.1",
    "symfony/http-client": "^8.1",
    "symfony/lock": "^8.1",
    "symfony/mcp-bundle": "1.0.0-BETA1",
    "symfony/messenger": "^8.1",
    "symfony/process": "^8.1",
    "symfony/rate-limiter": "^8.1",
    "symfony/runtime": "^8.1",
    "symfony/security-bundle": "^8.1",
    "symfony/semaphore": "^8.1",
    "symfony/twig-bundle": "^8.1",
    "symfony/uid": "^8.1",
    "symfony/validator": "^8.1",
    "symfony/workflow": "^8.1",
    "symfony/yaml": "^8.1"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.95",
    "justinrainbow/json-schema": "^6.14",
    "nikic/php-parser": "^5.9",
    "phparkitect/phparkitect": "^1.3",
    "phpstan/phpstan": "^2.3",
    "phpstan/phpstan-deprecation-rules": "^2.0",
    "phpstan/phpstan-strict-rules": "^2.1",
    "phpunit/phpunit": "^13.4",
    "rector/rector": "^2.8",
    "symfony/ai-mate": "1.0.0-BETA1",
    "symfony/ai-symfony-mate-extension": "1.0.0-BETA1",
    "symfony/browser-kit": "^8.1",
    "symfony/css-selector": "^8.1",
    "tomasvotruba/cognitive-complexity": "^1.3"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "php-http/discovery": false,
      "symfony/flex": true,
      "symfony/runtime": true
    },
    "optimize-autoloader": true,
    "platform": {
      "php": "8.5.12"
    }
  },
  "autoload": {
    "psr-4": {
      "Intakt\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "DoctrineMigrations\\": "migrations/",
      "Intakt\\Gates\\": "config/gates/src/",
      "Intakt\\Tests\\": "tests/"
    }
  },
  "extra": {
    "symfony": {
      "allow-contrib": false,
      "require": "^8.1"
    },
    "ai-mate": {
      "includes": [
        "mate/config.php"
      ]
    }
  },
  "scripts": {
    "auto-scripts": {
      "cache:clear": "symfony-cmd",
      "assets:install %PUBLIC_DIR%": "symfony-cmd"
    },
    "check": "bin/check"
  }
}
